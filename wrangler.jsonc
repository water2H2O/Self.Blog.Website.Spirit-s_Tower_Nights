{
	// Cloudflare Workers + 静态资源（Pages 的替代流程）
	// 除 /teapot 之外不跑任何脚本逻辑，正常请求直接命中静态资源。
	// 编辑器校验用；wrangler 本身不读这一行
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",

	// 必须与 Cloudflare 控制台里创建的那个 Worker 同名，否则部署会跑到另一个 Worker 上
	"name": "self-blog-website-spirit-s-tower-nights",
	"compatibility_date": "2026-10-01",

	// 唯一的 Worker 脚本：只为 /teapot 返回真正的 418，其余全交给静态资源
	"main": "./worker/index.mjs",

	"assets": {
		// Astro 的构建输出目录
		"directory": "./dist",
		// 找不到的路径交给 dist/404.html（Astro 会生成）
		"not_found_handling": "404-page",
		// 脚本里用 env.ASSETS.fetch() 回落到静态资源，必须有这个 binding
		"binding": "ASSETS"
	},

	"observability": {
		"enabled": true
	}
}
