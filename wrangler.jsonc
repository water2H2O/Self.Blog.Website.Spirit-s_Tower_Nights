{
	// Cloudflare Workers + 静态资源（Pages 的替代流程）
	// 除 /teapot 之外不跑任何脚本逻辑，正常请求直接命中静态资源。
	// 编辑器校验用；wrangler 本身不读这一行
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",

	// 必须与 Cloudflare 控制台里创建的那个 Worker 同名，否则部署会跑到另一个 Worker 上
	"name": "self-blog-website-spirit-s-tower-nights",
	"compatibility_date": "2026-10-01",

	// 唯一的 Worker 脚本：只为 /teapot 返回真正的 418，其余全交给静态资源
	"main": "./worker/index.mjs",

	"assets": {
		// Astro 的构建输出目录
		"directory": "./dist",
		// 找不到的路径交给 dist/404.html（Astro 会生成）
		"not_found_handling": "404-page",
		// 脚本里用 env.ASSETS.fetch() 回落到静态资源，必须有这个 binding
		"binding": "ASSETS",
		// 浏览器导航不能被 404-page 提前接走；只有下面这些路径优先执行 Worker。
		// /api/aichat/* 是聊天后端：漏了这条，线上会直接当静态文件找不到 → 404。
		// "/" 与 /aichat/* 是给聊天子域用的：chat.water2h2o.com 的根路径要交给脚本，
		// 才能改写成 /aichat/；主站那条则由脚本 301 到子域（见 worker/index.mjs）。
		"run_worker_first": ["/teapot", "/teapot/", "/api/aichat/*", "/", "/aichat", "/aichat/"]
	},

	"observability": {
		"enabled": true
	},

	// 站点额度模式的云端快照（/api/aichat/sync）。
	// 建桶：npx wrangler r2 bucket create aichat-sync
	// 没配这个绑定时接口返回 503，其余功能不受影响。
	"r2_buckets": [
		{
			"binding": "SYNC",
			"bucket_name": "aichat-sync"
		}
	]
}
