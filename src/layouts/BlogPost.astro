---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import LicenseBadge from '../components/LicenseBadge.astro';
import { SITE_AUTHOR } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	sourceFilename: string;
	/** 未核实或由模型代笔的文章不声明个人作者。 */
	author?: string;
}

const { title, description, pubDate, updatedDate, heroImage, sourceFilename, author } = Astro.props;
const lastUpdated = updatedDate ?? pubDate;
const articleId = sourceFilename.replace(/\.mdx?$/i, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const publisher = {
	'@type': 'Person',
	'@id': new URL('/#person', Astro.site).href,
	name: SITE_AUTHOR,
	url: new URL('/about/', Astro.site).href,
};
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@id': `${canonicalURL.href}#blogposting`,
	headline: title,
	description,
	url: canonicalURL.href,
	mainEntityOfPage: canonicalURL.href,
	datePublished: pubDate.toISOString(),
	dateModified: lastUpdated.toISOString(),
	...(author ? { author: { ...publisher, name: author } } : {}),
	publisher,
	...(heroImage ? { image: new URL(heroImage.src, Astro.site).href } : {}),
	inLanguage: 'zh-CN',
};
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} ogType="article" structuredData={structuredData} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				margin: 0 0 1.8em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 0.85em;
				padding: 0.35em 0 0.65em;
				border-bottom: 1px solid rgb(var(--gray-light));
				text-align: left;
				line-height: 1.5;
			}
			.title h1 {
				margin: 0 0 0.3em;
			}
			.title .date {
				margin: 0;
				font-size: 1em;
				line-height: 1.4;
				font-weight: 600;
				color: var(--accent);
			}
			.title .article-id {
				margin: 0.2em 0 0;
				font-family: var(--font-mono, monospace);
				font-size: 0.75em;
				line-height: 1.5;
				color: rgb(var(--gray));
				overflow-wrap: anywhere;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<h2 class="date">最后更新于 <FormattedDate date={lastUpdated} /></h2>
						<p class="article-id">文章id: {articleId}</p>
					</div>
					{/* 配图放在日期与标题**下面**，先见标题再见图 */}
					{heroImage && (
						<div class="hero-image">
							<Image width={720} src={heroImage} alt="" />
						</div>
					)}
					<slot />
					{/* 随笔都是我自己写的，按 CC BY 4.0 授权；文中的委托插图另有版权 */}
					<LicenseBadge
						kind="cc-by"
						note="文中的委托插图版权归原画师所有，不适用 CC BY 4.0。"
					/>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
