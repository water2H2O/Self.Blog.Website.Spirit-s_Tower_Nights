---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import LicenseBadge from '../components/LicenseBadge.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	sourceFilename: string;
}

const { title, description, pubDate, updatedDate, heroImage, sourceFilename } = Astro.props;
const lastUpdated = updatedDate ?? pubDate;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				margin: 0 0 1.8em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: left;
				line-height: 1.5;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin: 0;
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.source-filename {
				margin: 0.35em 0 0;
				font-family: var(--font-mono, monospace);
				font-size: 0.72em;
				line-height: 1.6;
				color: rgb(var(--gray));
				overflow-wrap: anywhere;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<p class="date">最后更新于 <FormattedDate date={lastUpdated} /></p>
						<p class="source-filename">{sourceFilename}</p>
						<hr />
					</div>
					{/* 配图放在日期与标题**下面**，先见标题再见图 */}
					{heroImage && (
						<div class="hero-image">
							<Image width={720} src={heroImage} alt="" />
						</div>
					)}
					<slot />
					{/* 随笔都是我自己写的，按 CC BY 4.0 授权；文中的委托插图另有版权 */}
					<LicenseBadge
						kind="cc-by"
						note="文中的委托插图版权归原画师所有，不适用 CC BY 4.0。"
					/>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
