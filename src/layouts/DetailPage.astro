---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LicenseBadge from '../components/LicenseBadge.astro';
import SpoilerNote from '../components/SpoilerNote.astro';
import TagList from '../components/TagList.astro';

interface MetaItem {
	label: string;
	value: string;
	/** 填了就渲染成外链（例如联动角色的设主主页） */
	href?: string;
}

interface Props {
	title: string;
	subtitle?: string;
	summary: string;
	themeColor: string;
	cover?: ImageMetadata;
	tags?: string[];
	/** 信息栏：角色页放年龄/所属，设定页放分类/别名等 */
	meta?: MetaItem[];
	spoiler?: 'none' | 'mild' | 'heavy';
	/** 正典档位，locked 会在标题下显示“不可变更”徽章 */
	canon?: 'locked' | 'open' | 'draft';
	/**
	 * 本页文字的授权标记：
	 *   cc-by    我原创且有权授权 → 标 CC BY 4.0
	 *   reserved 别人的作品（联动角色的档案、企划稿件）→ 保留所有权利
	 *   none     不显示（默认）
	 */
	license?: 'cc-by' | 'reserved' | 'none';
	/** 追加在标记后面的一句说明，例如「本页角色版权归设主所有」 */
	licenseNote?: string;
	backHref: string;
	backLabel: string;
}

const {
	title,
	subtitle,
	summary,
	themeColor,
	cover,
	tags = [],
	meta = [],
	spoiler = 'none',
	canon,
	license = 'none',
	licenseNote,
	backHref,
	backLabel,
} = Astro.props;

const CANON = {
	locked: { label: '正典 · 不可变更', hint: '已确定的核心设定，后续故事以此为准' },
	open: { label: '可扩展', hint: '基本设定已确定，细节仍可补充' },
	draft: { label: '草稿', hint: '仍在整理中，内容可能调整' },
} as const;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={summary} image={cover} />
		<style>
			main {
				width: 860px;
			}
			.back {
				font-size: 0.82em;
				text-decoration: none;
				color: rgb(var(--gray));
			}
			.back:hover {
				color: var(--entry-color);
			}
			.hero {
				margin: 1em 0 1.6em;
				padding-bottom: 1.2em;
				border-bottom: 2px solid color-mix(in srgb, var(--entry-color) 40%, transparent);
			}
			.hero h1 {
				margin: 0;
			}
			.subtitle {
				margin: 0.2em 0 0;
				color: var(--entry-color);
				letter-spacing: 0.06em;
			}
			.canon {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				margin: 0.8em 0 0;
				padding: 0.32em 0.75em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.04em;
			}
			.canon[data-level='locked'] {
				color: #b6ffd8;
				background: rgba(120, 255, 190, 12%);
				border: 1px solid rgba(120, 255, 190, 35%);
			}
			.canon[data-level='open'] {
				color: rgb(var(--gray));
				background: rgba(255, 255, 255, 4%);
				border: 1px solid rgb(var(--gray-light));
			}
			.canon[data-level='draft'] {
				color: #ffd68a;
				background: rgba(255, 200, 90, 10%);
				border: 1px solid rgba(255, 200, 90, 30%);
			}
			.cover {
				margin: 1.2em 0 0;
			}
			.cover :global(img) {
				display: block;
				width: 100%;
				border-radius: 14px;
				box-shadow: var(--box-shadow);
			}
			/*
			 * 还没有立绘时的占位框：虚线框 + 一行 #NO INFO。
			 * 为什么不做成「干脆不显示」——留白会让人以为是页面坏了；
			 * 明写「暂无」既诚实，也方便以后补图时一眼找到位置。
			 */
			.cover.none {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.5em;
				aspect-ratio: 16 / 10;
				border-radius: 14px;
				border: 1px dashed rgba(127, 233, 240, 26%);
				background: rgba(127, 233, 240, 4%);
				color: rgb(var(--gray));
			}
			.cover.none .none-mark {
				font-family: Consolas, monospace;
				font-size: 1.1em;
				letter-spacing: 0.18em;
				color: var(--accent);
				opacity: 0.9;
			}
			.cover.none .none-text {
				font-size: 0.82em;
			}
			/* 信息栏：表格样式来自 global.css 的 .facts-table，这里只补间距与描边色 */
			.meta {
				margin: 0 0 2em;
				font-size: 0.88em;
				background: color-mix(in srgb, var(--entry-color) 8%, var(--surface));
				border-color: color-mix(in srgb, var(--entry-color) 25%, transparent);
			}
			.meta th,
			.meta td {
				border-color: color-mix(in srgb, var(--entry-color) 18%, transparent);
			}
			.meta th {
				color: rgb(var(--gray));
				background: color-mix(in srgb, var(--entry-color) 6%, transparent);
			}
			.prose {
				color: rgb(var(--gray-dark));
			}
			.prose :global(h2) {
				margin-top: 2em;
				padding-bottom: 0.2em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.prose :global(h3) {
				margin-top: 1.6em;
			}
			.prose :global(blockquote) {
				border-left-color: var(--entry-color);
			}
			.prose :global(strong) {
				color: var(--glow);
			}
			/* 页面正文里用 <div class="related"> 输出的关联区块 */
			.prose :global(.related) {
				margin-top: 3em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.prose :global(.related h2) {
				margin: 0 0 0.6em;
				font-size: 1.05em;
				border: none;
				color: rgb(var(--gray));
				letter-spacing: 0.08em;
			}
			.prose :global(.related ul) {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				list-style: none;
				margin: 0 0 1.6em;
				padding: 0;
			}
			.prose :global(.related a) {
				display: inline-block;
				padding: 0.4em 0.85em;
				border-radius: 999px;
				font-size: 0.85em;
				text-decoration: none;
				color: var(--entry-color);
				background: color-mix(in srgb, var(--entry-color) 10%, var(--surface));
				border: 1px solid color-mix(in srgb, var(--entry-color) 30%, transparent);
			}
			.prose :global(.related a:hover) {
				background: color-mix(in srgb, var(--entry-color) 20%, var(--surface));
			}
			@media (max-width: 720px) {
				.meta {
					font-size: 0.84em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main style={`--entry-color:${themeColor}`}>
			<a class="back" href={backHref}>← {backLabel}</a>
			<header class="hero">
				<h1>{title}</h1>
				{subtitle && <p class="subtitle">{subtitle}</p>}
				{canon && <p class="canon" data-level={canon} title={CANON[canon].hint}>{CANON[canon].label}</p>}
				<SpoilerNote level={spoiler} />
				<TagList tags={tags} color={themeColor} />
				{
					cover ? (
						<div class="cover">
							<Image src={cover} alt={title} width={1020} />
						</div>
					) : (
						/* 还没有图：占位框，明说「暂无」而不是留一片空白 */
						<div class="cover none" data-no-info>
							<span class="none-mark">暂无配图</span>
							<span class="none-text">可以先看看下面的文字。</span>
						</div>
					)
				}
			</header>
			{
				meta.length > 0 && (
					<table class="facts-table meta">
						<tbody>
							{meta.map((item) => (
								<tr>
									<th scope="row">{item.label}</th>
									<td>
										{item.href ? (
											<a href={item.href} target="_blank" rel="noreferrer">
												{item.value}
											</a>
										) : (
											item.value
										)}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				)
			}
			<div class="prose">
				<slot />
			</div>

			{/* 本页文字的授权标记；调用方不传就不显示 */}
			{license !== 'none' && <LicenseBadge kind={license} note={licenseNote} />}
		</main>
		<Footer />
	</body>
</html>
