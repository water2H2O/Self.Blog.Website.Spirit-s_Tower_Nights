---
import Layout from '../../layouts/BlogPost.astro';
import { FRIENDS } from '../../data/friends';

/**
 * 友情链接（完整页）。
 *
 * 名单在 src/data/friends.ts —— 关于页里内嵌的那一块用的是同一份，
 * 加人只改那一处。
 * 链接文字用完整网址，说明只写归属（不写「某某的设主」这类）。
 */
const friends = FRIENDS;
---

<Layout
	title="友情链接"
	description="朋友们的站点，以及我在参与的项目。"
	pubDate={new Date('2026-10-10')}
>
	<p class="back"><a href="/about/">← 关于</a></p>

	<h2>友情链接</h2>
	<p>朋友们的站点，以及我在参与的项目：</p>
	<ul class="friends">
		{
			friends.map((item) => (
				<li>
					<a href={item.href} target="_blank" rel="noreferrer">
						{item.href}
					</a>
					—— {item.who}
					{item.note && <span class="note">（{item.note}）</span>}
				</li>
			))
		}
	</ul>
	<!-- 维护备注：还有几位朋友没有主页，拿到链接后往上面的数组里加。 -->

	<p class="note">
		这些设主与伙伴们的 OC 都寄放在本站，可以在<a href="/draw/">卡池</a>里随机抽一位，
		或者去<a href="/draw/pool/">签筒</a>按设主名看全部。
	</p>

	<style>
		.back {
			margin: 0 0 1.6em;
			font-size: 0.82em;
		}
		.back a {
			color: rgb(var(--gray));
			text-decoration: none;
		}
		.back a:hover {
			color: var(--glow);
		}
		.friends {
			padding-left: 1.2em;
		}
		.friends li {
			margin-bottom: 0.6em;
			line-height: 1.8;
			word-break: break-all;
		}
		.friends .note {
			color: rgb(var(--gray));
			font-size: 0.9em;
		}
		.note {
			margin-top: 2em;
			padding-top: 1.4em;
			border-top: 1px solid rgb(var(--gray-light));
			font-size: 0.86em;
			line-height: 1.9;
			color: rgb(var(--gray));
		}
		.note a {
			color: var(--accent);
		}
	</style>
</Layout>
