---
import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_AUTHOR } from '../../consts';

/**
 * 卡池：朋友与伙伴家的 OC。
 *
 * 抽卡在浏览器里做（点一下随机换一位），所以这里把六位的数据整理成一个数组，
 * 连立绘地址一起交给脚本；初始那张由构建时定，没 JS 也能看到东西。
 */

const linked = (await getCollection('characters', ({ data }) => !data.draft && data.ownership === '联动'))
	.sort((a, b) => a.data.order - b.data.order);

/** 种族名：race 是引用，取回来才知道叫什么 */
const pool = await Promise.all(
	linked.map(async (entry) => {
		const race = entry.data.race ? await getEntry(entry.data.race) : null;
		return {
			id: entry.id,
			name: entry.data.name,
			title: entry.data.title ?? '',
			race: race?.data.name ?? '',
			owner: entry.data.owner ?? '',
			ownerUrl: entry.data.ownerUrl ?? '',
			summary: entry.data.summary,
			color: entry.data.themeColor,
			href: `/worldview/characters/${entry.id}/`,
			art: entry.data.portrait?.src ?? '',
		};
	}),
);

const first = pool[0];
const others = pool.slice(1).map((item) => item.name).join('、');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="卡池 · 朋友们的 OC"
			description={`朋友们与伙伴们的 OC 卡池，共 ${pool.length} 位。抽一张看看今天遇到谁。`}
		/>
		<style>
			main {
				width: 760px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.stage {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1.4em;
				margin: 2.4em 0 0;
			}
			/* 卡面 */
			.card {
				position: relative;
				width: 320px;
				max-width: 100%;
				border-radius: 18px;
				overflow: hidden;
				background: var(--surface);
				border: 1px solid color-mix(in srgb, var(--card-color, var(--accent)) 40%, transparent);
				box-shadow:
					0 0 0 1px rgba(0, 0, 0, 25%),
					0 18px 40px rgba(0, 0, 0, 45%);
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease;
			}
			.card.rolling {
				transform: scale(0.97);
			}
			.card.hit {
				animation: pop 0.45s ease;
			}
			@keyframes pop {
				0% {
					transform: scale(1.06);
					box-shadow: 0 0 0 6px color-mix(in srgb, var(--card-color, var(--accent)) 35%, transparent);
				}
				100% {
					transform: scale(1);
				}
			}
			.art {
				aspect-ratio: 4 / 5;
				overflow: hidden;
				background: color-mix(in srgb, var(--card-color, var(--accent)) 10%, var(--surface));
			}
			.art img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 18%;
				display: block;
			}
			.info {
				padding: 1em 1.2em 1.2em;
			}
			.info h2 {
				margin: 0;
				font-size: 1.35em;
				color: var(--card-color, var(--glow));
			}
			.meta {
				margin: 0.35em 0 0;
				font-size: 0.8em;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
			}
			.summary {
				margin: 0.7em 0 0;
				font-size: 0.86em;
				line-height: 1.8;
				color: rgb(var(--gray-dark));
			}
			.owner {
				margin: 0.9em 0 0;
				padding-top: 0.8em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.84em;
				color: #ffd68a;
			}
			.owner a {
				color: #ffd68a;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.8em;
			}
			button {
				padding: 0.75em 2em;
				border-radius: 999px;
				font-family: inherit;
				font-size: 1em;
				cursor: pointer;
				color: #06121a;
				background: var(--glow);
				border: 1px solid var(--glow);
				transition: 0.18s ease;
			}
			button:hover {
				box-shadow: var(--glow-shadow);
				transform: translateY(-2px);
			}
			button:disabled {
				opacity: 0.6;
				cursor: default;
				transform: none;
			}
			.link {
				align-self: center;
				padding: 0.75em 1.6em;
				border-radius: 999px;
				font-size: 0.92em;
				text-decoration: none;
				color: var(--accent);
				border: 1px solid rgba(175, 255, 255, 24%);
			}
			.link:hover {
				color: var(--glow);
				border-color: rgba(175, 255, 255, 55%);
			}
			.pool-note {
				margin: 2.4em 0 0;
				padding-top: 1.4em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.84em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.card {
					width: 100%;
				}
				.actions {
					flex-direction: column;
					width: 100%;
				}
				button,
				.link {
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>卡池</h1>
			<p class="lead">
				这里是朋友与伙伴们寄放在这座塔里的孩子，共 {pool.length} 位。抽一张，看看今天遇到谁。
			</p>

			<div class="stage">
				<article class="card" id="card" style={`--card-color:${first.color}`}>
					<div class="art">
						<img id="art" src={first.art} alt="" width="320" height="400" />
					</div>
					<div class="info">
						<h2 id="name">{first.name}</h2>
						<p class="meta" id="meta">
							{[first.race, first.title].filter(Boolean).join(' · ')}
						</p>
						<p class="summary" id="summary">{first.summary}</p>
						<p class="owner" id="owner">
							设主：
							{first.ownerUrl ? (
								<a href={first.ownerUrl} target="_blank" rel="noreferrer">
									{first.owner}
								</a>
							) : (
								first.owner
							)}
						</p>
					</div>
				</article>

				<div class="actions">
					<button type="button" id="draw">抽一张</button>
					<a class="link" id="profile" href={first.href}>看 TA 的档案 →</a>
					<a class="link" href="/cards/pool/">卡池一览 →</a>
				</div>
			</div>

			<p class="pool-note">
				除你抽到的这位，池子里还有 {others}。想看全部设主，去<a href="/cards/pool/">卡池一览</a>。
				这些角色都是朋友们的创作，版权归各设主所有。
			</p>
		</main>
		<Footer />

		<script
			type="application/json"
			id="pool-data"
			set:html={JSON.stringify(pool)}
		/>

		<script>
			const data = JSON.parse(document.getElementById('pool-data')!.textContent!);
			const card = document.getElementById('card')!;
			const art = document.getElementById('art') as HTMLImageElement;
			const name = document.getElementById('name')!;
			const meta = document.getElementById('meta')!;
			const summary = document.getElementById('summary')!;
			const owner = document.getElementById('owner')!;
			const profile = document.getElementById('profile') as HTMLAnchorElement;
			const draw = document.getElementById('draw') as HTMLButtonElement;

			let current = 0;
			let rolling = false;

			/** 把某一位填进卡面 */
			const show = (index: number) => {
				const item = data[index];
				current = index;
				card.style.setProperty('--card-color', item.color);
				if (art.getAttribute('src') !== item.art) art.src = item.art;
				name.textContent = item.name;
				meta.textContent = [item.race, item.title].filter(Boolean).join(' · ');
				summary.textContent = item.summary;
				owner.innerHTML = '';
				owner.append('设主：');
				if (item.ownerUrl) {
					const link = document.createElement('a');
					link.href = item.ownerUrl;
					link.target = '_blank';
					link.rel = 'noreferrer';
					link.textContent = item.owner;
					owner.append(link);
				} else {
					owner.append(item.owner);
				}
				profile.href = item.href;
			};

			draw.addEventListener('click', () => {
				if (rolling) return;
				rolling = true;
				draw.disabled = true;
				card.classList.add('rolling');

				// 先快速翻几张，再定下来 —— 大概 0.7 秒
				const started = Date.now();
				const timer = window.setInterval(() => {
					show(Math.floor(Math.random() * data.length));
				}, 70);

				window.setTimeout(
					() => {
						window.clearInterval(timer);
						let next = current;
						while (next === current && data.length > 1) next = Math.floor(Math.random() * data.length);
						show(next);
						card.classList.remove('rolling');
						card.classList.remove('hit');
						void card.offsetWidth; // 重启动画
						card.classList.add('hit');
						rolling = false;
						draw.disabled = false;
					},
					700 - (Date.now() - started),
				);
			});
		</script>
	</body>
</html>
