---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const items = (await getCollection('gallery', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'),
);
const characters = await getCollection('characters', ({ data }) => !data.draft);

const kindOrder = ['立绘', '插画', '曲绘', '头像', '设计稿', '表情包', '周边'];
const kinds = kindOrder.filter((kind) => items.some((item) => item.data.kind === kind));

/** 只列出真正有作品的角色 */
const owners = characters
	.filter((character) => items.some((item) => item.data.characters.some((ref) => ref.id === character.id)))
	.sort((a, b) => a.data.order - b.data.order);

const characterName = new Map(characters.map((c) => [c.id, c.data.name]));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="画廊" description="水塔夜谈的画作：立绘、插画、曲绘与周边。" />
		<style>
			main {
				width: 1100px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				align-items: center;
				margin: 1.6em 0 0;
			}
			.filters .label {
				font-size: 0.78em;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
				margin-right: 0.3em;
			}
			.filters button {
				font: inherit;
				font-size: 0.82em;
				padding: 0.35em 0.85em;
				border-radius: 999px;
				cursor: pointer;
				color: rgb(var(--gray-dark));
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				transition: 0.15s ease;
			}
			.filters button:hover {
				border-color: rgba(175, 255, 255, 45%);
				color: var(--glow);
			}
			.filters button[aria-pressed='true'] {
				color: #08131d;
				background: var(--glow);
				border-color: var(--glow);
				font-weight: 700;
			}
			.row {
				margin-top: 0.7em;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: 1.2rem;
				margin-top: 2em;
			}
			figure {
				margin: 0;
				border-radius: 14px;
				overflow: hidden;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				cursor: zoom-in;
				transition: 0.2s ease;
			}
			figure:hover {
				transform: translateY(-3px);
				box-shadow: var(--glow-shadow);
				border-color: color-mix(in srgb, var(--card-color) 45%, transparent);
			}
			figure[hidden] {
				display: none;
			}
			.frame {
				aspect-ratio: 4 / 3;
				display: grid;
				place-items: center;
				overflow: hidden;
				background: color-mix(in srgb, var(--card-color) 8%, var(--surface));
			}
			.frame :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
			}
			figcaption {
				padding: 0.7em 0.9em 0.85em;
				font-size: 0.85em;
			}
			figcaption .title {
				color: rgb(var(--black));
			}
			figcaption .sub {
				display: block;
				margin-top: 0.2em;
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.empty {
				color: rgb(var(--gray));
			}
			/* 灯箱 */
			#lightbox {
				position: fixed;
				inset: 0;
				z-index: 50;
				display: none;
				place-items: center;
				padding: 2em;
				background: rgba(4, 10, 16, 92%);
				backdrop-filter: blur(6px);
				cursor: zoom-out;
			}
			#lightbox.open {
				display: grid;
			}
			#lightbox img {
				max-width: 100%;
				max-height: 88vh;
				width: auto;
				border-radius: 12px;
				box-shadow: 0 20px 60px rgba(0, 0, 0, 70%);
			}
			#lightbox .cap {
				position: fixed;
				bottom: 1.4em;
				left: 0;
				right: 0;
				text-align: center;
				font-size: 0.85em;
				color: var(--glow);
			}
			.count {
				margin-top: 2.5em;
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>画廊</h1>
			<p class="lead">
				{items.length} 张。所有图片都已压缩为 WebP（原图合计约 68 MB，站内约 1.7 MB），点开看大图。
			</p>

			<div class="filters row" data-group="kind">
				<span class="label">类型</span>
				<button type="button" data-filter="all" aria-pressed="true">全部</button>
				{kinds.map((kind) => <button type="button" data-filter={kind} aria-pressed="false">{kind}</button>)}
			</div>
			{
				owners.length > 0 && (
					<div class="filters row" data-group="owner">
						<span class="label">角色</span>
						<button type="button" data-filter="all" aria-pressed="true">全部</button>
						{owners.map((owner) => (
							<button type="button" data-filter={owner.id} aria-pressed="false">
								{owner.data.name}
							</button>
						))}
					</div>
				)
			}

			<div class="grid" id="grid">
				{
					items.map((item) => (
						<figure
							style={`--card-color:${item.data.themeColor}`}
							data-kind={item.data.kind}
							data-chars={item.data.characters.map((ref) => ref.id).join(' ')}
							data-src={item.data.image.src}
							data-title={`${item.data.title}${item.data.artist ? ` · ${item.data.artist}` : ''}`}
						>
							<div class="frame">
								<Image src={item.data.image} alt={item.data.title} widths={[320, 480, 720]} sizes="(max-width: 720px) 90vw, 260px" />
							</div>
							<figcaption>
								<span class="title">{item.data.title}</span>
								<span class="sub">
									{item.data.kind}
									{item.data.characters.length > 0 &&
										` · ${item.data.characters.map((ref) => characterName.get(ref.id) ?? ref.id).join('、')}`}
								</span>
							</figcaption>
						</figure>
					))
				}
			</div>
			<p class="count">点任意一张放大；按 Esc 或点击空白处关闭。</p>
		</main>

		<div id="lightbox" role="dialog" aria-modal="true" aria-label="图片放大">
			<img src="" alt="" />
			<p class="cap"></p>
		</div>

		<script>
			// 双维度筛选：类型 与 角色 同时生效
			const state: Record<string, string> = { kind: 'all', owner: 'all' };
			const figures = Array.from(document.querySelectorAll<HTMLElement>('#grid figure'));

			function apply() {
				for (const figure of figures) {
					const okKind = state.kind === 'all' || figure.dataset.kind === state.kind;
					const chars = (figure.dataset.chars ?? '').split(' ').filter(Boolean);
					const okOwner = state.owner === 'all' || chars.includes(state.owner);
					figure.hidden = !(okKind && okOwner);
				}
			}

			for (const group of document.querySelectorAll<HTMLElement>('.filters')) {
				const name = group.dataset.group!;
				group.addEventListener('click', (event) => {
					const button = (event.target as HTMLElement).closest('button');
					if (!button) return;
					state[name] = button.dataset.filter ?? 'all';
					for (const sibling of group.querySelectorAll('button')) {
						sibling.setAttribute('aria-pressed', String(sibling === button));
					}
					apply();
				});
			}

			// 灯箱
			const box = document.getElementById('lightbox')!;
			const boxImg = box.querySelector('img')!;
			const boxCap = box.querySelector('.cap')!;

			for (const figure of figures) {
				figure.addEventListener('click', () => {
					boxImg.src = figure.dataset.src ?? '';
					boxImg.alt = figure.dataset.title ?? '';
					boxCap.textContent = figure.dataset.title ?? '';
					box.classList.add('open');
				});
			}

			const close = () => {
				box.classList.remove('open');
				boxImg.src = '';
			};
			box.addEventListener('click', close);
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') close();
			});
		</script>
		<Footer />
	</body>
</html>
