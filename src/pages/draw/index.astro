---
import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_AUTHOR } from '../../consts';

/**
 * 抽签：上面是抽到的 OC，下面是签纸。
 *
 * 流程刻意做成一次小仪式：合上（翻回卡背）→ 卡背摇晃 → 翻开 → 签纸落下，
 * 约 1.5 秒。比直接换一张图更像「摇签」，也给了点期待。
 *
 * 概率表放在这里（前端按权重摇），坏签刻意压得很低：
 * 大吉 8% / 吉 17% / 中吉 25% / 小吉 30% / 末吉 16% / 凶 4%。
 * 「末吉」不算坏签，只是慢一点；真正的坏签只有「凶」这一档。
 */

const drawn = (await getCollection('characters', ({ data }) => !data.draft && data.drawable)).sort(
	(a, b) => a.data.order - b.data.order,
);

const pool = await Promise.all(
	drawn.map(async (entry) => {
		const race = entry.data.race ? await getEntry(entry.data.race) : null;
		return {
			id: entry.id,
			name: entry.data.name,
			title: entry.data.title ?? '',
			race: race?.data.name ?? '',
			owner: entry.data.owner || SITE_AUTHOR,
			ownerUrl: entry.data.ownerUrl ?? '',
			summary: entry.data.summary,
			color: entry.data.themeColor,
			href: `/worldview/characters/${entry.id}/`,
			art: entry.data.portrait?.src ?? '',
		};
	}),
);

const fortunes = [
	{
		key: 'great',
		label: '大吉',
		weight: 8,
		text: '塔顶的灯亮了一整夜。今天做什么都顺，适合动手熬那锅一直不敢试的药剂。',
	},
	{
		key: 'good',
		label: '吉',
		weight: 17,
		text: '风向很好。出门会遇到想见的人，或者想见的人会来敲你的门。',
	},
	{
		key: 'middle',
		label: '中吉',
		weight: 25,
		text: '不好不坏 —— 但塔里的灯是亮的，炉子上的水也刚好开。',
	},
	{
		key: 'small',
		label: '小吉',
		weight: 30,
		text: '小事顺利，大事明天再说。今天适合整理药材柜。',
	},
	{
		key: 'late',
		label: '末吉',
		weight: 16,
		text: '慢一点也没关系，药剂本来就要熬三个小时。',
	},
	{
		key: 'bad',
		label: '凶',
		weight: 4,
		text: '药剂糊了。别灰心，明天再熬一锅就是。',
	},
];

const first = pool[0];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="抽签"
			description={`摇一支签，遇见一位角色，再看看今天的运势。签筒里现有 ${pool.length} 位。`}
		/>
		<style>
			main {
				width: 760px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.lead a {
				color: var(--accent);
			}
			.stage {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1.5em;
				margin-top: 2.2em;
			}

			/* ---------- 卡牌：正面是卡背，反面是抽到的角色 ---------- */
			.card3d {
				width: 340px;
				max-width: 100%;
				perspective: 1400px;
			}
			.card-inner {
				position: relative;
				transform-style: preserve-3d;
				transition: transform 0.62s cubic-bezier(0.32, 0.72, 0.28, 1);
			}
			.card3d.open .card-inner {
				transform: rotateY(180deg);
			}
			.card3d.shaking .card-inner {
				animation: shake 0.5s ease-in-out;
			}
			@keyframes shake {
				0%,
				100% {
					transform: rotate(0);
				}
				15% {
					transform: rotate(-2.5deg) translateY(-3px);
				}
				35% {
					transform: rotate(2deg) translateY(2px);
				}
				55% {
					transform: rotate(-1.6deg) translateY(-2px);
				}
				78% {
					transform: rotate(1.2deg);
				}
			}
			.face {
				backface-visibility: hidden;
				-webkit-backface-visibility: hidden;
				border-radius: 18px;
				overflow: hidden;
				box-shadow:
					0 0 0 1px rgba(0, 0, 0, 25%),
					0 18px 40px rgba(0, 0, 0, 45%);
			}
			/* 卡背 */
			.cover {
				position: relative;
				aspect-ratio: 4 / 5;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.9em;
				background:
					radial-gradient(120% 80% at 50% 12%, rgba(175, 255, 255, 13%), transparent 62%),
					linear-gradient(160deg, #16283a, #0d1a26);
				border: 1px solid rgba(175, 255, 255, 26%);
			}
			.cover-mark {
				font-size: 5.2em;
				font-weight: 700;
				line-height: 1;
				color: var(--glow);
				text-shadow: 0 0 26px rgba(175, 255, 255, 45%);
			}
			.cover-hint {
				margin: 0;
				font-size: 0.82em;
				letter-spacing: 0.14em;
				color: rgb(var(--gray));
			}
			.cover-ring {
				position: absolute;
				inset: 12px;
				border-radius: 12px;
				border: 1px solid rgba(175, 255, 255, 14%);
				pointer-events: none;
			}
			/* 抽到的角色 */
			.reveal {
				position: absolute;
				inset: 0;
				transform: rotateY(180deg);
				background: var(--surface);
				border: 1px solid color-mix(in srgb, var(--card-color, var(--accent)) 45%, transparent);
			}
			.reveal .art {
				aspect-ratio: 4 / 5;
				overflow: hidden;
				background: color-mix(in srgb, var(--card-color, var(--accent)) 10%, var(--surface));
			}
			.reveal .art img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 18%;
				display: block;
			}
			.reveal .info {
				padding: 1em 1.2em 1.2em;
			}
			.reveal h2 {
				margin: 0;
				font-size: 1.35em;
				color: var(--card-color, var(--glow));
			}
			.reveal .meta {
				margin: 0.35em 0 0;
				font-size: 0.8em;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
			}
			.reveal .summary {
				margin: 0.7em 0 0;
				font-size: 0.86em;
				line-height: 1.8;
				color: rgb(var(--gray-dark));
			}
			.reveal .owner {
				margin: 0.9em 0 0;
				padding-top: 0.8em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.84em;
				color: #ffd68a;
			}
			.reveal .owner a {
				color: #ffd68a;
			}
			.reveal .profile {
				display: inline-block;
				margin-top: 0.9em;
				font-size: 0.86em;
				color: var(--accent);
			}

			/* ---------- 按钮 ---------- */
			.actions {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.9em;
			}
			button {
				padding: 0.8em 2.4em;
				border-radius: 999px;
				font-family: inherit;
				font-size: 1.05em;
				cursor: pointer;
				color: #06121a;
				background: var(--glow);
				border: 1px solid var(--glow);
				transition: 0.18s ease;
			}
			button:hover {
				box-shadow: var(--glow-shadow);
				transform: translateY(-2px);
			}
			button:disabled {
				opacity: 0.55;
				cursor: default;
				transform: none;
				box-shadow: none;
			}
			.key-hint {
				margin: -0.6em 0 0;
				font-size: 0.78em;
				color: rgb(var(--gray));
			}
			.key-hint kbd {
				padding: 0.1em 0.45em;
				border-radius: 5px;
				font-family: inherit;
				font-size: 0.95em;
				color: rgb(var(--gray-dark));
				background: rgba(255, 255, 255, 6%);
				border: 1px solid rgb(var(--gray-light));
			}
			.pool-link {
				font-size: 0.9em;
				text-decoration: none;
				color: var(--accent);
			}
			.pool-link:hover {
				color: var(--glow);
			}

			/* ---------- 签纸 ---------- */
			.slip {
				position: relative;
				width: 340px;
				max-width: 100%;
				padding: 1.3em 1.4em 1.4em;
				border-radius: 14px;
				text-align: center;
				/* 签纸用纸色：它是结果，也是最该被一眼看到的一块 */
				background: linear-gradient(#f7f2e8, #ece3d2);
				color: #2b2b33;
				border: 1px solid rgba(120, 100, 70, 22%);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 42%);
				opacity: 0;
				transform: translateY(-8px);
				transition:
					opacity 0.45s ease,
					transform 0.45s ease;
			}
			.slip.show {
				opacity: 1;
				transform: none;
			}
			.slip.pending {
				opacity: 0.5;
				transform: none;
			}
			.slip-tier {
				display: block;
				font-size: 2.5em;
				font-weight: 700;
				line-height: 1.1;
				letter-spacing: 0.18em;
				text-indent: 0.18em;
				color: var(--tier, #3d4a52);
			}
			.slip-text {
				margin: 0.7em 0 0;
				font-size: 0.9em;
				line-height: 1.9;
			}
			.slip[data-key='great'] {
				--tier: #b8352c;
			}
			.slip[data-key='good'] {
				--tier: #a9761a;
			}
			.slip[data-key='middle'],
			.slip[data-key='small'] {
				--tier: #3d4a52;
			}
			.slip[data-key='late'] {
				--tier: #7a6a4f;
			}
			.slip[data-key='bad'] {
				--tier: #7d5a5a;
			}
			/* 大吉：给点动静 */
			.slip[data-key='great'].show {
				animation: jackpot 0.9s ease;
			}
			@keyframes jackpot {
				0% {
					box-shadow:
						0 12px 30px rgba(0, 0, 0, 42%),
						0 0 0 0 rgba(255, 214, 138, 75%);
				}
				45% {
					box-shadow:
						0 12px 30px rgba(0, 0, 0, 42%),
						0 0 0 14px rgba(255, 214, 138, 0%);
				}
				100% {
					box-shadow: 0 12px 30px rgba(0, 0, 0, 42%);
				}
			}

			/* ---------- 这一轮抽到过的 ---------- */
			.history {
				width: 100%;
				margin-top: 0.6em;
				padding-top: 1.4em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.history-title {
				margin: 0 0 0.7em;
				font-size: 0.8em;
				letter-spacing: 0.1em;
				color: rgb(var(--gray));
			}
			.history-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}
			.history-list a {
				display: block;
				width: 52px;
				height: 52px;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				background: var(--surface);
				transition: 0.18s ease;
			}
			.history-list a:hover {
				transform: translateY(-2px);
				box-shadow: var(--glow-shadow);
			}
			.history-list img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 18%;
				display: block;
			}

			.note {
				margin: 2.6em 0 0;
				padding-top: 1.4em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.84em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			.note a {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.card3d,
				.slip {
					width: 100%;
				}
				.actions {
					flex-direction: column;
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>抽签</h1>
			<p class="lead">
				摇一支签，会遇见一位角色，签上还写着今天的运势。签筒里现有 <a href="/draw/pool/"
					>{pool.length} 位</a
				>。
			</p>

			<div class="stage">
				{/* 卡牌：正面是卡背，反面是抽到的角色 */}
				<div class="card3d" id="card3d">
					<div class="card-inner">
						<div class="face cover">
							<span class="cover-ring" aria-hidden="true"></span>
							<span class="cover-mark" aria-hidden="true">签</span>
							<p class="cover-hint">摇一支，遇见一位</p>
						</div>
						<div class="face reveal" id="reveal" style={`--card-color:${first.color}`}>
							<div class="art">
								<img id="art" src={first.art} alt="" width="680" height="850" />
							</div>
							<div class="info">
								<h2 id="name">{first.name}</h2>
								<p class="meta" id="meta">{[first.race, first.title].filter(Boolean).join(' · ')}</p>
								<p class="summary" id="summary">{first.summary}</p>
								<p class="owner" id="owner">
									设主：
									{first.ownerUrl ? (
										<a href={first.ownerUrl} target="_blank" rel="noreferrer">
											{first.owner}
										</a>
									) : (
										first.owner
									)}
								</p>
								<a class="profile" id="profile" href={first.href}>看 TA 的档案 →</a>
							</div>
						</div>
					</div>
				</div>

				<div class="actions">
					<button type="button" id="draw">摇一支签</button>
					<a class="pool-link" href="/draw/pool/">看签筒里都有谁 →</a>
				</div>
				<p class="key-hint">也可以按 <kbd>空格</kbd> 或 <kbd>回车</kbd> 再摇一支</p>

				<div class="slip pending" id="slip" data-key="none">
					<span class="slip-tier" id="slip-tier">？</span>
					<p class="slip-text" id="slip-text">摇一支，看看今天的运势。</p>
				</div>

				<div class="history" id="history" hidden>
					<p class="history-title">这一轮抽到过</p>
					<div class="history-list" id="history-list"></div>
				</div>
			</div>

			<p class="note">
				角色来自朋友与伙伴们的寄放，也包括本站作者自己的淼渺。
				想看全部人与他们的设主，去<a href="/draw/pool/">签筒</a>。
			</p>
		</main>
		<Footer />

		<script type="application/json" id="draw-data" set:html={JSON.stringify({ pool, fortunes })} />

		<script>
			const payload = JSON.parse(document.getElementById('draw-data')!.textContent!);
			const pool = payload.pool;
			const fortunes = payload.fortunes;

			const card3d = document.getElementById('card3d')!;
			const reveal = document.getElementById('reveal')!;
			const art = document.getElementById('art') as HTMLImageElement;
			const nameEl = document.getElementById('name')!;
			const metaEl = document.getElementById('meta')!;
			const summaryEl = document.getElementById('summary')!;
			const ownerEl = document.getElementById('owner')!;
			const profile = document.getElementById('profile') as HTMLAnchorElement;
			const slip = document.getElementById('slip')!;
			const slipTier = document.getElementById('slip-tier')!;
			const slipText = document.getElementById('slip-text')!;
			const drawBtn = document.getElementById('draw') as HTMLButtonElement;
			const historyBox = document.getElementById('history')!;
			const historyList = document.getElementById('history-list')!;

			let rolling = false;
			let opened = false;
			let current = 0;
			const seen = new Set<number>();

			/** 把某一位填进卡面 */
			const fillCharacter = (index: number) => {
				const item = pool[index];
				current = index;
				reveal.style.setProperty('--card-color', item.color);
				if (art.getAttribute('src') !== item.art) art.src = item.art;
				nameEl.textContent = item.name;
				metaEl.textContent = [item.race, item.title].filter(Boolean).join(' · ');
				summaryEl.textContent = item.summary;
				ownerEl.innerHTML = '';
				ownerEl.append('设主：');
				if (item.ownerUrl) {
					const link = document.createElement('a');
					link.href = item.ownerUrl;
					link.target = '_blank';
					link.rel = 'noreferrer';
					link.textContent = item.owner;
					ownerEl.append(link);
				} else {
					ownerEl.append(item.owner);
				}
				profile.href = item.href;
			};

			/** 按权重摇一签 */
			const pickFortune = () => {
				const total = fortunes.reduce((sum: number, f: { weight: number }) => sum + f.weight, 0);
				let roll = Math.random() * total;
				for (const fortune of fortunes) {
					roll -= fortune.weight;
					if (roll <= 0) return fortune;
				}
				return fortunes[fortunes.length - 1];
			};

			const showFortune = (fortune: (typeof fortunes)[number]) => {
				slip.dataset.key = fortune.key;
				slipTier.textContent = fortune.label;
				slipText.textContent = fortune.text;
				slip.classList.remove('pending');
				slip.classList.remove('show');
				void slip.offsetWidth; // 重启动画
				slip.classList.add('show');
			};

			/** 抽到过的记一笔，方便回头看 */
			const remember = (index: number) => {
				if (seen.has(index)) return;
				seen.add(index);
				const item = pool[index];
				const a = document.createElement('a');
				a.href = item.href;
				a.title = item.name;
				const img = document.createElement('img');
				img.src = item.art;
				img.alt = item.name;
				img.loading = 'lazy';
				a.append(img);
				historyList.prepend(a);
				historyBox.hidden = false;
			};

			/** 合上卡牌，签纸回到「还没摇」的状态 */
			const close = () => {
				card3d.classList.remove('open');
				opened = false;
				slip.classList.remove('show');
				slip.classList.add('pending');
				slip.dataset.key = 'none';
				slipTier.textContent = '？';
				slipText.textContent = '签在筒里转……';
			};

			const roll = () => {
				if (rolling) return;
				rolling = true;
				drawBtn.disabled = true;

				const wasOpen = opened;
				close();

				// 已经摊开的话，等它先翻回去再摇
				window.setTimeout(
					() => {
						card3d.classList.add('shaking');

						// 先定好人，摇完就翻
						let next = current;
						while (next === current && pool.length > 1) next = Math.floor(Math.random() * pool.length);
						fillCharacter(next);
						const fortune = pickFortune();

						window.setTimeout(
							() => {
								card3d.classList.remove('shaking');
								card3d.classList.add('open');
								opened = true;
								drawBtn.textContent = '再摇一支';
								// 等翻开之后再落签纸
								window.setTimeout(
									() => {
										showFortune(fortune);
										remember(next);
										rolling = false;
										drawBtn.disabled = false;
									},
									460,
								);
							},
							520,
						);
					},
					wasOpen ? 380 : 0,
				);
			};

			drawBtn.addEventListener('click', roll);

			// 空格 / 回车也能摇；但别抢走链接、按钮自己的按键
			document.addEventListener('keydown', (event) => {
				if (event.key !== ' ' && event.key !== 'Enter') return;
				const el = event.target as HTMLElement | null;
				const tag = el?.tagName;
				if (tag === 'A' || tag === 'INPUT' || tag === 'TEXTAREA') return;
				if (tag === 'BUTTON' && el !== drawBtn) return;
				event.preventDefault();
				roll();
			});
		</script>
	</body>
</html>
