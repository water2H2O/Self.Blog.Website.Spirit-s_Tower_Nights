---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { EMAIL } from '../../consts';
import { drawPool } from '../../lib/draw';

/**
 * 抽签：左边翻牌，右边显示这一位的详细档案，下面是签纸。
 *
 * 流程刻意做成一次小仪式：卡牌左移让位 → 卡背摇晃 → 翻开 → 右侧档案淡入 → 签纸落下。
 *
 * 概率表放在这里（前端按权重摇），坏签刻意压得很低：
 * 大吉 8% / 吉 17% / 中吉 25% / 小吉 30% / 末吉 16% / 凶 4%。
 * 「末吉」不算坏签，只是慢一点；真正的坏签只有「凶」这一档。
 */

const pool = await drawPool();

const fortunes = [
	{
		key: 'great',
		label: '大吉',
		weight: 8,
		text: '塔顶的灯亮了一整夜。今天做什么都顺，适合动手熬那锅一直不敢试的药剂。',
	},
	{
		key: 'good',
		label: '吉',
		weight: 17,
		text: '风向很好。出门会遇到想见的人，或者想见的人会来敲你的门。',
	},
	{
		key: 'middle',
		label: '中吉',
		weight: 25,
		text: '不好不坏 —— 但塔里的灯是亮的，炉子上的水也刚好开。',
	},
	{
		key: 'small',
		label: '小吉',
		weight: 30,
		text: '小事顺利，大事明天再说。今天适合整理药材柜。',
	},
	{
		key: 'late',
		label: '末吉',
		weight: 16,
		text: '慢一点也没关系，药剂本来就要熬三个小时。',
	},
	{
		key: 'bad',
		label: '凶',
		weight: 4,
		text: '药剂糊了。别灰心，明天再熬一锅就是。',
	},
];

/** 档案字段空着的角色，右侧随机挑一句填上 */
const fallbacks = [
	'关于这一位的档案还没写全，眼下只留下了一个名字。',
	'塔里的人对 TA 了解不多 —— 也许下次再摇到就知道了。',
	'记录还在整理中，目前能确定的只有名字与出处。',
	'这份档案很薄。想补充的话，随时可以找站长。',
];

const first = pool[0];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="抽签"
			description={`摇一支签，遇见一位角色，再看看今天的运势。签筒里现有 ${pool.length} 位。`}
		/>
		<style>
			main {
				width: 780px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.lead a {
				color: var(--accent);
			}
			/* 想加入的提示，放在最上面 */
			.join {
				margin: 0 0 1em;
				padding: 0.85em 1.1em;
				border-radius: 12px;
				font-size: 0.86em;
				line-height: 1.8;
				color: #ffd68a;
				background: rgba(255, 200, 90, 9%);
				border: 1px solid rgba(255, 200, 90, 28%);
			}
			/* 窄屏用短版文案，长版藏起来 —— 手机上这段会占掉小半屏 */
			.join .wide {
				display: inline;
			}
			.join .thin {
				display: none;
			}
			.join a {
				color: #ffd68a;
			}
			.stage {
				--detail-w: 348px;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1.5em;
				margin-top: 2.2em;
			}
			/* 左牌右档 */
			.pair {
				display: flex;
				align-items: flex-start;
				justify-content: center;
				gap: 1.6em;
				width: 100%;
				min-height: 430px;
			}

			/* ---------- 卡牌：正面是卡背，反面是抽到的角色 ---------- */
			.card3d {
				flex: none;
				width: 340px;
				max-width: 100%;
				perspective: 1400px;
				transition: transform 0.55s cubic-bezier(0.32, 0.72, 0.28, 1);
			}
			/* 还没摇时，卡牌右移占住中间，右侧档案区先空着 */
			.pair:not(.drawn) .card3d {
				transform: translateX(calc((var(--detail-w) + 1.6em) / 2));
			}
			.card-inner {
				position: relative;
				transform-style: preserve-3d;
				transition: transform 0.62s cubic-bezier(0.32, 0.72, 0.28, 1);
			}
			.card3d.open .card-inner {
				transform: rotateY(180deg);
			}
			.card3d.shaking .card-inner {
				animation: shake 0.5s ease-in-out;
			}
			@keyframes shake {
				0%,
				100% {
					transform: rotate(0);
				}
				15% {
					transform: rotate(-2.5deg) translateY(-3px);
				}
				35% {
					transform: rotate(2deg) translateY(2px);
				}
				55% {
					transform: rotate(-1.6deg) translateY(-2px);
				}
				78% {
					transform: rotate(1.2deg);
				}
			}
			.face {
				backface-visibility: hidden;
				-webkit-backface-visibility: hidden;
				border-radius: 18px;
				overflow: hidden;
				box-shadow:
					0 0 0 1px rgba(0, 0, 0, 25%),
					0 18px 40px rgba(0, 0, 0, 45%);
			}
			.cover {
				position: relative;
				aspect-ratio: 4 / 5;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.9em;
				background:
					radial-gradient(120% 80% at 50% 12%, rgba(175, 255, 255, 13%), transparent 62%),
					linear-gradient(160deg, #16283a, #0d1a26);
				border: 1px solid rgba(175, 255, 255, 26%);
			}
			.cover-mark {
				font-size: 5.2em;
				font-weight: 700;
				line-height: 1;
				color: var(--glow);
				text-shadow: 0 0 26px rgba(175, 255, 255, 45%);
			}
			.cover-hint {
				margin: 0;
				font-size: 0.82em;
				letter-spacing: 0.14em;
				color: rgb(var(--gray));
			}
			.cover-ring {
				position: absolute;
				inset: 12px;
				border-radius: 12px;
				border: 1px solid rgba(175, 255, 255, 14%);
				pointer-events: none;
			}
			.reveal {
				position: absolute;
				inset: 0;
				transform: rotateY(180deg);
				background: var(--surface);
				border: 1px solid color-mix(in srgb, var(--card-color, var(--accent)) 45%, transparent);
			}
			.reveal .art {
				aspect-ratio: 4 / 5;
				overflow: hidden;
				background: color-mix(in srgb, var(--card-color, var(--accent)) 10%, var(--surface));
			}
			.reveal .art img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 18%;
				display: block;
			}
			.reveal .cap {
				padding: 0.9em 1.2em 1.1em;
			}
			.reveal .cap h2 {
				margin: 0;
				font-size: 1.3em;
				color: var(--card-color, var(--glow));
			}
			/* 抽签限定：名字后面挂一个小角标 */
			.limit {
				margin-left: 0.5em;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				font-size: 0.62em;
				font-weight: 400;
				letter-spacing: 0.06em;
				vertical-align: 0.22em;
				color: #06121a;
				background: #ffd68a;
			}
			.detail .d-name .limit {
				font-size: 0.54em;
			}
			.reveal .cap p {
				margin: 0.3em 0 0;
				font-size: 0.8em;
				color: rgb(var(--gray));
			}

			/* ---------- 右侧：这一位的档案 ---------- */
			.detail {
				flex: none;
				width: var(--detail-w);
				opacity: 0;
				transform: translateX(22px);
				transition:
					opacity 0.4s ease 0.18s,
					transform 0.45s ease 0.18s;
			}
			.pair.drawn .detail {
				opacity: 1;
				transform: none;
			}
			.detail .d-name {
				margin: 0;
				font-size: 1.6em;
				color: var(--card-color, var(--glow));
			}
			.detail .d-meta {
				margin: 0.25em 0 0;
				font-size: 0.82em;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
			}
			.detail .d-summary {
				margin: 0.9em 0 0;
				font-size: 0.9em;
				line-height: 1.9;
				color: rgb(var(--gray-dark));
			}
			.detail dl {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.45em 1em;
				margin: 1.1em 0 0;
				padding-top: 1em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.84em;
			}
			.detail dt {
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.detail dd {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.detail dd a {
				color: #ffd68a;
			}
			.detail .d-fallback {
				margin: 1.1em 0 0;
				padding-top: 1em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.86em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			.detail .d-link {
				display: inline-block;
				margin-top: 1.2em;
				padding: 0.5em 1.2em;
				border-radius: 999px;
				font-size: 0.86em;
				text-decoration: none;
				color: var(--accent);
				border: 1px solid rgba(175, 255, 255, 24%);
			}
			.detail .d-link:hover {
				color: var(--glow);
				border-color: rgba(175, 255, 255, 55%);
			}

			/* ---------- 按钮 ---------- */
			.actions {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.9em;
			}
			button {
				padding: 0.8em 2.4em;
				border-radius: 999px;
				font-family: inherit;
				font-size: 1.05em;
				cursor: pointer;
				color: #06121a;
				background: var(--glow);
				border: 1px solid var(--glow);
				transition: 0.18s ease;
			}
			button:hover {
				box-shadow: var(--glow-shadow);
				transform: translateY(-2px);
			}
			button:disabled {
				opacity: 0.55;
				cursor: default;
				transform: none;
				box-shadow: none;
			}
			.key-hint {
				margin: -0.6em 0 0;
				font-size: 0.78em;
				color: rgb(var(--gray));
			}
			.key-hint kbd {
				padding: 0.1em 0.45em;
				border-radius: 5px;
				font-family: inherit;
				font-size: 0.95em;
				color: rgb(var(--gray-dark));
				background: rgba(255, 255, 255, 6%);
				border: 1px solid rgb(var(--gray-light));
			}
			.pool-link {
				font-size: 0.9em;
				text-decoration: none;
				color: var(--accent);
			}
			.pool-link:hover {
				color: var(--glow);
			}

			/* ---------- 签纸 ---------- */
			.slip {
				position: relative;
				width: 340px;
				max-width: 100%;
				padding: 1.3em 1.4em 1.4em;
				border-radius: 14px;
				text-align: center;
				background: linear-gradient(#f7f2e8, #ece3d2);
				color: #2b2b33;
				border: 1px solid rgba(120, 100, 70, 22%);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 42%);
				opacity: 0;
				transform: translateY(-8px);
				transition:
					opacity 0.45s ease,
					transform 0.45s ease;
			}
			.slip.show {
				opacity: 1;
				transform: none;
			}
			.slip.pending {
				opacity: 0.5;
				transform: none;
			}
			.slip-tier {
				display: block;
				font-size: 2.5em;
				font-weight: 700;
				line-height: 1.1;
				letter-spacing: 0.18em;
				text-indent: 0.18em;
				color: var(--tier, #3d4a52);
			}
			.slip-text {
				margin: 0.7em 0 0;
				font-size: 0.9em;
				line-height: 1.9;
			}
			.slip[data-key='great'] {
				--tier: #b8352c;
			}
			.slip[data-key='good'] {
				--tier: #a9761a;
			}
			.slip[data-key='middle'],
			.slip[data-key='small'] {
				--tier: #3d4a52;
			}
			.slip[data-key='late'] {
				--tier: #7a6a4f;
			}
			.slip[data-key='bad'] {
				--tier: #7d5a5a;
			}
			.slip[data-key='great'].show {
				animation: jackpot 0.9s ease;
			}
			@keyframes jackpot {
				0% {
					box-shadow:
						0 12px 30px rgba(0, 0, 0, 42%),
						0 0 0 0 rgba(255, 214, 138, 75%);
				}
				45% {
					box-shadow:
						0 12px 30px rgba(0, 0, 0, 42%),
						0 0 0 14px rgba(255, 214, 138, 0%);
				}
				100% {
					box-shadow: 0 12px 30px rgba(0, 0, 0, 42%);
				}
			}

			/* ---------- 这一轮抽到过（小头像，一行排多个） ---------- */
			.history {
				width: 100%;
				margin-top: 0.4em;
				padding-top: 1.2em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.history-title {
				margin: 0 0 0.55em;
				font-size: 0.78em;
				letter-spacing: 0.1em;
				color: rgb(var(--gray));
			}
			.history-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
			}
			.history-list a {
				display: block;
				width: 34px;
				height: 34px;
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				background: var(--surface);
				transition: 0.15s ease;
			}
			.history-list a:hover {
				transform: translateY(-2px);
				border-color: rgba(175, 255, 255, 45%);
			}
			.history-list img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 18%;
				display: block;
			}

			.note {
				margin: 2.6em 0 0;
				padding-top: 1.4em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.84em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			.note a {
				color: var(--accent);
			}

			/*
			 * 窄屏：竖着叠，也不做左移。
			 *
			 * 手机版的重点是别让立绘把整屏吃满 —— 原来卡面是 cover 面的 4:5 撑出来的，
			 * 而「反面」里的立绘 + 名字加起来比这个高度还高，名字就被挤到卡面外面去，
			 * 得往下滚才看得见。这里给整卡一个确定的高度，立绘改成弹性收缩，
			 * 名字就稳稳落在卡里了。
			 */
			@media (max-width: 860px) {
				main {
					padding-top: 1.6em;
					/* 给吸底的按钮条留出位置，免得挡住页脚 */
					padding-bottom: 5.5em;
				}
				.pair {
					flex-direction: column;
					align-items: center;
					min-height: 0;
					gap: 1.2em;
				}
				.pair:not(.drawn) .card3d {
					transform: none;
				}
				/*
				 * 宽度不要用 `width: 100%` —— 本站没有全局 border-box，
				 * content-box 下 100% 还要再叠一层左右 padding，页面就会横向溢出。
				 * 用 min()/calc 让出一份，剩下的空间才是内容宽度。
				 */
				.detail,
				.slip {
					width: min(100%, 420px);
					max-width: none;
				}
				.slip {
					width: min(calc(100% - 2.8em), 420px);
				}

				/* 卡面：固定高度，立绘弹性收缩，名字留在卡内 */
				.card3d {
					display: flex;
					flex-direction: column;
					width: 290px;
					height: 400px;
				}
				.card-inner {
					flex: 1;
					min-height: 0;
				}
				.card3d .face {
					position: absolute;
					inset: 0;
					aspect-ratio: auto;
				}
				.reveal {
					display: flex;
					flex-direction: column;
				}
				.reveal .art {
					flex: 1;
					min-height: 0;
					aspect-ratio: auto;
				}
				.reveal .cap {
					flex: none;
					padding: 0.7em 1em 0.85em;
				}
				.reveal .cap h2 {
					font-size: 1.15em;
				}

				.actions {
					flex-direction: column;
					width: min(100%, 420px);
					max-width: none;
				}
				/* 吸底：摇完往下看档案时，不用翻回页首也能再摇一支 */
				.actions {
					position: sticky;
					bottom: 0;
					z-index: 5;
					gap: 0.7em;
					margin-top: -0.3em;
					padding: 0.8em 0 0.9em;
					background: rgba(14, 27, 38, 92%);
					backdrop-filter: blur(10px);
					border-top: 1px solid rgb(var(--gray-light));
				}

				/* 页首那几段在手机上占掉小半屏，收一收 */
				h1 {
					font-size: 1.7em;
					margin-bottom: 0.35em;
				}
				.join {
					margin-bottom: 0.8em;
					padding: 0.7em 0.9em;
					font-size: 0.8em;
					line-height: 1.7;
				}
				.join .wide {
					display: none;
				}
				.join .thin {
					display: inline;
				}
				.lead {
					margin-bottom: 0.6em;
					font-size: 0.84em;
				}
				.stage {
					margin-top: 0.9em;
					gap: 1.1em;
				}
				/* 空格/回车是桌面习惯，手机上写明是点按钮 */
				.key-hint {
					font-size: 0.72em;
				}
				.slip {
					padding: 1.1em 1.2em 1.2em;
				}
				.slip-tier {
					font-size: 2.1em;
				}
				.history-list a {
					width: 40px;
					height: 40px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>抽签</h1>
			<p class="join">
				<span class="wide"
					>想把自己家的 OC 也放进签筒？<strong>发邮件到
					<a href={`mailto:${EMAIL}`}>{EMAIL}</a></strong
					>，把<strong>立绘与设定文件一起带上</strong>就行。</span
				>
				<span class="thin"
					>想让自己家的 OC 进签筒？<strong>邮件到
					<a href={`mailto:${EMAIL}`}>{EMAIL}</a></strong
					>，附立绘与设定文件。</span
				>
			</p>
			<p class="lead">
				摇一支签，会遇见一位角色，右边是 TA 的档案，下面还写着今天的运势。签筒里现有 <a
					href="/draw/pool/">{pool.length} 位</a
				>。
			</p>

			<div class="stage">
				<div class="pair" id="pair">
					{/* 卡牌：正面是卡背，反面是抽到的角色 */}
					<div class="card3d" id="card3d">
						<div class="card-inner">
							<div class="face cover">
								<span class="cover-ring" aria-hidden="true"></span>
								<span class="cover-mark" aria-hidden="true">签</span>
								<p class="cover-hint">摇一支，遇见一位</p>
							</div>
							<div class="face reveal" id="reveal" style={`--card-color:${first.color}`}>
								<div class="art">
									<img id="art" src={first.art} alt="" width="680" height="850" />
								</div>
								<div class="cap">
									<h2 id="cap-name">
										{first.name}
										{/* 这个 span 必须始终存在：下面的脚本无条件抓它，少一个就整段抛错、摇不动 */}
										<span class="limit" id="cap-limit" hidden={!first.limited}>限定</span>
									</h2>
									<p id="cap-meta">{[first.race || first.kind, first.title].filter(Boolean).join(' · ')}</p>
								</div>
							</div>
						</div>
					</div>

					{/* 右侧：这一位的详细档案 */}
					<aside class="detail" id="detail">
						<h2 class="d-name" id="d-name">
							{first.name}
							{/* 同上：始终渲染，只切 hidden */}
							<span class="limit" id="d-limit" hidden={!first.limited}>限定</span>
						</h2>
						<p class="d-meta" id="d-meta">{[first.race || first.kind, first.title].filter(Boolean).join(' · ')}</p>
						<p class="d-summary" id="d-summary">{first.summary}</p>
						<dl id="d-fields"></dl>
						<p class="d-fallback" id="d-fallback" hidden></p>
						<a class="d-link" id="d-link" href={first.href}>看 TA 的完整档案 →</a>
					</aside>
				</div>

				<p class="key-hint">也可以按 <kbd>空格</kbd> 或 <kbd>回车</kbd> 再摇一支</p>

				<div class="actions">
					<button type="button" id="draw">摇一支签</button>
					<a class="pool-link" href="/draw/pool/">看签筒里都有谁 →</a>
				</div>

				<div class="slip pending" id="slip" data-key="none">
					<span class="slip-tier" id="slip-tier">？</span>
					<p class="slip-text" id="slip-text">摇一支，看看今天的运势。</p>
				</div>

				<div class="history" id="history" hidden>
					<p class="history-title">这一轮抽到过</p>
					<div class="history-list" id="history-list"></div>
				</div>
			</div>

			<p class="note">
				角色来自朋友与伙伴们的寄放，也包括本站作者自己的淼渺。
				想看全部人与他们的设主，去<a href="/draw/pool/">签筒</a>。
			</p>
		</main>
		<Footer />

		<script
			type="application/json"
			id="draw-data"
			set:html={JSON.stringify({ pool, fortunes, fallbacks })}
		/>

		<script>
			const payload = JSON.parse(document.getElementById('draw-data')!.textContent!);
			const pool = payload.pool;
			const fortunes = payload.fortunes;
			const fallbacks = payload.fallbacks;

			const pair = document.getElementById('pair')!;
			const card3d = document.getElementById('card3d')!;
			const reveal = document.getElementById('reveal')!;
			const art = document.getElementById('art') as HTMLImageElement;
			const capName = document.getElementById('cap-name')!;
			// 这两个角标用可选链：万一标记里没渲染出来，也不该让整段脚本抛错
			const capLimit = document.getElementById('cap-limit') as HTMLElement | null;
			const capMeta = document.getElementById('cap-meta')!;
			const dName = document.getElementById('d-name')!;
			const dLimit = document.getElementById('d-limit') as HTMLElement | null;
			const dMeta = document.getElementById('d-meta')!;
			const dSummary = document.getElementById('d-summary')!;
			const dFields = document.getElementById('d-fields')!;
			const dFallback = document.getElementById('d-fallback')!;
			const dLink = document.getElementById('d-link') as HTMLAnchorElement;
			const slip = document.getElementById('slip')!;
			const slipTier = document.getElementById('slip-tier')!;
			const slipText = document.getElementById('slip-text')!;
			const drawBtn = document.getElementById('draw') as HTMLButtonElement;
			const historyBox = document.getElementById('history')!;
			const historyList = document.getElementById('history-list')!;

			let rolling = false;
			let opened = false;
			let current = 0;
			const seen = new Set<number>();

			/** 往右侧档案里填一行 */
			const field = (label: string, value: string, href?: string) => {
				const dt = document.createElement('dt');
				dt.textContent = label;
				const dd = document.createElement('dd');
				if (href) {
					const a = document.createElement('a');
					a.href = href;
					a.target = '_blank';
					a.rel = 'noreferrer';
					a.textContent = value;
					dd.append(a);
				} else {
					dd.textContent = value;
				}
				dFields.append(dt, dd);
			};

			/** 把某一位填进卡面与右侧档案 */
			const fillCharacter = (index: number) => {
				const item = pool[index];
				current = index;
				reveal.style.setProperty('--card-color', item.color);
				document.getElementById('detail')!.style.setProperty('--card-color', item.color);
				if (art.getAttribute('src') !== item.art) art.src = item.art;

				capName.textContent = item.name;
				if (capLimit) capLimit.hidden = !item.limited;
				capMeta.textContent = [item.race || item.kind, item.title].filter(Boolean).join(' · ');

				dName.textContent = item.name;
				if (dLimit) dLimit.hidden = !item.limited;
				dMeta.textContent = [item.race || item.kind, item.title].filter(Boolean).join(' · ');
				dSummary.textContent = item.summary;
				dLink.href = item.href;

				dFields.innerHTML = '';
				let rows = 0;
				if (item.aliases.length) {
					field('别称', item.aliases.join(' / '));
					rows += 1;
				}
				if (item.height) {
					field('身高', item.height);
					rows += 1;
				}
				if (item.age) {
					field('年龄', item.age);
					rows += 1;
				}
				if (item.pronouns) {
					field('性别', item.pronouns);
					rows += 1;
				}
				field('设主', item.owner, item.ownerUrl || undefined);
				rows += 1;
				if (item.limited) {
					field('限定', '本期抽签限定');
					rows += 1;
				}
				if (item.arts > 0) {
					field('画作', `${item.arts} 张`);
					rows += 1;
				}

				// 除了「设主」，一条档案都没有的话，随机给一句兜底
				if (rows <= 1) {
					dFallback.textContent = fallbacks[Math.floor(Math.random() * fallbacks.length)];
					dFallback.hidden = false;
				} else {
					dFallback.hidden = true;
					dFallback.textContent = '';
				}
			};

			/** 按权重摇一签 */
			const pickFortune = () => {
				const total = fortunes.reduce((sum: number, f: { weight: number }) => sum + f.weight, 0);
				let roll = Math.random() * total;
				for (const fortune of fortunes) {
					roll -= fortune.weight;
					if (roll <= 0) return fortune;
				}
				return fortunes[fortunes.length - 1];
			};

			const showFortune = (fortune: (typeof fortunes)[number]) => {
				slip.dataset.key = fortune.key;
				slipTier.textContent = fortune.label;
				slipText.textContent = fortune.text;
				slip.classList.remove('pending');
				slip.classList.remove('show');
				void slip.offsetWidth;
				slip.classList.add('show');
			};

			/** 抽到过的记一笔（小头像） */
			const remember = (index: number) => {
				if (seen.has(index)) return;
				seen.add(index);
				const item = pool[index];
				const a = document.createElement('a');
				a.href = item.href;
				a.title = item.name;
				const img = document.createElement('img');
				img.src = item.art;
				img.alt = item.name;
				img.loading = 'lazy';
				a.append(img);
				historyList.append(a);
				historyBox.hidden = false;
			};

			/** 合上卡牌，签纸回到「还没摇」的状态（右侧档案留着上一次的，摇完再换） */
			const close = () => {
				card3d.classList.remove('open');
				opened = false;
				slip.classList.remove('show');
				slip.classList.add('pending');
				slip.dataset.key = 'none';
				slipTier.textContent = '？';
				slipText.textContent = '签在筒里转……';
			};

			/** 收尾：无论成功还是中途出错，都要把按钮解锁，别卡在「动不了」 */
			const settle = () => {
				rolling = false;
				drawBtn.disabled = false;
			};

			const roll = () => {
				if (rolling) return;
				rolling = true;
				drawBtn.disabled = true;

				const wasOpen = opened;
				close();

				// 先让位：卡牌左移、右侧档案区亮起来
				pair.classList.add('drawn');

				window.setTimeout(
					() => {
						try {
							card3d.classList.add('shaking');

							let next = current;
							while (next === current && pool.length > 1) next = Math.floor(Math.random() * pool.length);
							fillCharacter(next);
							const fortune = pickFortune();

							window.setTimeout(
								() => {
									try {
										card3d.classList.remove('shaking');
										card3d.classList.add('open');
										opened = true;
										drawBtn.textContent = '再摇一支';
										window.setTimeout(
											() => {
												try {
													showFortune(fortune);
													remember(next);
												} finally {
													settle();
												}
											},
											460,
										);
									} catch (error) {
										console.error('抽签：翻牌阶段出错', error);
										settle();
									}
								},
								520,
							);
						} catch (error) {
							console.error('抽签：摇签阶段出错', error);
							settle();
						}
					},
					wasOpen ? 380 : 240,
				);
			};

			drawBtn.addEventListener('click', roll);

			document.addEventListener('keydown', (event) => {
				if (event.key !== ' ' && event.key !== 'Enter') return;
				const el = event.target as HTMLElement | null;
				const tag = el?.tagName;
				if (tag === 'A' || tag === 'INPUT' || tag === 'TEXTAREA') return;
				if (tag === 'BUTTON' && el !== drawBtn) return;
				event.preventDefault();
				roll();
			});
		</script>
	</body>
</html>
