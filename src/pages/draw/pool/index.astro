---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { EMAIL } from '../../../consts';
import { drawPool } from '../../../lib/draw';

/**
 * 签筒：抽签用的全部条目，按设主名的**字母 / 字符顺序**排。
 *
 * 来源有两处（见 src/lib/draw.ts）：
 *   1. 正式入档、且标了 drawable 的角色 —— 点进去是 /worldview/characters/
 *   2. src/content/draw/ 目录里的条目 —— 只在这个区域出现，点进去是 /draw/entry/
 *
 * 排序口径：拉丁字母的名字在前（Aurelith、Ink_Bai、water2H2O），
 * 中文名按字符码位跟在后面（浅羽 → 天涯 → 应祈 → 白茶 → 芳基胺 → 风汐铃月 → 缪伊伊 → 檐下汐）。
 * 以前用 localeCompare('zh') 按拼音排，中文会被打散插进拉丁名之间，改用默认比较。
 */

const entries = await drawPool();

const owners = [...new Set(entries.map((item) => item.owner))]
	// 默认的字符串比较就是按字符码位：大写字母 < 小写字母 < 中日韩汉字。
	// 注意别再传 'zh' 之类的 locale —— 那会按拼音重排，中文名会跑到前面去。
	.sort()
	.map((owner) => ({
		owner,
		url: entries.find((item) => item.owner === owner)?.ownerUrl ?? '',
		items: entries.filter((item) => item.owner === owner),
	}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="签筒"
			description={`签筒里全部 ${entries.length} 位与他们的 ${owners.length} 位设主，按设主名排列。`}
		/>
		<style>
			main {
				width: 1000px;
			}
			/* 想加入的提示，放在最上面 */
			.join {
				margin: 0 0 1em;
				padding: 0.85em 1.1em;
				border-radius: 12px;
				font-size: 0.86em;
				line-height: 1.8;
				color: #ffd68a;
				background: rgba(255, 200, 90, 9%);
				border: 1px solid rgba(255, 200, 90, 28%);
			}
			.join a {
				color: #ffd68a;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.lead a {
				color: var(--accent);
			}
			.owner-block {
				margin-top: 2.4em;
				padding-top: 1.6em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.owner-block:first-of-type {
				border-top: none;
			}
			.owner-head {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.7em;
				margin-bottom: 1.1em;
			}
			.owner-head h2 {
				margin: 0;
				font-size: 1.2em;
				color: var(--glow);
			}
			.owner-head .home {
				font-size: 0.82em;
				color: var(--accent);
				word-break: break-all;
			}
			.owner-head .count {
				font-size: 0.78em;
				color: rgb(var(--gray));
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
				gap: 1.3em;
			}
			.card {
				display: block;
				border-radius: 14px;
				overflow: hidden;
				text-decoration: none;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-top: 3px solid var(--card-color, var(--accent));
				transition: 0.2s ease;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: var(--glow-shadow);
			}
			.card .art {
				position: relative;
				aspect-ratio: 1;
				overflow: hidden;
				background: color-mix(in srgb, var(--card-color, var(--accent)) 10%, var(--surface));
			}
			.card .art img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 18%;
				display: block;
			}
			/* 没有立绘时的占位：一根虚线框里写「暂无」 */
			.card .no-info {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.3em;
				width: 100%;
				height: 100%;
				border: 1px dashed rgba(127, 233, 240, 22%);
				color: rgb(var(--gray));
			}
			.card .no-info b {
				font-family: Consolas, monospace;
				font-size: 0.9em;
				letter-spacing: 0.14em;
				color: var(--accent);
			}
			.card .no-info i {
				font-size: 0.76em;
				font-style: normal;
			}
			/* 签筒目录里的条目：标一个角标，和正式入档的区分开 */
			.card .flag {
				position: absolute;
				left: 8px;
				top: 8px;
				padding: 1px 7px;
				border-radius: 999px;
				font-size: 10px;
				line-height: 1.6;
				color: #06121a;
				background: rgba(175, 255, 255, 88%);
			}
			/* 抽签限定：挂在右上角，颜色跟「想加入」的提示同一族 */
			.card .flag.limit {
				left: auto;
				right: 8px;
				color: #3a2708;
				background: #ffd68a;
			}
			.card .body {
				padding: 0.8em 0.95em 1em;
			}
			.card h3 {
				margin: 0;
				font-size: 1.02em;
				color: rgb(var(--black));
			}
			.card .meta {
				margin: 0.25em 0 0;
				font-size: 0.76em;
				color: rgb(var(--gray));
			}
			.note {
				margin: 3em 0 0;
				padding-top: 1.4em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.84em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			.note a {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>签筒</h1>
			<p class="join">
				想把自己的 OC 也放进签筒？<strong>发邮件到
					<a href={`mailto:${EMAIL}`}>{EMAIL}</a></strong
				>，把<strong>立绘与设定文件一起带上</strong>就行。
			</p>
			<p class="lead">
				{entries.length} 位，来自 {owners.length} 位设主，按设主名排列。想摇一支玩，回<a
					href="/draw/">抽签</a
				>。
			</p>

			{
				owners.map((group) => (
					<section class="owner-block">
						<div class="owner-head">
							<h2>{group.owner}</h2>
							{group.url && (
								<a class="home" href={group.url} target="_blank" rel="noreferrer">
									{group.url}
								</a>
							)}
							<span class="count">{group.items.length} 位</span>
						</div>
						<div class="cards">
							{group.items.map((item) => (
								<a class="card" href={item.href} style={`--card-color:${item.color}`}>
									<div class="art">
										{item.art ? (
											<img src={item.art} alt={item.name} loading="lazy" decoding="async" />
										) : (
											/* 还没有立绘：明写「暂无」，别留一个空框 */
											<span class="no-info">
												<b>#NO INFO</b>
												<i>暂无立绘</i>
											</span>
										)}
										{item.href.startsWith('/draw/entry/') && <span class="flag">签筒</span>}
										{item.limited && <span class="flag limit">限定</span>}
									</div>
									<div class="body">
										<h3>{item.name}</h3>
										<p class="meta">
											{[item.race || item.kind, item.title].filter(Boolean).join(' · ')}
										</p>
									</div>
								</a>
							))}
						</div>
					</section>
				))
			}

			<p class="note">
				多数是朋友与伙伴们的角色，版权归各设主所有，本站只是收录；
				淼渺是本站作者自己的角色。带「签筒」角标的条目只在这个区域出现，没有进入世界观正式档案；
				带「限定」角标的是本期抽签限定。
			</p>
		</main>
		<Footer />
	</body>
</html>
