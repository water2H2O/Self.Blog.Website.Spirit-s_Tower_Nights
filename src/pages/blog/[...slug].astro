---
import { basename } from 'node:path';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { blogSlugs } from '../../lib/blog-slug';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	// URL 用 frontmatter 的语义短地址（/blog/log/），与源文件名分离。
	const slugs = blogSlugs(posts);
	return posts.map((post) => ({
		params: { slug: slugs.get(post.id) ?? post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
// Read the actual source basename, not the short URL code or the extension-less collection ID.
const sourceFilename = basename(post.filePath ?? `${post.id}.md`);
const { Content } = await render(post);
---

<BlogPost {...post.data} sourceFilename={sourceFilename}>
	<Content />
</BlogPost>
