			}
			.hero-models li {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 3.2em 5.4em 5.4em;
				gap: 0.4em;
				align-items: baseline;
				padding: 0.3em 0.45em;
				border-radius: 7px;
				background: rgba(0, 0, 0, 18%);
			}
			.m-name {
				color: rgb(var(--gray));
				overflow-wrap: anywhere;
			}
			.m-share,
