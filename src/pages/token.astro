				font-size: 0.64em;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.hero-stats dd {
				white-space: nowrap;
				font-size: 0.86em;
				font-weight: 600;
				color: var(--glow);
				font-variant-numeric: tabular-nums;
				}
			.hero-models {
				display: flex;
