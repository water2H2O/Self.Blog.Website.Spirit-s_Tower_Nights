---
/**
 * /token —— 「最近在烧什么」的详细页。
 *
 * 首页那块只放三席 + 四格；真要看曲线、看每天怎么烧、看哪个模型贵，
 * 都在这页。数据还是 src/data/token-usage.json（tools/fetch-token-usage.mjs 生成）。
 * 全部是构建时算好的静态 SVG；页面只带一小段原生 JS —— 负责悬停浮层和「基础 / 详细」两张图的显隐切换，不拉任何库。
 */
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import aiDeepseek from '../assets/oc/ai-deepseek.webp';
import aiGpt from '../assets/oc/ai-gpt.webp';
import aiClaude from '../assets/oc/ai-claude.webp';
import glmGuest from '../assets/oc/glm-guest.webp';
import geminiGuest from '../assets/oc/gemini-guest.webp';
import imageGuest from '../assets/oc/image-guest.webp';
import tokenUsage from '../data/token-usage.json';
import { familyOf, guestFamilyOf, GUEST_NAMES, isImageModel } from '../data/canteen-seats.mjs';

type Day = {
	date: string;
	tokens: number;
	requests: number;
	cost: number;
	parts?: Record<string, number>;
};
type Series = { label: string; tokens: number; share?: number; cost?: number };
const data = tokenUsage as {
	daily?: Day[];
	series?: Series[];
	source?: string;
	fetchedAt?: string;
	dimension?: string;
	totals?: { tokens?: number; cost?: number; requests?: number; cacheRead?: number };
	/** 中转站停止导出后的本机补充记录：口径不同，不参与合计与图表 */
	localRelay?: {
		source?: string;
		note?: string;
		after?: string;
		days?: { date: string; model: string; requests: number; tokens: number; cost: number }[];
	};
};

const days: Day[] = (data.daily ?? []).filter((d) => d.tokens > 0);
const series: Series[] = (data.series ?? []).filter((s) => s.tokens > 0);

/** 三个系列够用了；多了就按顺序取色 */
const COLORS = ['#7fe9f0', '#c9a8ff', '#ffd68a', '#8fdc9b', '#e06a7a', '#9be7e0'];
const colored = series.map((s, i) => ({ ...s, color: COLORS[i % COLORS.length] }));

/**
 * 「基础」视图：只留模型家族名，不带版本号、也不带来源（官方 / 中转站）。
 * 同一家族在官方和中转站两头用的都并成一条，名字按各家官方的写法。
 */
function familyOfLabel(label: string): string {
	const cut = label.indexOf(' · ');
	const model = cut < 0 ? label : label.slice(cut + 3);
	// 生图要单独成一家，不能被 gpt 吞掉；它的「版本号」长这样：gpt-image-2 → gpt-image
	if (/image/i.test(model)) return 'GPT-Image';
	if (/deepseek/i.test(model)) return 'DeepSeek';
	if (/claude/i.test(model)) return 'Claude';
	if (/gemini/i.test(model)) return 'Gemini';
	if (/glm/i.test(model)) return 'GLM';
	if (/gpt|openai/i.test(model)) return 'GPT';
	return model;
}

const familyTotals = new Map<string, number>();
for (const s of series) {
	const key = familyOfLabel(s.label);
	familyTotals.set(key, (familyTotals.get(key) ?? 0) + s.tokens);
}
const basicSeries = [...familyTotals]
	.map(([label, tokens]) => ({ label, tokens }))
	.sort((a, b) => b.tokens - a.tokens);
const basicColored = basicSeries.map((s, i) => ({ ...s, color: COLORS[i % COLORS.length] }));

/** 把一天的分段按家族合并，喂给基础视图的柱子和浮层 */
function basicPartsOf(day: Day): Record<string, number> {
	const out = new Map<string, number>();
	for (const [label, value] of Object.entries(day.parts ?? {})) {
		if (!(value > 0)) continue;
		const key = familyOfLabel(label);
		out.set(key, (out.get(key) ?? 0) + value);
	}
	return Object.fromEntries(out);
}

const fmt = (n: number) =>
	n >= 1e8 ? `${(n / 1e8).toFixed(2)} 亿` : n >= 1e4 ? `${(n / 1e4).toFixed(1)} 万` : String(n);
const fmtYuan = (n: number) => `¥${n.toFixed(2)}`;

const totalTokens = data.totals?.tokens ?? days.reduce((a, d) => a + d.tokens, 0);
const totalCost = data.totals?.cost ?? days.reduce((a, d) => a + d.cost, 0);
const totalRequests = data.totals?.requests ?? days.reduce((a, d) => a + d.requests, 0);
const dayCount = days.length || 1;
const avgTokens = totalTokens / dayCount;
const avgCost = totalCost / dayCount;
const unitPrice = totalTokens > 0 ? (totalCost / totalTokens) * 1e6 : null;
const lastDate = days.at(-1)?.date ?? '';

/** 有花费的天里，最贵的一天 */
const priciest = [...days].sort((a, b) => b.cost - a.cost)[0] ?? null;
/** 用量最大的一天 */
const biggest = [...days].sort((a, b) => b.tokens - a.tokens)[0] ?? null;

/**
 * 每日堆叠柱：一天一根，按分段上色。
 * 「基础」按家族、「详细」按具体型号，同一套几何参数，只是分段不同。
 */
function buildTokenStack(list: { label: string; color: string }[], partsOf: (d: Day) => Record<string, number>) {
	if (days.length === 0) return null;
	const W = 960;
	const H = 280;
	const PL = 10;
	const PR = 76;
	const PT = 16;
	const PB = 30;
	const plotW = W - PL - PR;
	const plotH = H - PT - PB;
	const max = Math.max(...days.map((d) => d.tokens), 1);
	const y = (v: number) => PT + plotH - (v / max) * plotH;
	const slot = plotW / days.length;
	const barW = Math.max(6, Math.min(30, slot * 0.6));
	const labelEvery = Math.max(1, Math.ceil(days.length / 8));
	const bars = days.map((d, i) => {
		const cx = PL + slot * i + slot / 2;
		let acc = 0;
		const parts = partsOf(d);
		const segs: { color: string; label: string; y: number; h: number; value: number }[] = [];
		for (const s of list) {
			const value = parts[s.label] ?? (list.length === 1 ? d.tokens : 0);
			if (value <= 0) continue;
			const y0 = y(acc);
			const y1 = y(acc + value);
			acc += value;
			segs.push({ color: s.color, label: s.label, y: y1, h: Math.max(0.6, y0 - y1), value });
		}
		return {
			date: d.date,
			cx,
			segs,
			label: i === 0 || i === days.length - 1 || i % labelEvery === 0,
		};
	});
	return { W, H, PL, PR, PT, PB, plotW, plotH, max, y, bars, barW, slot };
}

const stack = buildTokenStack(colored, (d) => d.parts ?? {});
const stackBasic = buildTokenStack(basicColored, basicPartsOf);

/** 每日花费：折线。颜色按高度取（userSpaceOnUse 渐变，底部青、中段金、顶部红），越贵越红 */
const costChart = (() => {
	if (days.length === 0) return null;
	const W = 960;
	const H = 190;
	const PL = 10;
	const PR = 76;
	const PT = 26;
	const PB = 26;
	const plotW = W - PL - PR;
	const plotH = H - PT - PB;
	const base = PT + plotH;
	const max = Math.max(...days.map((d) => d.cost), 0.01);
	const y = (v: number) => base - (v / max) * plotH;
	const slot = plotW / days.length;
	const labelEvery = Math.max(1, Math.ceil(days.length / 8));
	const points = days.map((d, i) => ({
		x: PL + slot * i + slot / 2,
		y: y(d.cost),
		date: d.date,
		cost: d.cost,
		label: i === 0 || i === days.length - 1 || i % labelEvery === 0,
		peak: priciest !== null && d.date === priciest.date,
	}));
	const line = points.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
	const area = `${line} L${points.at(-1)!.x.toFixed(1)} ${base} L${points[0].x.toFixed(1)} ${base} Z`;
	const peak = points.find((p) => p.peak) ?? null;
	const peakAnchor = !peak ? 'middle' : peak.x > PL + plotW * 0.88 ? 'end' : peak.x < PL + plotW * 0.12 ? 'start' : 'middle';
	return { W, H, PL, PR, PT, PB, plotW, plotH, base, max, points, line, area, peak, peakAnchor, slot };
})();

/** 逐日明细喂给悬停浮层：两种粒度的颜色和数字都在这里，前端只负责排版 */
const tipData = {
	colors: {
		basic: Object.fromEntries(basicColored.map((s) => [s.label, s.color])),
		detail: Object.fromEntries(colored.map((s) => [s.label, s.color])),
	},
	days: days.map((d) => ({
		date: d.date,
		tokens: d.tokens,
		cost: d.cost,
		requests: d.requests,
		parts: { basic: basicPartsOf(d), detail: d.parts ?? {} },
	})),
};

/** 表格：倒序，最近的在上面；一页 30 天，翻页由页面上的小脚本负责显隐 */
const PAGE_SIZE = 30;
const rows = [...days].reverse();
const rowPages: Day[][] = [];
for (let i = 0; i < rows.length; i += PAGE_SIZE) rowPages.push(rows.slice(i, i + PAGE_SIZE));

/**
 * 角色面板：像二游那样，一位 AI 一张卡 —— 左边立绘，右边是它自己的全部账。
 * 立绘暂用三联画切出来的三格（`ai-*.webp`），换新图时同名覆盖即可。
 */
const ROSTER = [
	{ key: 'deepseek', name: 'DeepSeek', role: '常驻那位', line: '抱着鲸鱼碗喊「再来一碗」', art: aiDeepseek, hue: '#7fe9f0' },
	{ key: 'gpt', name: 'GPT', role: '外援那位', line: '趴在一摞本子上说「终于干完了」', art: aiGpt, hue: '#c9a8ff' },
	{ key: 'claude', name: 'Claude', role: '结账那位', line: '举着账单，一脸困惑', art: aiClaude, hue: '#ffd68a' },
] as const;

const rosterCards = ROSTER.map((meta) => {
	const members = series
		.filter((s) => familyOf(s.label) === meta.key)
		.sort((a, b) => b.tokens - a.tokens);
	const tokens = members.reduce((sum, s) => sum + s.tokens, 0);
	const costs = members.map((s) => s.cost ?? 0);
	const cost = costs.reduce((sum, c) => sum + c, 0);
	const activeDays = new Set(
		days.filter((d) => members.some((s) => (d.parts?.[s.label] ?? 0) > 0)).map((d) => d.date),
	).size;
	return { ...meta, members, tokens, cost, days: activeDays };
});

/**
 * 加桌客人：同样一张卡，只是没有三联画里的小图。
 * 按家族归组 —— Gemini 现在有两个型号（4-argon / 3.8-flash），各占一张卡就成了两张一样的脸。
 */
const guestGroups = new Map<string, Series[]>();
for (const s of series.filter((s) => !familyOf(s.label))) {
	const key = guestFamilyOf(s.label);
	if (!guestGroups.has(key)) guestGroups.set(key, []);
	guestGroups.get(key)!.push(s);
}
const guestCards = [...guestGroups.entries()]
	.map(([key, members]) => {
		const tokens = members.reduce((sum, s) => sum + s.tokens, 0);
		const cost = members.reduce((sum, s) => sum + (s.cost ?? 0), 0);
		const requests = members.reduce((sum, s) => sum + ((s as { requests?: number }).requests ?? 0), 0);
		const dayCount = days.filter((d) => members.some((s) => (d.parts?.[s.label] ?? 0) > 0)).length;
		const image = members.some((s) => isImageModel(s.label));
		const ranked = [...members].sort((a, b) => b.tokens - a.tokens);
		return {
			label: members.map((s) => s.label).join('、'),
			// 单型号照旧显示型号名；合并的用家族名（Gemini）
			name: members.length === 1 ? (ranked[0].label.split('·').pop()?.trim() ?? ranked[0].label) : (GUEST_NAMES[key] ?? key),
			modelList: ranked.map((s) => s.label.split('·').pop()?.trim() ?? s.label),
			tokens,
			cost,
			days: dayCount,
			requests,
			perImage: image && requests ? cost / requests : null,
			image,
			art: image ? imageGuest : /glm/i.test(key) ? glmGuest : /gemini/i.test(key) ? geminiGuest : null,
			hue: image ? '#7fe9f0' : /gemini/i.test(key) ? '#ff9ecb' : '#c6a6ff',
		};
	})
	.sort((a, b) => b.tokens - a.tokens);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="烧了什么 · token 用量"
			description="这个站每天烧掉多少 DeepSeek token、花多少钱、各模型各占多少 —— 详细图表与逐日明细。"
		/>
		<style>
			main {
				width: 1020px;
			}
			.crumb {
				font-size: 0.8em;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.crumb:hover {
				color: var(--glow);
			}
			h1 {
				margin: 0.7em 0 0.2em;
			}
			.lead {
				margin: 0 0 2em;
				font-size: 0.92em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			h2 {
				display: flex;
				align-items: center;
				gap: 0.85em;
				margin: 2.6em 0 0.9em;
				font-size: 0.84em;
				font-weight: 400;
				letter-spacing: 0.22em;
				color: rgb(var(--gray));
			}
			h2::before {
				content: '';
				flex: none;
				width: 7px;
				height: 7px;
				background: var(--accent);
				transform: rotate(45deg);
				box-shadow: 0 0 12px rgba(175, 255, 255, 75%);
			}
			h2::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(90deg, rgba(175, 255, 255, 30%), transparent 70%);
			}
			/* ---------- 角色面板：一位 AI 一张卡 ---------- */
			.roster {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.9em;
			}
			.roster.guests {
				grid-template-columns: repeat(auto-fit, minmax(min(19em, 100%), 1fr));
				margin-bottom: 0.6em;
			}
			.hero {
				position: relative;
				display: flex;
				flex-direction: column;
				overflow: hidden;
				border-radius: 16px;
				border: 1px solid color-mix(in srgb, var(--hue) 32%, transparent);
				background:
					radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--hue) 16%, transparent), transparent 62%),
					var(--surface);
				box-shadow: 0 10px 26px rgba(0, 0, 0, 32%);
			}
			.hero-art {
				position: relative;
				background: linear-gradient(180deg, rgba(8, 18, 26, 46%), transparent);
			}
			.hero-art :global(img) {
				display: block;
				width: 100%;
				height: auto;
				max-height: 15em;
				object-fit: cover;
				object-position: center 30%;
			}
			/* 加桌那两位是透明底的切图，contain 才不会被裁掉 */
			.hero.guest .hero-art :global(img) {
				object-fit: contain;
				max-height: 12em;
			}
			.hero-body {
				display: flex;
				flex-direction: column;
				gap: 0.35em;
				padding: 0.9em 1em 1em;
			}
			.hero-role {
				margin: 0;
				font-size: 0.7em;
				letter-spacing: 0.16em;
				color: color-mix(in srgb, var(--hue) 80%, white 20%);
			}
			.hero-name {
				margin: 0;
				font-size: 1.25em;
				line-height: 1.2;
				color: var(--glow);
			}
			.hero-line {
				margin: 0 0 0.4em;
				font-size: 0.76em;
				line-height: 1.7;
				color: rgb(var(--gray));
			}
			/* 加桌合并卡：名字下面补一行它其实包含哪几款型号 */
			.hero-models {
				margin: 0.35em 0 0;
				font-size: 0.72em;
				line-height: 1.6;
				color: rgb(var(--gray));
				opacity: 0.8;
				overflow-wrap: anywhere;
			}
			.hero-stats {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.4em;
