					white-space: normal;
					font-size: 0.88em;
					line-height: 1.6;
					color: rgb(var(--gray));
				}
			}
		</style>
		<style is:global>
			/* 浮层内容由脚本动态创建，拿不到 Astro 的 scoped 属性，只能全局生效 */
			/* 悬停浮层：跟手的小卡片，深色底 + 细描边 */
			.tk-tip {
				position: absolute;
				top: 0;
				left: 0;
				z-index: 40;
				min-width: 15em;
				max-width: 22em;
				padding: 0.7em 0.85em;
				border-radius: 10px;
				border: 1px solid rgba(175, 255, 255, 26%);
				background: rgba(10, 24, 34, 96%);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 45%);
				backdrop-filter: blur(6px);
				pointer-events: none;
				font-size: 0.82em;
				color: rgb(var(--gray-dark));
			}
			.tip-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				padding-bottom: 0.45em;
				margin-bottom: 0.45em;
				border-bottom: 1px solid rgba(175, 255, 255, 14%);
			}
			.tip-date {
				font-variant-numeric: tabular-nums;
				color: rgb(var(--gray));
			}
			.tip-total {
				font-weight: 600;
				color: var(--glow);
				font-variant-numeric: tabular-nums;
			}
			.tip-rows {
				display: flex;
				flex-direction: column;
				gap: 0.28em;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.tip-rows li {
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.tip-rows i {
				flex: none;
				width: 8px;
				height: 8px;
				border-radius: 2px;
			}
			.tip-name {
				flex: 1 1 auto;
				min-width: 0;
				overflow-wrap: anywhere;
				color: rgb(var(--gray));
			}
			.tip-rows b {
				margin-left: 0.7em;
				font-weight: 600;
				color: var(--glow);
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}
			.tip-foot {
				margin: 0.5em 0 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="crumb" href="/">← 首页</a>
			<h1>烧了什么</h1>
			<p class="lead">
				这个站每天要烧掉多少 token、花多少钱。数字来自 DeepSeek 开放平台的用量导出 + 中转站的账单，
				两边合并去重后按下天统计 —— <strong>不是实时</strong>，每次导出后手动刷新一次。
			</p>

			<ul class="kpis">
				<li>
					<span>区间合计</span><b>{fmt(totalTokens)}</b><small
						>{days.length} 天 · {totalRequests.toLocaleString('en-US')} 次请求</small
					>
				</li>
				<li>
					<span>总花费</span><b>{fmtYuan(totalCost)}</b><small
						>每百万 tokens 约 ¥{unitPrice ? unitPrice.toFixed(3) : '—'}</small
					>
				</li>
				<li>
					<span>日均</span><b>{fmt(avgTokens)}</b><small>{fmtYuan(avgCost)} / 天</small>
				</li>
				<li>
					<span>最贵的一天</span><b>{priciest ? fmtYuan(priciest.cost) : '—'}</b><small
						>{priciest ? priciest.date : '—'}</small
					>
				</li>
			</ul>

			<h2>角色面板</h2>
			<div class="roster">
				{
					rosterCards.map((card) => (
						<article class="hero" style={`--hue:${card.hue}`}>
							<div class="hero-art">
								<Image src={card.art} alt={`${card.name} 的立绘`} width={640} loading="lazy" />
							</div>
							<div class="hero-body">
								<p class="hero-role">{card.role}</p>
								<h3 class="hero-name">{card.name}</h3>
								<p class="hero-line">{card.line}</p>
								<dl class="hero-stats">
									<div>
										<dt>占比</dt>
										<dd>{(card.tokens / (totalTokens || 1)) * 100 >= 0.1 ? `${((card.tokens / (totalTokens || 1)) * 100).toFixed(1)}%` : '<0.1%'}</dd>
									</div>
									<div>
										<dt>总量</dt>
										<dd>{fmt(card.tokens)}</dd>
									</div>
									<div>
										<dt>花费</dt>
										<dd>{fmtYuan(card.cost)}</dd>
									</div>
									<div>
										<dt>出勤</dt>
										<dd>{card.days} 天</dd>
									</div>
								</dl>
								<ul class="hero-models">
									{card.members.map((m) => (
										<li>
											<span class="m-name">{m.label.split('·').pop()?.trim()}</span>
											<span class="m-share">{(m.share ?? 0) > 0 ? `${m.share}%` : '<0.1%'}</span>
											<span class="m-tokens">{fmt(m.tokens)}</span>
											<span class="m-cost">{fmtYuan(m.cost ?? 0)}</span>
										</li>
									))}
								</ul>
							</div>
						</article>
					))
				}
			</div>

			<h2>加桌</h2>
			<div class="roster guests">
				{
					guestCards.map((card) => (
						<article class="hero guest" style={`--hue:${card.hue}`}>
							{card.art ? (
								<div class="hero-art">
									<Image src={card.art} alt={`${card.name} 的形象`} width={420} loading="lazy" />
								</div>
							) : null}
							<div class="hero-body">
								<h3 class="hero-name">{card.name}</h3>
								<dl class="hero-stats">
									<div>
										<dt>量</dt>
										<dd>{fmt(card.tokens)}</dd>
									</div>
									<div>
										<dt>花费</dt>
										<dd>{fmtYuan(card.cost)}</dd>
									</div>
									<div>
										<dt>{card.image ? '张数' : '出勤'}</dt>
										<dd>{card.image ? `${card.requests} 张` : `${card.days} 天`}</dd>
									</div>
									{card.perImage !== null && (
										<div>
											<dt>单张</dt>
											<dd>{fmtYuan(card.perImage)}</dd>
										</div>
									)}
								</dl>
							</div>
						</article>
					))
				}
			</div>

			<h2>每天烧多少（按来源 · 模型）</h2>
			<div class="card">
				{
					stack && (
						<svg
							class="chart"
							viewBox={`0 0 ${stack.W} ${stack.H}`}
							role="img"
							aria-label="每日 token 用量堆叠柱状图"
							data-chart="tokens"
						>
							{[0, 0.25, 0.5, 0.75, 1].map((r) => (
								<line
									class="grid"
									x1={stack.PL}
									x2={stack.W - stack.PR}
									y1={stack.PT + stack.plotH * r}
									y2={stack.PT + stack.plotH * r}
								/>
							))}
							<text class="axis" x={stack.W - 6} y={stack.PT + 4} text-anchor="end">
								{fmt(stack.max)}
							</text>
							<text class="axis" x={stack.W - 6} y={stack.PT + stack.plotH} text-anchor="end">
								0
							</text>
							{stack.bars.map((bar) => (
								<g>
									{bar.segs.map((seg) => (
										<rect
											x={bar.cx - stack.barW / 2}
											y={seg.y}
											width={stack.barW}
											height={seg.h}
											fill={seg.color}
											fill-opacity="0.85"
											rx="1.5"
										/>
									))}
									{/* 整根柱子的悬停热区：比柱子宽一点，细日子也好指中 */}
									<rect
										class="hit"
										x={bar.cx - stack.slot / 2}
										y={stack.PT}
										width={stack.slot}
										height={stack.plotH}
										fill="transparent"
										data-chart="tokens"
										data-date={bar.date}
									/>
									{bar.label && (
										<text class="axis" x={bar.cx} y={stack.H - 8} text-anchor="middle">
											{bar.date.slice(5).replace('-', '/')}
										</text>
									)}
								</g>
							))}
						</svg>
					)
				}
				<ul class="legend">
					{
						colored.map((s) => (
							<li>
								<span class="dot" style={`background:${s.color}`} />
								<span class="name">{s.label}</span>
								<span class="num">{fmt(s.tokens)}</span>
							</li>
						))
					}
				</ul>
			</div>

			<h2>每天花多少</h2>
			<div class="card">
				{
					costChart && (
						<svg
							class="chart"
							viewBox={`0 0 ${costChart.W} ${costChart.H}`}
							role="img"
							aria-label="每日花费折线图，线越高颜色越红"
							data-chart="cost"
						>
							<defs>
								{/* 按画布坐标铺的竖向渐变：同一高度永远同一种颜色，平线段也能正常上色 */}
								<linearGradient id="cost-line" gradientUnits="userSpaceOnUse" x1="0" y1={costChart.base} x2="0" y2={costChart.PT}>
									<stop offset="0%" stop-color="#7fe9f0" />
									<stop offset="55%" stop-color="#ffd68a" />
									<stop offset="100%" stop-color="#e06a7a" />
								</linearGradient>
							</defs>
							{[0, 0.5, 1].map((r) => (
								<line
									class="grid"
									x1={costChart.PL}
									x2={costChart.W - costChart.PR}
									y1={costChart.PT + costChart.plotH * r}
									y2={costChart.PT + costChart.plotH * r}
								/>
							))}
							<text class="axis" x={costChart.W - 6} y={costChart.PT + 4} text-anchor="end">
								{fmtYuan(costChart.max)}
							</text>
							<text class="axis" x={costChart.W - 6} y={costChart.PT + costChart.plotH} text-anchor="end">
								0
							</text>
							<path d={costChart.area} fill="url(#cost-line)" fill-opacity="0.12" />
							<path
								d={costChart.line}
								fill="none"
								stroke="url(#cost-line)"
								stroke-width="2.4"
								stroke-linejoin="round"
								stroke-linecap="round"
							/>
							{costChart.points.map((p) => (
								<g>
									<circle class="cost-dot" cx={p.x} cy={p.y} r={p.peak ? 4.5 : 2.6} fill="url(#cost-line)" />
									{/* 透明的大圈只负责悬停提示，点很小也好停 */}
									<circle class="cost-hit" cx={p.x} cy={p.y} r="10" fill="transparent" data-chart="cost" data-date={p.date} />
									<rect
										class="hit"
										x={p.x - costChart.slot / 2}
										y={costChart.PT}
										width={costChart.slot}
										height={costChart.plotH}
										fill="transparent"
										data-chart="cost"
										data-date={p.date}
									/>
									{p.label && (
										<text class="axis" x={p.x} y={costChart.H - 8} text-anchor="middle">
											{p.date.slice(5).replace('-', '/')}
										</text>
									)}
								</g>
							))}
							{costChart.peak && (
								<text class="axis cost-peak" x={costChart.peak.x} y={costChart.peak.y - 10} text-anchor={costChart.peakAnchor}>
									{fmtYuan(costChart.peak.cost)}
								</text>
							)}
						</svg>
					)
				}
				<p class="note">
					最贵的是 {priciest ? `${priciest.date}（${fmtYuan(priciest.cost)}）` : '—'}；
					用量最大的是 {biggest ? `${biggest.date}（${fmt(biggest.tokens)}）` : '—'}。
				</p>
			</div>

			<h2>谁占了多少</h2>
			<div class="card">
				{
					colored.map((s) => (
						<div class="share-row">
							<span class="share-name">{s.label}</span>
							<span class="share-bar">
								<i style={`width:${Math.max(1, s.share ?? 0)}%;background:${s.color}`} />
							</span>
							<span class="share-num">
								{(s.share ?? 0) > 0 ? `${s.share}%` : '<0.1%'} · {fmt(s.tokens)}
							</span>
						</div>
					))
				}
				<p class="note">
					占比按整个导出区间的 token 总量算。单价差得很远：贵的那种往往量小、账单却大。
				</p>
			</div>

			<h2>逐日明细</h2>
			<div class="card">
				<table class="daily">
					<thead>
						<tr>
							<th>日期</th>
							<th>tokens</th>
							<th>请求</th>
							<th>花费</th>
							<th>构成</th>
						</tr>
					</thead>
					<tbody>
						{
							rows.map((d) => (
								<tr>
									<td>{d.date}</td>
									<td>{fmt(d.tokens)}</td>
									<td>
										{d.requests}
										<span class="unit"> 次</span>
									</td>
									<td>{d.cost ? fmtYuan(d.cost) : '—'}</td>
									<td class="parts">
										{/* 每段单独一个不换行的 span：窄屏只在「+」之间折行，不把模型名拆成两截 */}
										{Object.entries(d.parts ?? {})
											.sort((a, b) => b[1] - a[1])
											.map(([label, v]) => (
												<span class="part">
													{label.replace(/^官方 · |^中转站 · /, '')} {fmt(v)}
												</span>
											))}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			<p class="note">
				数据源：{data.source ?? 'token-usage.json'}。刷新方式是在仓库里跑
				<code>node tools/fetch-token-usage.mjs --zip=… --relay=…</code> 再提交，站点重新构建后这页才更新。
				最后一天（{lastDate}）通常还不完整。
			</p>
		</main>
		<Footer />

		{/* 图表悬停浮层：内容由下面那段脚本按 data-date 查表填 */}
		<div class="tk-tip" id="tk-tip" role="tooltip" hidden>
			<div class="tip-head">
				<span class="tip-date"></span>
				<span class="tip-total"></span>
			</div>
			<ul class="tip-rows"></ul>
			<p class="tip-foot"></p>
		</div>

		<script type="application/json" id="tk-days" set:html={JSON.stringify(tipData)} />

		<script>
			type Day = {
				date: string;
				tokens: number;
				cost: number;
				requests: number;
				parts: Record<string, number>;
			};
			const raw = document.getElementById('tk-days')?.textContent ?? '{}';
			const tip = JSON.parse(raw) as { colors: Record<string, string>; days: Day[] };
			const byDate = new Map(tip.days.map((d) => [d.date, d]));

			const box = document.getElementById('tk-tip') as HTMLDivElement;
			const elDate = box.querySelector('.tip-date') as HTMLElement;
			const elTotal = box.querySelector('.tip-total') as HTMLElement;
			const elRows = box.querySelector('.tip-rows') as HTMLUListElement;
			const elFoot = box.querySelector('.tip-foot') as HTMLElement;

			const fmtTokens = (n: number) =>
				n >= 1e8 ? `${(n / 1e8).toFixed(2)} 亿` : n >= 1e4 ? `${(n / 1e4).toFixed(1)} 万` : String(Math.round(n));
			const fmtYuan = (n: number) => `¥${n.toFixed(2)}`;

			/** 哪张图悬停，浮层就写什么口径 */
			function fill(chart: string, day: Day) {
				const entries = Object.entries(day.parts ?? {}).sort((a, b) => b[1] - a[1]);
				elDate.textContent = day.date;
				elTotal.textContent = chart === 'cost' ? fmtYuan(day.cost) : fmtTokens(day.tokens);
				elRows.replaceChildren();

				const shown = chart === 'cost' ? entries.slice(0, 3) : entries;
				for (const [label, value] of shown) {
					const li = document.createElement('li');
					const dot = document.createElement('i');
					dot.style.background = tip.colors[label] ?? '#7fe9f0';
					const name = document.createElement('span');
					name.className = 'tip-name';
					name.textContent = label;
					const num = document.createElement('b');
					// 花费图没有「每天每模型」的账单，只给这个模型当天占的量，不能编个价钱出来
					num.textContent = chart === 'cost' ? fmtTokens(value) : fmtTokens(value);
					li.append(dot, name, num);
					elRows.append(li);
				}

				elFoot.textContent =
					chart === 'cost'
						? `${day.requests} 次请求 · 下面按当天 token 量排序`
						: `${day.requests} 次请求 · 合计 ${fmtYuan(day.cost)}`;
			}

			/** 浮层跟着指针，但默认摆在指针上方 —— 免得盖住正被指着的那根柱子 */
			function place(event: PointerEvent) {
				const pad = 12;
				const rect = box.getBoundingClientRect();
				let x = event.clientX + pad;
				let y = event.clientY - rect.height - pad;
				if (x + rect.width > window.innerWidth - 8) x = event.clientX - rect.width - pad;
				if (y < 8 + window.scrollY) y = event.clientY + pad + 18;
				box.style.transform = `translate(${Math.max(8, x)}px, ${Math.max(8, y + window.scrollY)}px)`;
			}

			const charts = document.querySelectorAll<SVGSVGElement>('svg.chart[data-chart]');
			for (const svg of charts) {
				const chart = svg.dataset.chart ?? 'tokens';
				const bars = svg.querySelectorAll<SVGGraphicsElement>('rect.hit');
				bars.forEach((hit) => {
					hit.addEventListener('pointerenter', (event) => {
						const day = byDate.get(hit.dataset.date ?? '');
						if (!day) return;
						fill(chart, day);
						box.hidden = false;
						place(event as PointerEvent);
						svg.classList.add('is-hovering');
						hit.classList.add('is-active');
					});
					hit.addEventListener('pointermove', (event) => {
						if (!box.hidden) place(event as PointerEvent);
					});
					hit.addEventListener('pointerleave', () => {
						box.hidden = true;
						svg.classList.remove('is-hovering');
						hit.classList.remove('is-active');
					});
				});
			}
		</script>
	</body>
</html>
