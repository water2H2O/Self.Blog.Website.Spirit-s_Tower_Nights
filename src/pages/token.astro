				.roster {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 640px) {
				.roster,
				.roster.guests {
					grid-template-columns: minmax(0, 1fr);
				}
				.hero-art :global(img) {
					max-height: 17em;
				}
				.hero-models li {
					grid-template-columns: minmax(0, 1fr) auto auto auto;
					gap: 0.55em;
				}
			}
			.m-tokens {
				text-align: right;
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
				color: rgb(var(--gray));
			}
			.card {
				padding: 1.4em 1.5em 1.2em;
				border-radius: 16px;
				background:
					radial-gradient(120% 90% at 100% 0%, rgba(127, 233, 240, 6%), transparent 58%),
					var(--surface);
				border: 1px solid rgb(var(--gray-light));
			}
			.kpis {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 0.7em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.kpis li {
				display: flex;
				flex-direction: column;
				gap: 0.2em;
				padding: 0.8em 0.9em;
				border-radius: 12px;
				background: rgba(175, 255, 255, 4%);
				border: 1px solid rgba(175, 255, 255, 12%);
			}
			.kpis span {
				font-size: 0.72em;
				letter-spacing: 0.06em;
				color: rgb(var(--gray));
			}
			.kpis b {
				font-size: 1.28em;
				color: var(--glow);
				font-variant-numeric: tabular-nums;
			}
			.kpis small {
				font-size: 0.7em;
				color: rgb(var(--gray));
				opacity: 0.75;
			}
			svg.chart {
				display: block;
				width: 100%;
				height: auto;
				overflow: visible;
			}
			/* 悬停热区：透明、不吃鼠标样式变化，但能接住指针 */
			svg.chart .hit {
				cursor: crosshair;
			}
			/* 悬停时压暗其余柱子，被指到的那根保持原样 */
			svg.chart.is-hovering > g {
				opacity: 0.4;
			}
			svg.chart.is-hovering > g:has(.is-active) {
				opacity: 1;
			}
			.axis {
				fill: rgb(var(--gray));
				font-size: 11px;
			}
			.grid {
				stroke: rgba(175, 255, 255, 10%);
				stroke-dasharray: 3 5;
			}
			/* 花费折线上的点：描一圈底色，压在线上也看得清 */
			.cost-dot {
				stroke: var(--surface);
				stroke-width: 1.4;
			}
			.cost-peak {
				fill: #f3a3ad;
				font-weight: 600;
			}
			.legend {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em 1.4em;
				margin: 1em 0 0;
				padding: 0;
				list-style: none;
				font-size: 0.8em;
			}
			/* 基础 / 详细：两张图、两份图例都渲染好，切换只是显隐，不重排 */
			[hidden] {
				display: none !important;
			}
			.chart-modes {
				display: flex;
				gap: 0.4em;
				margin: 0 0 0.6em;
			}
			.chart-modes button {
				padding: 0.3em 0.9em;
				font: inherit;
				font-size: 0.78em;
				color: rgb(var(--gray));
				background: rgba(175, 255, 255, 4%);
				border: 1px solid rgba(175, 255, 255, 14%);
				border-radius: 99px;
				cursor: pointer;
			}
			.chart-modes button:hover {
				color: var(--glow);
				border-color: var(--accent-dark);
			}
			.chart-modes button.is-on {
				color: rgb(var(--black));
				background: var(--accent);
				border-color: var(--accent);
				font-weight: 600;
			}
			.legend li {
				display: flex;
				align-items: center;
				gap: 0.45em;
			}
			.legend .dot {
				flex: none;
				width: 9px;
				height: 9px;
				border-radius: 2px;
			}
			.legend .name {
				color: rgb(var(--gray));
			}
			.legend .num {
				color: var(--glow);
				font-variant-numeric: tabular-nums;
			}
			.share-row {
				display: grid;
				grid-template-columns: 12em 1fr 8.5em;
				align-items: center;
				gap: 0.9em;
				padding: 0.5em 0;
				border-bottom: 1px dashed rgb(var(--gray-light));
				font-size: 0.86em;
			}
			.share-row:last-child {
				border-bottom: 0;
			}
			.share-bar {
				height: 8px;
				border-radius: 999px;
				background: rgba(175, 255, 255, 6%);
				overflow: hidden;
			}
			.share-bar i {
				display: block;
				height: 100%;
				border-radius: 999px;
			}
			.share-num {
				text-align: right;
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
				color: var(--glow);
			}
			table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.84em;
				font-variant-numeric: tabular-nums;
			}
			th,
			td {
				padding: 0.55em 0.6em;
				text-align: right;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			th:first-child,
			td:first-child {
				text-align: left;
			}
			th {
				font-weight: 400;
				color: rgb(var(--gray));
				letter-spacing: 0.06em;
			}
			tbody tr:hover {
				background: rgba(175, 255, 255, 4%);
			}
			.daily .unit {
				display: none;
			}
			/* 逐日明细：一行一天，点开才展开当天构成 */
			.day-row {
				cursor: pointer;
			}
			.day-row .date-cell {
				white-space: nowrap;
			}
			.day-row .chev {
				display: inline-block;
				width: 1em;
				margin-right: 0.35em;
				color: var(--accent);
				transition: transform 0.15s;
			}
			.day-row[aria-expanded='true'] .chev {
				transform: rotate(90deg);
			}
			.day-row[aria-expanded='true'] {
				background: rgba(175, 255, 255, 6%);
			}
			.day-row:focus-visible {
				outline: 2px solid var(--glow);
				outline-offset: -2px;
			}
			.day-more > td {
				padding: 0.2em 0.6em 0.9em;
				text-align: left;
				background: rgba(175, 255, 255, 3%);
			}
			.more-list {
				display: grid;
				gap: 0.4em;
				margin: 0;
				padding: 0;
				list-style: none;
				font-size: 0.82em;
			}
			.more-list li {
				display: grid;
				grid-template-columns: minmax(8em, 13em) minmax(3em, 1fr) auto;
				align-items: center;
				gap: 0.7em;
			}
			.more-list .dot {
				flex: none;
				width: 8px;
				height: 8px;
				border-radius: 2px;
			}
			.m-name {
				display: flex;
				align-items: center;
				gap: 0.5em;
				min-width: 0;
				color: rgb(var(--gray));
				overflow-wrap: anywhere;
			}
			.m-bar {
				display: block;
				height: 5px;
				border-radius: 3px;
				background: rgba(175, 255, 255, 9%);
				overflow: hidden;
			}
			.m-bar span {
				display: block;
				height: 100%;
				border-radius: 3px;
				background: var(--glow);
				opacity: 0.55;
			}
			.m-num {
				color: var(--glow);
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
				text-align: right;
			}
			.m-pct {
				display: inline-block;
				min-width: 3.4em;
				margin-left: 0.6em;
				font-size: 0.9em;
				color: rgb(var(--gray));
				text-align: right;
			}
			.pager {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1em;
				margin: 1em 0 0;
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.pager button {
				padding: 0.35em 0.9em;
				font: inherit;
				color: rgb(var(--gray));
				background: rgba(175, 255, 255, 4%);
				border: 1px solid rgba(175, 255, 255, 14%);
				border-radius: 99px;
				cursor: pointer;
			}
			.pager button:hover:not(:disabled) {
				color: var(--glow);
				border-color: var(--accent-dark);
			}
			.pager button:disabled {
				opacity: 0.35;
				cursor: default;
			}
			.pager-info b {
				color: var(--glow);
			}
			.daily-hint {
				margin: 0.8em 0 0;
				font-size: 0.74em;
				color: rgb(var(--gray));
				opacity: 0.75;
			}
			.note {
				margin: 1em 0 0;
				font-size: 0.76em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			.note code {
				font-size: 0.95em;
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.kpis {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				/* 占比行：三列在手机上会把数字挤出卡片、把模型名拆成两截。
				   改成上面一行「名字 …… 数字」，下面整行一根条 */
				.share-row {
					grid-template-columns: minmax(0, 1fr) auto;
					grid-template-areas: 'name num' 'bar bar';
					gap: 0.4em 0.8em;
					padding: 0.6em 0;
				}
				.share-name {
					grid-area: name;
					min-width: 0;
					overflow-wrap: anywhere;
				}
				.share-num {
					grid-area: num;
				}
				.share-bar {
					grid-area: bar;
				}
				.card {
					padding: 1.1em 1em 1em;
				}
				/* 逐日明细：五列在手机上挤不下，「构成」会被压成一字一行把表格撑出卡片。
				   改成一天一块：上面一行日期 / tokens / 请求 / 花费，下面整行放构成 */
				.daily thead {
					position: absolute;
					width: 1px;
					height: 1px;
					overflow: hidden;
					clip: rect(0 0 0 0);
					white-space: nowrap;
				}
				.daily,
				.daily tbody {
					display: block;
				}
				.daily tr {
					display: grid;
					grid-template-columns: auto 1fr auto auto;
					align-items: baseline;
					gap: 0.25em 0.9em;
					padding: 0.7em 0.2em;
					border-bottom: 1px solid rgb(var(--gray-light));
				}
				.daily tbody tr:hover {
					background: none;
				}
				.daily td {
					padding: 0;
					border: 0;
					white-space: nowrap;
				}
				.daily td:first-child {
					color: var(--glow);
				}
				.daily td:nth-child(2) {
					text-align: left;
				}
				.daily .unit {
					display: inline;
					font-size: 0.85em;
					color: rgb(var(--gray));
				}
				/* 展开出来的当天构成：手机上条缩短一点，名称与数字各占一行更宽松 */
				.daily tr.day-more {
					display: block;
					padding: 0;
				}
				.daily .day-more > td {
					display: block;
					padding: 0 0.2em 0.9em;
				}
				.more-list {
					grid-template-columns: minmax(0, 1fr);
					gap: 0.5em;
				}
				.more-list li {
					grid-template-columns: minmax(0, 1fr) auto;
					gap: 0.2em 0.6em;
				}
				.m-name {
					white-space: normal;
				}
				.m-bar {
					grid-column: 1 / -1;
					order: 3;
				}
			}
		</style>
		<style is:global>
			/* 浮层内容由脚本动态创建，拿不到 Astro 的 scoped 属性，只能全局生效 */
			/* 悬停浮层：跟手的小卡片，深色底 + 细描边 */
			.tk-tip {
				position: absolute;
				top: 0;
				left: 0;
				z-index: 40;
				min-width: 15em;
				max-width: 22em;
				padding: 0.7em 0.85em;
				border-radius: 10px;
				border: 1px solid rgba(175, 255, 255, 26%);
				background: rgba(10, 24, 34, 96%);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 45%);
				backdrop-filter: blur(6px);
				pointer-events: none;
				font-size: 0.82em;
				color: rgb(var(--gray-dark));
			}
			.tip-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				padding-bottom: 0.45em;
				margin-bottom: 0.45em;
				border-bottom: 1px solid rgba(175, 255, 255, 14%);
			}
			.tip-date {
				font-variant-numeric: tabular-nums;
				color: rgb(var(--gray));
			}
			.tip-total {
				font-weight: 600;
				color: var(--glow);
				font-variant-numeric: tabular-nums;
			}
			.tip-rows {
				display: flex;
				flex-direction: column;
				gap: 0.28em;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.tip-rows li {
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.tip-rows i {
				flex: none;
				width: 8px;
				height: 8px;
				border-radius: 2px;
			}
			.tip-name {
				flex: 1 1 auto;
				min-width: 0;
				overflow-wrap: anywhere;
				color: rgb(var(--gray));
			}
			.tip-rows b {
				margin-left: 0.7em;
				font-weight: 600;
				color: var(--glow);
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}
			.tip-foot {
				margin: 0.5em 0 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="crumb" href="/">← 首页</a>
			<h1>烧了什么</h1>
			<p class="lead">
				这个站每天要烧掉多少 token、花多少钱。数字来自 DeepSeek 开放平台的用量导出 + 中转站的账单，
				两边合并去重后按下天统计 —— <strong>不是实时</strong>，每次导出后手动刷新一次。
			</p>

			<ul class="kpis">
				<li>
					<span>区间合计</span><b>{fmt(totalTokens)}</b><small
						>{days.length} 天 · {totalRequests.toLocaleString('en-US')} 次请求</small
					>
				</li>
				<li>
					<span>总花费</span><b>{fmtYuan(totalCost)}</b><small
						>每百万 tokens 约 ¥{unitPrice ? unitPrice.toFixed(3) : '—'}</small
					>
				</li>
				<li>
					<span>日均</span><b>{fmt(avgTokens)}</b><small>{fmtYuan(avgCost)} / 天</small>
				</li>
				<li>
					<span>最贵的一天</span><b>{priciest ? fmtYuan(priciest.cost) : '—'}</b><small
						>{priciest ? priciest.date : '—'}</small
					>
				</li>
			</ul>

			<h2>角色面板</h2>
			<div class="roster">
				{
					rosterCards.map((card) => (
						<article class="hero" style={`--hue:${card.hue}`}>
							<div class="hero-art">
								<Image src={card.art} alt={`${card.name} 的立绘`} width={640} loading="lazy" />
							</div>
							<div class="hero-body">
								<p class="hero-role">{card.role}</p>
								<h3 class="hero-name">{card.name}</h3>
								<p class="hero-line">{card.line}</p>
								<dl class="hero-stats">
									<div>
										<dt>占比</dt>
										<dd>{(card.tokens / (totalTokens || 1)) * 100 >= 0.1 ? `${((card.tokens / (totalTokens || 1)) * 100).toFixed(1)}%` : '<0.1%'}</dd>
									</div>
									<div>
										<dt>总量</dt>
										<dd>{fmt(card.tokens)}</dd>
									</div>
									<div>
										<dt>花费</dt>
										<dd>{fmtYuan(card.cost)}</dd>
									</div>
									<div>
										<dt>出勤</dt>
										<dd>{card.days} 天</dd>
									</div>
								</dl>
								<ul class="hero-models">
									{card.members.map((m) => (
										<li>
											<span class="m-name">{m.label.split('·').pop()?.trim()}</span>
											<span class="m-share">{(m.share ?? 0) > 0 ? `${m.share}%` : '<0.1%'}</span>
											<span class="m-tokens">{fmt(m.tokens)}</span>
											<span class="m-cost">{fmtYuan(m.cost ?? 0)}</span>
										</li>
									))}
								</ul>
							</div>
						</article>
					))
				}
			</div>

			<h2>加桌</h2>
			<div class="roster guests">
				{
					guestCards.map((card) => (
						<article class="hero guest" style={`--hue:${card.hue}`}>
							{card.art ? (
								<div class="hero-art">
									<Image src={card.art} alt={`${card.name} 的形象`} width={420} loading="lazy" />
								</div>
							) : null}
							<div class="hero-body">
								<h3 class="hero-name">{card.name}</h3>
								{card.modelList.length > 1 && <p class="hero-models">{card.modelList.join(' · ')}</p>}
								<dl class="hero-stats">
									<div>
										<dt>量</dt>
										<dd>{fmt(card.tokens)}</dd>
									</div>
									<div>
										<dt>花费</dt>
										<dd>{fmtYuan(card.cost)}</dd>
									</div>
									<div>
										<dt>{card.image ? '张数' : '出勤'}</dt>
										<dd>{card.image ? `${card.requests} 张` : `${card.days} 天`}</dd>
									</div>
									{card.perImage !== null && (
										<div>
											<dt>单张</dt>
											<dd>{fmtYuan(card.perImage)}</dd>
										</div>
									)}
								</dl>
							</div>
						</article>
					))
				}
			</div>

			<h2>每天烧多少（按来源 · 模型）</h2>
			<div class="card">
				<div class="chart-modes" role="group" aria-label="图表粒度">
					<button type="button" data-mode="basic" class="is-on" aria-pressed="true">基础</button>
					<button type="button" data-mode="detail" aria-pressed="false">详细</button>
				</div>
				{
					[stackBasic, stack].map((st, i) =>
						st ? (
							<svg
								class="chart"
								viewBox={`0 0 ${st.W} ${st.H}`}
								role="img"
								aria-label={`每日 token 用量堆叠柱状图（${i === 0 ? '基础：按模型家族' : '详细：按具体型号'}）`}
								data-chart="tokens"
								data-mode={i === 0 ? 'basic' : 'detail'}
								hidden={i === 1}
							>
								{[0, 0.25, 0.5, 0.75, 1].map((r) => (
									<line
										class="grid"
										x1={st.PL}
										x2={st.W - st.PR}
										y1={st.PT + st.plotH * r}
										y2={st.PT + st.plotH * r}
									/>
								))}
								<text class="axis" x={st.W - 6} y={st.PT + 4} text-anchor="end">
									{fmt(st.max)}
								</text>
								<text class="axis" x={st.W - 6} y={st.PT + st.plotH} text-anchor="end">
									0
								</text>
								{st.bars.map((bar) => (
									<g>
										{bar.segs.map((seg) => (
											<rect
												x={bar.cx - st.barW / 2}
												y={seg.y}
												width={st.barW}
												height={seg.h}
												fill={seg.color}
												fill-opacity="0.85"
												rx="1.5"
											/>
										))}
										{/* 整根柱子的悬停热区：比柱子宽一点，细日子也好指中 */}
										<rect
											class="hit"
											x={bar.cx - st.slot / 2}
											y={st.PT}
											width={st.slot}
											height={st.plotH}
											fill="transparent"
											data-chart="tokens"
											data-date={bar.date}
										/>
										{bar.label && (
											<text class="axis" x={bar.cx} y={st.H - 8} text-anchor="middle">
												{bar.date.slice(5).replace('-', '/')}
											</text>
										)}
									</g>
								))}
							</svg>
						) : null,
					)
				}
				{[basicColored, colored].map((list, i) => (
					<ul class="legend" data-mode={i === 0 ? 'basic' : 'detail'} hidden={i === 1}>
						{list.map((s) => (
							<li>
								<span class="dot" style={`background:${s.color}`} />
								<span class="name">{s.label}</span>
								<span class="num">{fmt(s.tokens)}</span>
							</li>
						))}
					</ul>
				))}
			</div>

			<h2>每天花多少</h2>
			<div class="card">
				{
					costChart && (
						<svg
							class="chart"
							viewBox={`0 0 ${costChart.W} ${costChart.H}`}
							role="img"
							aria-label="每日花费折线图，线越高颜色越红"
							data-chart="cost"
						>
							<defs>
								{/* 按画布坐标铺的竖向渐变：同一高度永远同一种颜色，平线段也能正常上色 */}
								<linearGradient id="cost-line" gradientUnits="userSpaceOnUse" x1="0" y1={costChart.base} x2="0" y2={costChart.PT}>
									<stop offset="0%" stop-color="#7fe9f0" />
									<stop offset="55%" stop-color="#ffd68a" />
									<stop offset="100%" stop-color="#e06a7a" />
								</linearGradient>
							</defs>
							{[0, 0.5, 1].map((r) => (
								<line
									class="grid"
									x1={costChart.PL}
									x2={costChart.W - costChart.PR}
									y1={costChart.PT + costChart.plotH * r}
									y2={costChart.PT + costChart.plotH * r}
								/>
							))}
							<text class="axis" x={costChart.W - 6} y={costChart.PT + 4} text-anchor="end">
								{fmtYuan(costChart.max)}
							</text>
							<text class="axis" x={costChart.W - 6} y={costChart.PT + costChart.plotH} text-anchor="end">
								0
							</text>
							<path d={costChart.area} fill="url(#cost-line)" fill-opacity="0.12" />
							<path
								d={costChart.line}
								fill="none"
								stroke="url(#cost-line)"
								stroke-width="2.4"
								stroke-linejoin="round"
								stroke-linecap="round"
							/>
							{costChart.points.map((p) => (
								<g>
									<circle class="cost-dot" cx={p.x} cy={p.y} r={p.peak ? 4.5 : 2.6} fill="url(#cost-line)" />
									{/* 透明的大圈只负责悬停提示，点很小也好停 */}
									<circle class="cost-hit" cx={p.x} cy={p.y} r="10" fill="transparent" data-chart="cost" data-date={p.date} />
									<rect
										class="hit"
										x={p.x - costChart.slot / 2}
										y={costChart.PT}
										width={costChart.slot}
										height={costChart.plotH}
										fill="transparent"
										data-chart="cost"
										data-date={p.date}
									/>
									{p.label && (
										<text class="axis" x={p.x} y={costChart.H - 8} text-anchor="middle">
											{p.date.slice(5).replace('-', '/')}
										</text>
									)}
								</g>
							))}
							{costChart.peak && (
								<text class="axis cost-peak" x={costChart.peak.x} y={costChart.peak.y - 10} text-anchor={costChart.peakAnchor}>
									{fmtYuan(costChart.peak.cost)}
								</text>
							)}
						</svg>
					)
				}
				<p class="note">
					最贵的是 {priciest ? `${priciest.date}（${fmtYuan(priciest.cost)}）` : '—'}；
					用量最大的是 {biggest ? `${biggest.date}（${fmt(biggest.tokens)}）` : '—'}。
				</p>
			</div>

			<h2>谁占了多少</h2>
			<div class="card">
				{
					colored.map((s) => (
						<div class="share-row">
							<span class="share-name">{s.label}</span>
							<span class="share-bar">
								<i style={`width:${Math.max(1, s.share ?? 0)}%;background:${s.color}`} />
							</span>
							<span class="share-num">
								{(s.share ?? 0) > 0 ? `${s.share}%` : '<0.1%'} · {fmt(s.tokens)}
							</span>
						</div>
					))
				}
				<p class="note">
					占比按整个导出区间的 token 总量算。单价差得很远：贵的那种往往量小、账单却大。
				</p>
			</div>

			<h2>逐日明细</h2>
			<div class="card">
				<table class="daily" id="daily-table">
					<thead>
						<tr>
							<th>日期</th>
							<th>tokens</th>
							<th>请求</th>
							<th>花费</th>
						</tr>
					</thead>
					{rowPages.map((page, pageIndex) => (
						<tbody data-page={pageIndex + 1} hidden={pageIndex > 0}>
							{page.map((d) => (
								<Fragment>
									<tr class="day-row" data-day={d.date} tabindex="0" aria-expanded="false">
										<td class="date-cell">
											<span class="chev" aria-hidden="true">▸</span>
											{d.date}
										</td>
										<td>{fmt(d.tokens)}</td>
										<td>
											{d.requests}
											<span class="unit"> 次</span>
										</td>
										<td>{d.cost ? fmtYuan(d.cost) : '—'}</td>
									</tr>
									<tr class="day-more" data-more={d.date} hidden>
										<td colspan="4">
											<ul class="more-list">
												{Object.entries(d.parts ?? {})
													.sort((a, b) => b[1] - a[1])
													.map(([label, v]) => (
														<li>
															<span class="m-name">
																<span class="dot" style={`background:${tipData.colors.detail[label] ?? '#7fe9f0'}`} />
																{label.replace(/^官方 · |^中转站 · /, '')}
															</span>
															<span class="m-bar">
																<span style={`width:${d.tokens > 0 ? Math.max(2, (v / d.tokens) * 100).toFixed(1) : 0}%`} />
															</span>
															<span class="m-num">
																{fmt(v)}
																<span class="m-pct">
																	{d.tokens > 0 ? ((v / d.tokens) * 100).toFixed(1) : '0.0'}%
																</span>
															</span>
														</li>
													))}
											</ul>
										</td>
									</tr>
								</Fragment>
							))}
						</tbody>
					))}
				</table>
				{rowPages.length > 1 && (
					<nav class="pager" id="daily-pager" aria-label="逐日明细分页">
						<button type="button" data-prev>
							← 上一页
						</button>
						<span class="pager-info">
							第 <b data-current>1</b> / {rowPages.length} 页 · 共 {rows.length} 天
						</span>
						<button type="button" data-next>
							下一页 →
						</button>
					</nav>
				)}
				<p class="daily-hint">点一行可以展开当天各模型的用量构成。</p>
			</div>

			{data.localRelay?.days?.length ? (
				<>
					<h2>中转站停服后的本地记录</h2>
					<div class="card">
						<table class="daily">
							<thead>
								<tr>
									<th>日期</th>
									<th>模型</th>
									<th>次数</th>
									<th>本地记录用量</th>
									<th>本地估算花费</th>
								</tr>
							</thead>
							<tbody>
								{data.localRelay.days.map((row) => (
									<tr>
										<td>{row.date}</td>
										<td>{row.model}</td>
										<td>
											{row.requests}
											<span class="unit"> 次</span>
										</td>
										<td>{fmt(row.tokens)}</td>
										<td>{row.cost ? fmtYuan(row.cost) : '—'}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="note">{data.localRelay.note}</p>
						<p class="note">
							数据来源：{data.localRelay.source}；中转站导出止于 {data.localRelay.after}。
							这几行不计入上面的合计、占比和逐日图表。
						</p>
					</div>
				</>
			) : null}

			<p class="note">
				数据源：{data.source ?? 'token-usage.json'}。刷新方式是在仓库里跑
				<code>node tools/fetch-token-usage.mjs --zip=… --relay=…</code> 再提交，站点重新构建后这页才更新。
				最后一天（{lastDate}）通常还不完整。
			</p>
		</main>
		<Footer />

		{/* 图表悬停浮层：内容由下面那段脚本按 data-date 查表填 */}
		<div class="tk-tip" id="tk-tip" role="tooltip" hidden>
			<div class="tip-head">
				<span class="tip-date"></span>
				<span class="tip-total"></span>
			</div>
			<ul class="tip-rows"></ul>
			<p class="tip-foot"></p>
		</div>

		<script type="application/json" id="tk-days" set:html={JSON.stringify(tipData)} />

		<script>
			type Day = {
				date: string;
				tokens: number;
				cost: number;
				requests: number;
				parts: { basic: Record<string, number>; detail: Record<string, number> };
			};
			const raw = document.getElementById('tk-days')?.textContent ?? '{}';
			const tip = JSON.parse(raw) as {
				colors: { basic: Record<string, string>; detail: Record<string, string> };
				days: Day[];
			};
			const byDate = new Map(tip.days.map((d) => [d.date, d]));

			/** 当前粒度：基础（按家族）为默认，详细（按型号）可切换 */
			let mode: 'basic' | 'detail' = 'basic';
			const modeButtons = document.querySelectorAll<HTMLButtonElement>('.chart-modes button');
			function applyMode(next: 'basic' | 'detail') {
				mode = next;
				for (const btn of modeButtons) {
					const on = btn.dataset.mode === next;
					btn.classList.toggle('is-on', on);
					btn.setAttribute('aria-pressed', String(on));
				}
				for (const el of document.querySelectorAll<HTMLElement>('[data-mode]')) {
					if (el.tagName === 'BUTTON') continue;
					el.hidden = el.dataset.mode !== next;
				}
			}
			for (const btn of modeButtons) {
				btn.addEventListener('click', () => applyMode(btn.dataset.mode === 'detail' ? 'detail' : 'basic'));
			}

			const box = document.getElementById('tk-tip') as HTMLDivElement;
			const elDate = box.querySelector('.tip-date') as HTMLElement;
			const elTotal = box.querySelector('.tip-total') as HTMLElement;
			const elRows = box.querySelector('.tip-rows') as HTMLUListElement;
			const elFoot = box.querySelector('.tip-foot') as HTMLElement;

			const fmtTokens = (n: number) =>
				n >= 1e8 ? `${(n / 1e8).toFixed(2)} 亿` : n >= 1e4 ? `${(n / 1e4).toFixed(1)} 万` : String(Math.round(n));
			const fmtYuan = (n: number) => `¥${n.toFixed(2)}`;

			/** 哪张图悬停，浮层就写什么口径；粒度跟着上方的「基础 / 详细」走（花费图固定按型号） */
			function fill(chart: string, day: Day) {
				const granularity = chart === 'cost' ? 'detail' : mode;
				const palette = tip.colors[granularity] ?? {};
				const entries = Object.entries(day.parts?.[granularity] ?? {}).sort((a, b) => b[1] - a[1]);
				elDate.textContent = day.date;
				elTotal.textContent = chart === 'cost' ? fmtYuan(day.cost) : fmtTokens(day.tokens);
				elRows.replaceChildren();

				const shown = chart === 'cost' ? entries.slice(0, 3) : entries;
				for (const [label, value] of shown) {
					const li = document.createElement('li');
					const dot = document.createElement('i');
					dot.style.background = palette[label] ?? '#7fe9f0';
					const name = document.createElement('span');
					name.className = 'tip-name';
					name.textContent = label;
					const num = document.createElement('b');
					// 花费图没有「每天每模型」的账单，只给这个模型当天占的量，不能编个价钱出来
					num.textContent = chart === 'cost' ? fmtTokens(value) : fmtTokens(value);
					li.append(dot, name, num);
					elRows.append(li);
				}

				elFoot.textContent =
					chart === 'cost'
						? `${day.requests} 次请求 · 下面按当天 token 量排序`
						: `${day.requests} 次请求 · 合计 ${fmtYuan(day.cost)}`;
			}

			/** 浮层跟着指针，但默认摆在指针上方 —— 免得盖住正被指着的那根柱子 */
			function place(event: PointerEvent) {
				const pad = 12;
				const rect = box.getBoundingClientRect();
				let x = event.clientX + pad;
				let y = event.clientY - rect.height - pad;
				if (x + rect.width > window.innerWidth - 8) x = event.clientX - rect.width - pad;
				if (y < 8 + window.scrollY) y = event.clientY + pad + 18;
				box.style.transform = `translate(${Math.max(8, x)}px, ${Math.max(8, y + window.scrollY)}px)`;
			}

			const charts = document.querySelectorAll<SVGSVGElement>('svg.chart[data-chart]');
			for (const svg of charts) {
				const chart = svg.dataset.chart ?? 'tokens';
				const bars = svg.querySelectorAll<SVGGraphicsElement>('rect.hit');
				bars.forEach((hit) => {
					hit.addEventListener('pointerenter', (event) => {
						const day = byDate.get(hit.dataset.date ?? '');
						if (!day) return;
						fill(chart, day);
						box.hidden = false;
						place(event as PointerEvent);
						svg.classList.add('is-hovering');
						hit.classList.add('is-active');
					});
					hit.addEventListener('pointermove', (event) => {
						if (!box.hidden) place(event as PointerEvent);
					});
					hit.addEventListener('pointerleave', () => {
						box.hidden = true;
						svg.classList.remove('is-hovering');
						hit.classList.remove('is-active');
					});
				});
			}
			/* ---------- 逐日明细：翻页 + 点行展开 ---------- */
			const table = document.getElementById('daily-table');
			const pager = document.getElementById('daily-pager');
			if (table) {
				const bodys = [...table.querySelectorAll<HTMLTableSectionElement>('tbody[data-page]')];
				let page = 1;
				const paint = () => {
					for (const body of bodys) body.hidden = Number(body.dataset.page) !== page;
					const cur = pager?.querySelector('[data-current]');
					if (cur) cur.textContent = String(page);
					const prev = pager?.querySelector<HTMLButtonElement>('[data-prev]');
					const next = pager?.querySelector<HTMLButtonElement>('[data-next]');
					if (prev) prev.disabled = page <= 1;
					if (next) next.disabled = page >= bodys.length;
				};
				pager?.querySelector('[data-prev]')?.addEventListener('click', () => {
					if (page > 1) {
						page -= 1;
						paint();
						table.scrollIntoView({ block: 'start', behavior: 'smooth' });
					}
				});
				pager?.querySelector('[data-next]')?.addEventListener('click', () => {
					if (page < bodys.length) {
						page += 1;
						paint();
						table.scrollIntoView({ block: 'start', behavior: 'smooth' });
					}
				});
				paint();

				// 点一行展开当天构成；展开行紧跟在自己那天后面，翻页时跟着一起显隐
				const toggle = (row: HTMLTableRowElement) => {
					const more = row.nextElementSibling as HTMLTableRowElement | null;
					if (!more?.classList.contains('day-more')) return;
					const open = row.getAttribute('aria-expanded') === 'true';
					row.setAttribute('aria-expanded', String(!open));
					more.hidden = open;
				};
				for (const row of table.querySelectorAll<HTMLTableRowElement>('tr.day-row')) {
					row.addEventListener('click', () => toggle(row));
					row.addEventListener('keydown', (event) => {
						if (event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							toggle(row);
						}
					});
				}
			}
		</script>
	</body>
</html>
