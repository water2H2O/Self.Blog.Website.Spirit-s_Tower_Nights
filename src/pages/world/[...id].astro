---
import { getCollection, getEntry, render } from 'astro:content';
import DetailPage from '../../layouts/DetailPage.astro';

export async function getStaticPaths() {
	const lore = await getCollection('lore', ({ data }) => !data.draft);
	return lore.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, category, cover, themeColor, tags, characters, related, spoiler } =
	entry.data;

const meta: { label: string; value: string }[] = [];
meta.push({ label: '分类', value: category });
if (entry.data.updatedDate) {
	meta.push({
		label: '最后更新',
		value: entry.data.updatedDate.toLocaleDateString('zh-CN', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		}),
	});
}

const relatedCharacters = (
	await Promise.all(characters.map((ref) => getEntry(ref)))
).filter((item): item is NonNullable<typeof item> => Boolean(item));

const relatedLore = (await Promise.all(related.map((ref) => getEntry(ref)))).filter(
	(item): item is NonNullable<typeof item> => Boolean(item),
);
---

<DetailPage
	title={title}
	subtitle={category}
	summary={summary}
	themeColor={themeColor}
	cover={cover}
	tags={tags}
	meta={meta}
	canon={entry.data.canon}
	spoiler={spoiler}
	backHref="/world/"
	backLabel="世界观"
>
	<Content />
	{
		(relatedCharacters.length > 0 || relatedLore.length > 0) && (
			<div class="related">
				{relatedCharacters.length > 0 && (
					<>
						<h2>相关角色</h2>
						<ul>
							{relatedCharacters.map((item) => (
								<li>
									<a href={`/characters/${item.id}/`}>{item.data.name}</a>
								</li>
							))}
						</ul>
					</>
				)}
				{relatedLore.length > 0 && (
					<>
						<h2>相关条目</h2>
						<ul>
							{relatedLore.map((item) => (
								<li>
									<a href={`/world/${item.id}/`}>{item.data.title}</a>
								</li>
							))}
						</ul>
					</>
				)}
			</div>
		)
	}
</DetailPage>
