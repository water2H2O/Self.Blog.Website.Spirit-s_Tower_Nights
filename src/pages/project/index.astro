---
/**
 * 企划（附属目录）：收录我参与或自家的其他企划。
 * 主体世界观是「水塔夜谈」（/worldview/），这里是它旁边的东西。
 */
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_AUTHOR, SITE_TITLE } from '../../consts';

const eden = await getCollection('eden', ({ data }) => !data.draft);

/** 「水塔 OC 补完计划」的成品图数量（图池里归属为企划的那一批） */
const OC_POOL = path.join(process.cwd(), 'public', 'gallery');
const ocCount = fs
	.readdirSync(OC_POOL)
	.filter((file) => file.startsWith('企划-') && /\.webp$/i.test(file)).length;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="企划"
			description={`${SITE_AUTHOR} 参与的其他世界观企划：别人的世界观里，我写的那部分。`}
		/>
		<style>
			main {
				width: 860px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
				line-height: 1.9;
			}
			.card {
				display: block;
				margin: 2.2em 0;
				padding: 1.5em 1.7em;
				border-radius: 14px;
				text-decoration: none;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				transition: 0.2s ease;
			}
			.card:hover {
				border-color: rgba(175, 255, 255, 45%);
				box-shadow: var(--glow-shadow);
			}
			.card .kind {
				display: inline-block;
				margin-bottom: 0.7em;
				padding: 0.15em 0.65em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.08em;
				color: #ffd68a;
				background: rgba(255, 200, 90, 12%);
				border: 1px solid rgba(255, 200, 90, 28%);
			}
			.card h2 {
				margin: 0 0 0.4em;
				font-size: 1.5em;
				color: var(--glow);
			}
			.card p {
				margin: 0;
				font-size: 0.88em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			.card p.sub {
				margin-top: 0.6em;
				font-size: 0.84em;
			}
			.card .more {
				display: inline-block;
				margin-top: 1em;
				font-size: 0.82em;
				color: var(--accent);
			}
			/* 整张可点的外链卡片：靠一层铺满卡片的透明链接实现
			   （不能把卡片本身做成 <a>，否则里面的小链接会嵌套在链接里，是无效 HTML） */
			.card--link {
				position: relative;
			}
			.card-overlay {
				position: absolute;
				inset: 0;
				z-index: 1;
				border-radius: inherit;
			}
			/* 底部那排小链接浮在透明层之上，各自仍能单独点 */
			.card--link .links {
				position: relative;
				z-index: 2;
			}
			.card .links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 1.1em;
			}
			.card .links a {
				padding: 0.3em 0.85em;
				border-radius: 999px;
				font-size: 0.8em;
				text-decoration: none;
				color: var(--accent);
				background: rgba(175, 255, 255, 6%);
				border: 1px solid rgba(175, 255, 255, 22%);
				transition: 0.15s ease;
			}
			.card .links a:hover {
				color: #06121a;
				background: var(--glow);
				border-color: var(--glow);
			}
			.home {
				margin-top: 3em;
				padding-top: 1.4em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.86em;
				color: rgb(var(--gray));
			}
			.home a {
				color: var(--glow);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>企划</h1>
			<p class="lead">
				这里放的是<strong>我参与的其他企划</strong> —— 别人的项目里我负责或写的那部分。我自己的世界观在
				<a href="/worldview/">水塔夜谈</a>。
			</p>

			{/* 外链型卡片：整张可点（走铺满卡片的透明链接触发），底部小链接各自独立可点 */}
			<div class="card card--link">
				<a
					class="card-overlay"
					href="https://blophy.cn/"
					target="_blank"
					rel="noreferrer"
					aria-label="Blophy 方菱律动 官网"
				></a>
				<span class="kind">音游 · 非商业</span>
				<h2>Blophy 方菱律动</h2>
				<p>
					<strong>青柠工作室（Lime Studio）</strong>开发的非商业音乐游戏。我在其中担任<strong>主催</strong>与<strong
						>外交</strong
					>。
				</p>
				<span class="links">
					<a href="https://blophy.cn/" target="_blank" rel="noreferrer">官网</a>
					<a href="https://space.bilibili.com/445582135" target="_blank" rel="noreferrer">B站官号</a>
					<a href="https://www.taptap.cn/app/716901" target="_blank" rel="noreferrer">TapTap</a>
					<a href="https://testflight.apple.com/join/vVuz5Y6u" target="_blank" rel="noreferrer"
						>苹果 TestFlight</a
					>
				</span>
			</div>

			<a class="card" href="/project/oc/">
				<span class="kind">本家 · 立绘</span>
				<h2>水塔 OC 补完计划</h2>
				<p>
					<strong>水水，和他们的朋友和伙伴</strong>
					—— 一批已经画完的 OC 立绘。本家的孩子，加上朋友们的孩子，凑在一起就是这座塔里住着的人。
				</p>
				<span class="more">
					{ocCount} 张立绘 →
				</span>
			</a>

			<a class="card" href="/project/mod/">
				<span class="kind">本家 · 模组</span>
				<h2>水塔夜谈 · Minecraft 模组</h2>
				<p>
					把这个世界做成一个 Minecraft 模组 —— <strong>不做人物与剧情</strong>，只用物品、方块、生物群系与生态来讲它：衰变、瘴素、晶裔，三条系统依次压上来。
				</p>
				<span class="more">
					策划中 →
				</span>
			</a>

			<a class="card" href="/project/eden/">
				<span class="kind">群创 · 末日</span>
				<h2>伊甸园</h2>
				<p>
					一个群创末日世界观：菌毯与【质】、两次生物大爆发，以及建立在晶脉之上的共振网络。
					我是这个企划的<strong>参与者之一</strong>，写的是其中跟晶体有关的一小块 —— 那个世界里还有万千物种与势力。
					世界观与最终解释以该企划为准。
				</p>
				<span class="more">
					{eden.length} 篇稿件 →
				</span>
			</a>
		</main>
		<Footer />
	</body>
</html>
