---
/**
 * 企划（附属目录）：收录我参与的其他世界观。
 * 主体是「水塔夜谈」（/worldview/），这里放的是别人的企划里我写的那部分。
 */
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_AUTHOR, SITE_TITLE } from '../../consts';

const eden = await getCollection('eden', ({ data }) => !data.draft);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="企划"
			description={`${SITE_AUTHOR} 参与的其他世界观企划：别人的世界观里，我写的那部分。`}
		/>
		<style>
			main {
				width: 860px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
				line-height: 1.9;
			}
			.card {
				display: block;
				margin: 2.2em 0;
				padding: 1.5em 1.7em;
				border-radius: 14px;
				text-decoration: none;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				transition: 0.2s ease;
			}
			.card:hover {
				border-color: rgba(175, 255, 255, 45%);
				box-shadow: var(--glow-shadow);
			}
			.card .kind {
				display: inline-block;
				margin-bottom: 0.7em;
				padding: 0.15em 0.65em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.08em;
				color: #ffd68a;
				background: rgba(255, 200, 90, 12%);
				border: 1px solid rgba(255, 200, 90, 28%);
			}
			.card h2 {
				margin: 0 0 0.4em;
				font-size: 1.5em;
				color: var(--glow);
			}
			.card p {
				margin: 0;
				font-size: 0.88em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			.card p.sub {
				margin-top: 0.6em;
				font-size: 0.84em;
			}
			.card .more {
				display: inline-block;
				margin-top: 1em;
				font-size: 0.82em;
				color: var(--accent);
			}
			/* 外链型卡片：整张不可点，入口是一排小链接 */
			.card .links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 1.1em;
			}
			.card .links a {
				padding: 0.3em 0.85em;
				border-radius: 999px;
				font-size: 0.8em;
				text-decoration: none;
				color: var(--accent);
				background: rgba(175, 255, 255, 6%);
				border: 1px solid rgba(175, 255, 255, 22%);
				transition: 0.15s ease;
			}
			.card .links a:hover {
				color: #06121a;
				background: var(--glow);
				border-color: var(--glow);
			}
			.home {
				margin-top: 3em;
				padding-top: 1.4em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.86em;
				color: rgb(var(--gray));
			}
			.home a {
				color: var(--glow);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>企划</h1>
			<p class="lead">
				这里放的是<strong>我参与的其他企划</strong> —— 别人的项目里我负责或写的那部分。我自己的世界观在
				<a href="/worldview/">水塔夜谈</a>。
			</p>

			<div class="card">
				<span class="kind">音游 · 非商业</span>
				<h2>Blophy 方菱律动</h2>
				<p>
					<strong>青柠工作室（Lime Studio）</strong>开发的非商业音乐游戏。我在其中担任<strong>主催</strong>与<strong
						>外交</strong
					>。
				</p>
				<span class="links">
					<a href="https://blophy.cn/" target="_blank" rel="noreferrer">官网</a>
					<a href="https://space.bilibili.com/445582135" target="_blank" rel="noreferrer">B站官号</a>
					<a href="https://www.taptap.cn/app/716901" target="_blank" rel="noreferrer">TapTap</a>
					<a href="https://testflight.apple.com/join/vVuz5Y6u" target="_blank" rel="noreferrer"
						>苹果 TestFlight</a
					>
				</span>
			</div>

			<a class="card" href="/project/eden/">
				<span class="kind">群创 · 末日</span>
				<h2>伊甸园</h2>
				<p>
					一个以「晶体」为核心的末日世界观：超高辐射环境下的细胞劫持、晶体群系与晶体共振网络。
					这是<strong>群创企划</strong>，我写了其中关于晶体现象、矿物、物种与个体的几份稿件；基础设定与最终解释以该企划为准。
				</p>
				<span class="more">
					{eden.length} 篇稿件 →
				</span>
			</a>
		</main>
		<Footer />
	</body>
</html>
