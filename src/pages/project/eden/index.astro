---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../../../consts';

const WikiUrl = 'https://yidianyuanguichenm.fandom.com/zh/wiki/';

const entries = (await getCollection('eden', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);

/** 按类别分组，类别顺序固定 */
const CATEGORIES = ['现象', '矿物', '阵营', '物种', '个体', '其他'] as const;
const groups = CATEGORIES.map((category) => ({
	category,
	items: entries.filter((entry) => entry.data.category === category),
})).filter((group) => group.items.length > 0);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="伊甸园"
			description="群创末日世界观「伊甸园」中，water2H2O 撰写的那部分稿件：晶体现象、矿物档案、晶体群系、物种与个体。"
		/>
		<style>
			main {
				width: 860px;
			}
			.crumb {
				font-size: 0.8em;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.crumb:hover {
				color: var(--glow);
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
				line-height: 1.95;
			}
			.notice {
				margin: 1.4em 0 0;
				padding: 0.9em 1.1em;
				border-radius: 12px;
				font-size: 0.82em;
				line-height: 1.9;
				color: #ffd68a;
				background: rgba(255, 200, 90, 8%);
				border: 1px solid rgba(255, 200, 90, 28%);
			}
			.notice a {
				color: #ffe6ad;
			}
			.group {
				margin-top: 2.8em;
			}
			.group h2 {
				margin: 0 0 0.9em;
				font-size: 1.1em;
				letter-spacing: 0.1em;
				color: var(--accent);
			}
			.group ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.group li {
				padding: 0.85em 0;
				border-bottom: 1px dashed rgb(var(--gray-light));
			}
			.group li:last-child {
				border-bottom: none;
			}
			.group a {
				text-decoration: none;
				color: rgb(var(--black));
				font-size: 1.02em;
			}
			.group a:hover {
				color: var(--glow);
			}
			.summary {
				display: block;
				margin-top: 0.3em;
				font-size: 0.84em;
				line-height: 1.8;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="crumb" href="/project/">← 企划</a>
			<h1>伊甸园</h1>
			<p class="lead">
				一个以<strong>「晶体」</strong>为核心的<strong>群创末日世界观</strong>：超高辐射环境下的细胞劫持、
				晶体群系，以及建立在晶脉之上的共振网络。下面的 {entries.length} 篇是我为这个企划写的稿件。
			</p>
			<p class="notice">
				<strong>这是群创企划，不是我的个人世界观。</strong>
				世界观的最终设定以 <a href={WikiUrl} target="_blank" rel="noopener">该企划的 wiki</a> 与主创团队为准，
				这里只是我写的那部分存档；文中的术语、数值与命名都可能已被企划更新。
			</p>

			{
				groups.map((group) => (
					<section class="group">
						<h2>{group.category}</h2>
						<ul>
							{group.items.map((entry) => (
								<li>
									<a href={`/project/eden/${entry.id}/`}>{entry.data.title}</a>
									{entry.data.summary && <span class="summary">{entry.data.summary}</span>}
								</li>
							))}
						</ul>
					</section>
				))
			}

			<p class="crumb" style="display:block;margin-top:3em">
				世界观主体见 <a href="/worldview/">{SITE_TITLE}</a>；{SITE_AUTHOR} 的个人内容在站点其余部分。
			</p>
		</main>
		<Footer />
	</body>
</html>
