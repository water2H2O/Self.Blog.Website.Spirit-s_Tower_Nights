---
import { getCollection, render } from 'astro:content';
import DetailPage from '../../../layouts/DetailPage.astro';
import {
	LEVEL_BANDS,
	dangerColor,
	dangerNumber,
	levelColor,
	parseCreatureDoc,
	parseThreatLevels,
	type CreatureBlock,
} from '../../../lib/eden';

const WikiUrl = 'https://yidianyuanguichenm.fandom.com/zh/wiki/';

export async function getStaticPaths() {
	const entries = await getCollection('eden', ({ data }) => !data.draft);
	return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, category, summary, source, by, display, danger } = entry.data;
/** 本人稿件 or 企划公开资料 */
const isMine = by === 'water2H2O';

/** 等级阶梯排版：正文一字不动，只按结构重组 */
const threat = display === 'levels' ? parseThreatLevels(entry.body ?? '') : null;

/**
 * 生物档案排版：同样是重组。
 * 危险等级优先用 frontmatter 里的标注，没有就看正文里那一行。
 */
const creature = (() => {
	if (display !== 'creature') return null;
	const blocks = parseCreatureDoc(entry.body ?? '', title);
	const levelIndex = blocks.findIndex((block) => block.type === 'level');
	const fromBody =
		levelIndex >= 0 && blocks[levelIndex].type === 'level'
			? (blocks[levelIndex] as Extract<CreatureBlock, { type: 'level' }>).label
			: null;
	const rest = levelIndex >= 0 ? blocks.filter((_, index) => index !== levelIndex) : blocks;
	return { level: danger ?? fromBody, blocks: rest };
})();
const creatureDanger = creature?.level ? dangerNumber(creature.level) : null;

const all = (await getCollection('eden', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
const position = all.findIndex((item) => item.id === entry.id);
const prev = position > 0 ? all[position - 1] : null;
const next = position < all.length - 1 ? all[position + 1] : null;

const meta = [
	{ label: '类别', value: category },
	{
		label: isMine ? '撰稿' : '来源',
		value: isMine ? 'water2H2O' : '企划公开资料（非本站作者）',
	},
	{ label: 'wiki', value: 'yidianyuanguichenm.fandom.com', href: WikiUrl },
	...(source ? [{ label: '原稿', value: source }] : []),
];

/** 把等级色写成 CSS 变量 */
const colorVars = (n: number) => {
	const { h, s, l } = levelColor(n);
	return `--h:${h}; --s:${s}%; --l:${l}%`;
};
const dangerVars = (n: number | null) => {
	const { h, s, l } = dangerColor(n);
	return `--h:${h}; --s:${s}%; --l:${l}%`;
};
---

<DetailPage
	title={title}
	subtitle={`伊甸园 · ${category}`}
	summary={summary ?? `${title}（伊甸园 · ${category}）`}
	themeColor="#AFFFFF"
	meta={meta}
	backHref="/project/eden/"
	backLabel="伊甸园"
>
	{
		creature ? (
			<div class="creature">
				{creature.level && (
					<div class="badge" style={dangerVars(creatureDanger)}>
						<span class="ring">{creature.level}</span>
						<span class="cap">危险等级</span>
					</div>
				)}

				{creature.blocks.map((block) => {
					if (block.type === 'epigraph') return <p class="epigraph">{block.text}</p>;
					if (block.type === 'heading') return <h3 class="sec">{block.text}</h3>;
					if (block.type === 'divider') return <hr class="rule" />;
					if (block.type === 'field')
						return (
							<div class="field">
								<span class="label">{block.label}</span>
								<span class="value">{block.value}</span>
							</div>
						);
					return (
						<p class="para">
							{block.lines.map((line, index) => (
								<>
									{index > 0 && <br />}
									{line}
								</>
							))}
						</p>
					);
				})}
			</div>
		) : threat ? (
			<div class="threat">
				{threat.preamble.length > 0 && (
					<section class="preamble">
						{threat.preamble.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</section>
				)}

				<div class="bands">
					{LEVEL_BANDS.map((band) => (
						<span class="band" style={colorVars(band.n)}>
							<b>{band.range}</b> 阶 · {band.label}
						</span>
					))}
				</div>

				<ol class="ladder">
					{threat.levels.map((level) => (
						<li style={colorVars(level.n)}>
							<span class="num">{level.n}</span>
							<div class="body">
								<h2>危险程度 {level.n}</h2>
								<p>{level.text}</p>
								{level.quote && <blockquote>{level.quote}</blockquote>}
							</div>
						</li>
					))}
				</ol>

				{threat.notes.length > 0 && (
					<section class="notes">
						<h2>注</h2>
						{threat.notes.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</section>
				)}
			</div>
		) : (
			<Content />
		)
	}

	<p class="note">
		{
			isMine ? (
				<>
					本文是群创世界观「伊甸园」的稿件，世界观与最终设定归该企划所有；以{' '}
					<a href={WikiUrl} target="_blank" rel="noopener">
						企划 wiki
					</a>{' '}
					为准。
				</>
			) : (
				<>
					<strong>本文是企划公开的基础设定，不是本站作者写的。</strong>
					转载在这里只是为了让读者看得懂其余稿件；版权与最终解释归该企划所有，以{' '}
					<a href={WikiUrl} target="_blank" rel="noopener">
						企划 wiki
					</a>{' '}
					为准。
				</>
			)
		}
	</p>

	<nav class="pager">
		{
			prev ? (
				<a href={`/project/eden/${prev.id}/`}>
					<span class="dir">← 上一篇</span>
					<span class="name">{prev.data.title}</span>
				</a>
			) : (
				<span />
			)
		}
		{
			next ? (
				<a class="next" href={`/project/eden/${next.id}/`}>
					<span class="dir">下一篇 →</span>
					<span class="name">{next.data.title}</span>
				</a>
			) : (
				<span />
			)
		}
	</nav>

	<style>
		/* ---------- 生物档案 ---------- */
		.creature .badge {
			display: inline-flex;
			align-items: center;
			gap: 0.9em;
			margin: 0 0 1.8em;
			padding: 0.7em 1.2em 0.7em 0.8em;
			border-radius: 999px;
			background: hsl(var(--h) var(--s) 60% / 10%);
			border: 1px solid hsl(var(--h) var(--s) 60% / 38%);
		}
		.creature .badge .ring {
			display: flex;
			align-items: center;
			justify-content: center;
			min-width: 3.2em;
			height: 3.2em;
			padding: 0 0.6em;
			border-radius: 999px;
			font-size: 1.25em;
			font-variant-numeric: tabular-nums;
			color: hsl(var(--h) var(--s) var(--l));
			background: hsl(var(--h) var(--s) 60% / 14%);
			border: 1px solid hsl(var(--h) var(--s) 60% / 45%);
			box-shadow: 0 0 24px hsl(var(--h) var(--s) 60% / 18%);
		}
		.creature .badge .cap {
			font-size: 0.78em;
			letter-spacing: 0.2em;
			color: rgb(var(--gray));
		}

		/* 题记 */
		.creature .epigraph {
			margin: 0 0 2em;
			padding: 0 0 0 1.1em;
			border-left: 2px solid rgba(175, 255, 255, 30%);
			font-size: 0.92em;
			line-height: 1.95;
			color: var(--accent);
		}

		/* 小节：左侧一小段竖条 */
		.creature .sec {
			margin: 2.4em 0 0.9em;
			padding-left: 0.7em;
			border-left: 3px solid rgba(175, 255, 255, 45%);
			font-size: 1em;
			font-weight: 400;
			letter-spacing: 0.14em;
			color: var(--glow);
		}

		/* 字段行：标签固定宽度，值跟在后面 —— 原来这些行会被并成一段 */
		.creature .field {
			display: grid;
			grid-template-columns: 6.2em 1fr;
			gap: 0.9em;
			padding: 0.42em 0;
			line-height: 1.95;
		}
		.creature .field .label {
			color: var(--accent);
			font-size: 0.9em;
			letter-spacing: 0.06em;
		}
		.creature .field .value {
			color: rgb(var(--gray-dark));
		}

		/* 正文段落：行内换行照原稿保留 */
		.creature .para {
			margin: 0 0 0.9em;
			line-height: 2;
			color: rgb(var(--gray-dark));
		}
		.creature .rule {
			width: 40%;
			margin: 2.4em auto;
			border: none;
			border-top: 1px solid rgb(var(--gray-light));
		}

		/* ---------- 危险等级阶梯 ---------- */
		.threat .preamble p {
			margin: 0 0 1.1em;
			font-size: 0.92em;
			line-height: 2;
			color: rgb(var(--gray));
		}
		.threat .bands {
			display: flex;
			flex-wrap: wrap;
			gap: 1.6em;
			margin: 1.8em 0 2.4em;
			padding: 0.95em 1.2em;
			border-radius: 12px;
			background: var(--surface);
			border: 1px solid rgb(var(--gray-light));
		}
		.threat .band {
			font-size: 0.8em;
			letter-spacing: 0.04em;
			color: hsl(var(--h) var(--s) var(--l));
		}
		.threat .band b {
			font-weight: 400;
			font-variant-numeric: tabular-nums;
		}
		.threat .ladder {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.threat .ladder > li {
			display: grid;
			grid-template-columns: 3.6em 1fr;
			gap: 1.3em;
			padding: 1.6em 0;
			border-top: 1px solid rgb(var(--gray-light));
		}
		.threat .ladder > li:last-child {
			border-bottom: 1px solid rgb(var(--gray-light));
		}
		.threat .num {
			display: flex;
			align-items: center;
			justify-content: center;
			align-self: start;
			width: 3.6em;
			height: 3.6em;
			border-radius: 50%;
			font-size: 1.35em;
			font-variant-numeric: tabular-nums;
			color: hsl(var(--h) var(--s) var(--l));
			background: hsl(var(--h) var(--s) 60% / 12%);
			border: 1px solid hsl(var(--h) var(--s) 60% / 42%);
			box-shadow: 0 0 26px hsl(var(--h) var(--s) 60% / 18%);
		}
		.threat .body h2 {
			margin: 0 0 0.6em;
			font-size: 0.8em;
			font-weight: 400;
			letter-spacing: 0.22em;
			color: hsl(var(--h) var(--s) var(--l));
		}
		.threat .body p {
			margin: 0;
			line-height: 2;
			color: rgb(var(--gray-dark));
		}
		.threat .body blockquote {
			margin: 1em 0 0;
			padding: 0 0 0 1.1em;
			border-left: 2px solid hsl(var(--h) var(--s) 60% / 40%);
			font-size: 0.9em;
			line-height: 1.95;
			color: rgb(var(--gray));
		}
		.threat .notes {
			margin-top: 2.6em;
			padding: 1.3em 1.5em;
			border-radius: 12px;
			background: var(--surface);
			border: 1px solid rgb(var(--gray-light));
		}
		.threat .notes h2 {
			margin: 0 0 0.8em;
			font-size: 0.8em;
			letter-spacing: 0.22em;
			color: var(--accent);
		}
		.threat .notes p {
			margin: 0 0 1em;
			font-size: 0.88em;
			line-height: 1.95;
			color: rgb(var(--gray));
		}
		.threat .notes p:last-child {
			margin-bottom: 0;
		}

		/* ---------- 通用 ---------- */
		.note {
			margin: 3em 0 0;
			padding-top: 1.4em;
			border-top: 1px solid rgb(var(--gray-light));
			font-size: 0.8em;
			line-height: 1.9;
			color: rgb(var(--gray));
		}
		.note a {
			color: var(--glow);
		}
		.note strong {
			color: #ffd68a;
		}
		.pager {
			display: flex;
			justify-content: space-between;
			gap: 1em;
			margin-top: 2em;
		}
		.pager a {
			flex: 1 1 0;
			padding: 0.9em 1.1em;
			border-radius: 12px;
			background: var(--surface);
			border: 1px solid rgb(var(--gray-light));
			text-decoration: none;
			color: rgb(var(--gray-dark));
			font-size: 0.86em;
			transition: 0.2s ease;
		}
		.pager a:hover {
			border-color: rgba(175, 255, 255, 45%);
			box-shadow: var(--glow-shadow);
		}
		.pager a.next {
			text-align: right;
		}
		.pager .dir {
			display: block;
			font-size: 0.8em;
			letter-spacing: 0.1em;
			color: rgb(var(--gray));
		}
		.pager .name {
			color: var(--glow);
		}
		@media (max-width: 720px) {
			.threat .ladder > li {
				grid-template-columns: 2.9em 1fr;
				gap: 0.9em;
			}
			.threat .num {
				width: 2.9em;
				height: 2.9em;
				font-size: 1.1em;
			}
			.creature .field {
				grid-template-columns: 1fr;
				gap: 0;
			}
			.pager {
				flex-direction: column;
			}
		}
	</style>
</DetailPage>
