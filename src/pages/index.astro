				{/* 贡献热力图：自己渲染，不引第三方图床 */}
				<div class="heat">
					<div class="heat-scroll">
						<div class="heat-months" style={`--weeks:${weeks.length}`}>
							{monthLabels.map((label) => (
								<span style={`grid-column: ${label.column} / span 4`}>{label.text}</span>
							))}
						</div>
						<div class="heat-grid" style={`--weeks:${weeks.length}`}>
							{weeks.map((week) =>
								week.split('').map((level) => <i class={`lv${level}`} />),
							)}
						</div>
					</div>
					<p class="heat-foot">
						<span>过去一年 {github.contributions.total} 次贡献</span>
						<span class="legend">
							少
							<i class="lv0" />
							<i class="lv1" />
							<i class="lv2" />
							<i class="lv3" />
							<i class="lv4" />
							多
						</span>
						{/* 数据是构建时从 GitHub 抓来缓存的，由 GitHub Actions 每天自动刷一次 */}
						<span class="heat-when" title="由 GitHub Actions 每天自动刷新">
							数据截至 {github.contributions.to}
						</span>
					</p>
				</div>

				<ul class="repos">
