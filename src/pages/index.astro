---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '../assets/oc/logo.webp';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { PROJECT_SUBTITLE, PROJECT_TITLE, SITE_AUTHOR, SITE_DESCRIPTION } from '../consts';

const isPublic = (entry: { data: { draft?: boolean } }) => !entry.data.draft;
const posts = (await getCollection('blog')).filter(isPublic);
const characters = (await getCollection('characters')).filter(isPublic);
const stories = (await getCollection('stories', ({ data }) => data.status === 'published'));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_AUTHOR} · 个人站点`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1000px;
			}
			.intro h1 {
				margin: 0 0 0.1em;
				font-size: 2.4em;
			}
			.intro .sub {
				margin: 0 0 1.2em;
				font-size: 0.8em;
				letter-spacing: 0.2em;
				color: rgb(var(--gray));
				text-transform: uppercase;
			}
			.intro p {
				font-size: 1.02em;
			}
			.intro .placeholder {
				color: rgb(var(--gray));
				font-size: 0.82em;
				font-style: italic;
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1.3rem;
				margin-top: 2.5em;
			}
			.card {
				display: flex;
				flex-direction: column;
				padding: 1.4em 1.5em 1.6em;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				text-decoration: none;
				color: inherit;
				transition: 0.2s ease;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: var(--glow-shadow);
				border-color: rgba(175, 255, 255, 45%);
			}
			.card h2 {
				margin: 0;
				font-size: 1.35em;
				color: rgb(var(--black));
			}
			.card .badge {
				align-self: flex-start;
				margin: 0 0 0.8em;
				padding: 0.2em 0.6em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.06em;
				color: var(--glow);
				background: rgba(175, 255, 255, 10%);
				border: 1px solid rgba(175, 255, 255, 28%);
			}
			.card .badge.soon {
				color: rgb(var(--gray));
				background: rgba(255, 255, 255, 4%);
				border-color: rgb(var(--gray-light));
			}
			.card p {
				margin: 0.6em 0 0;
				font-size: 0.88em;
				line-height: 1.7;
				color: rgb(var(--gray));
			}
			.card .stats {
				margin-top: auto;
				padding-top: 1em;
				font-size: 0.78em;
				color: rgb(var(--gray));
			}
			/* 主推卡片：世界观企划 */
			.card.featured {
				grid-column: span 2;
				flex-direction: row;
				align-items: center;
				gap: 1.6em;
				background:
					radial-gradient(600px 240px at 0% 0%, rgba(175, 255, 255, 8%), transparent 70%),
					var(--surface);
			}
			.card.featured .thumb {
				width: 160px;
				flex: none;
			}
			.card.featured .thumb :global(img) {
				width: 100%;
				height: auto;
				border-radius: 0;
			}
			@media (max-width: 760px) {
				.card.featured {
					grid-column: span 1;
					flex-direction: column;
					align-items: flex-start;
				}
				.card.featured .thumb {
					width: 120px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_AUTHOR}</h1>
				<p class="sub">Personal Site</p>
				<p class="placeholder">
					（这段是占位。把我换成你的自我介绍 —— 一两句话说明你是谁、这里会放什么就够。）
				</p>
			</section>

			<div class="cards">
				<a class="card featured" href="/worldview/">
					<div class="thumb">
						<Image src={logo} alt={PROJECT_TITLE} width={320} />
					</div>
					<div>
						<span class="badge">原创世界观企划</span>
						<h2>{PROJECT_TITLE}</h2>
						<p>
							{PROJECT_SUBTITLE} —— 设定、种族、角色、故事、画作与音乐。
							灾变之后的世界里，一个水精灵在废弃水塔中熬着她的药剂。
						</p>
						<p class="stats">
							{characters.length} 位角色 · {stories.length} 话正文 · 画作与曲目若干
						</p>
					</div>
				</a>

				<a class="card" href="/blog/">
					<span class="badge">记录</span>
					<h2>随笔</h2>
					<p>制作花絮、灵感笔记，以及一些不成体系的日常记录。</p>
					<p class="stats">{posts.length} 篇</p>
				</a>

				<div class="card">
					<span class="badge soon">筹备中</span>
					<h2>个人内容</h2>
					<p>
						这里预留给你自己的东西 —— 想放什么（日记、读书笔记、作品集、乱七八糟的收藏）告诉我，我来搭。
					</p>
				</div>

				<a class="card" href="/about/">
					<span class="badge">关于</span>
					<h2>关于</h2>
					<p>关于我、联系方式，以及作品的使用与授权说明。</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
