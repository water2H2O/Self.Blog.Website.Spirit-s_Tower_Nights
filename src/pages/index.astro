---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '../assets/oc/logo.webp';
import githubData from '../data/github.json';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	BILIBILI_NAME,
	BILIBILI_URL,
	EMAIL,
	GITHUB_NAME,
	GITHUB_URL,
	PROJECT_SUBTITLE,
	PROJECT_TITLE,
	QQ_GROUP,
	QQ_GROUP_URL,
	SITE_AUTHOR,
	SITE_DESCRIPTION,
} from '../consts';

const isPublic = (entry: { data: { draft?: boolean } }) => !entry.data.draft;
const posts = (await getCollection('blog')).filter(isPublic);
const characters = (await getCollection('characters')).filter(isPublic);
const stories = (await getCollection('stories', ({ data }) => data.status === 'published'));
const eden = (await getCollection('eden', ({ data }) => !data.draft));

/**
 * GitHub 动态：数据由 tools/fetch-github.mjs 抓好缓存在 src/data/github.json，
 * 构建本身不联网 —— 想更新就跑一次那个脚本。
 */
const github = githubData as {
	user: { login: string; url: string; publicRepos: number; followers: number; createdAt: string };
	repos: {
		name: string;
		description: string;
		language: string;
		url: string;
		pushedAt: string;
		sizeKb: number;
		empty: boolean;
	}[];
};
const repos = github.repos.filter((repo) => !repo.empty).slice(0, 4);
const sinceYear = new Date(github.user.createdAt).getFullYear();
const daysAgo = (iso: string) =>
	Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 86400000));
const ago = (iso: string) => {
	const days = daysAgo(iso);
	if (days === 0) return '今天';
	if (days === 1) return '昨天';
	if (days < 30) return `${days} 天前`;
	return `${Math.round(days / 30)} 个月前`;
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_AUTHOR} · 个人站点`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1000px;
			}
			/* 开头这一段：不再是一行干巴巴的自我介绍 */
			.intro h1 {
				margin: 0 0 0.15em;
				font-size: 2.6em;
				color: var(--glow);
				text-shadow: 0 0 24px rgba(175, 255, 255, 22%);
			}
			.intro .aka {
				margin: 0 0 1.4em;
				font-size: 0.84em;
				letter-spacing: 0.1em;
				color: rgb(var(--gray));
			}
			.intro .bio {
				max-width: 40em;
				margin: 0 0 0.9em;
				font-size: 1.02em;
				line-height: 2;
			}
			.intro .langs {
				max-width: 40em;
				margin: 0 0 1.5em;
				font-size: 0.94em;
				line-height: 2;
				color: rgb(var(--gray));
			}
			.intro .langs b {
				font-weight: 400;
				color: var(--accent);
			}
			.intro .note {
				max-width: 40em;
				margin: 0 0 1.6em;
				padding: 0.7em 1em;
				border-radius: 10px;
				font-size: 0.84em;
				line-height: 1.9;
				color: rgb(var(--gray));
				background: var(--surface);
				border-left: 2px solid rgba(175, 255, 255, 30%);
			}
			/* 出没的地方 */
			.platforms {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.platforms a {
				display: inline-block;
				padding: 0.4em 1em;
				border-radius: 999px;
				font-size: 0.82em;
				text-decoration: none;
				color: var(--accent);
				background: rgba(175, 255, 255, 6%);
				border: 1px solid rgba(175, 255, 255, 22%);
				transition: 0.15s ease;
			}
			.platforms a:hover {
				color: #06121a;
				background: var(--glow);
				border-color: var(--glow);
			}
			.platforms .plain {
				padding: 0.4em 1em;
				border-radius: 999px;
				font-size: 0.82em;
				color: rgb(var(--gray));
				border: 1px dashed rgb(var(--gray-light));
			}
			.section-title {
				margin: 3em 0 0;
				font-size: 0.84em;
				font-weight: 400;
				letter-spacing: 0.22em;
				color: rgb(var(--gray));
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1.3rem;
				margin-top: 1.2em;
			}
			.card {
				display: flex;
				flex-direction: column;
				padding: 1.4em 1.5em 1.6em;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				text-decoration: none;
				color: inherit;
				transition: 0.2s ease;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: var(--glow-shadow);
				border-color: rgba(175, 255, 255, 45%);
			}
			.card h2 {
				margin: 0;
				font-size: 1.35em;
				color: rgb(var(--black));
			}
			.card .badge {
				align-self: flex-start;
				margin-bottom: 0.7em;
				padding: 0.15em 0.65em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.08em;
				color: var(--accent);
				background: rgba(175, 255, 255, 10%);
				border: 1px solid rgba(175, 255, 255, 25%);
			}
			.card p {
				margin: 0.6em 0 0;
				font-size: 0.9em;
				line-height: 1.85;
				color: rgb(var(--gray));
			}
			.card .stats {
				margin-top: auto;
				padding-top: 0.9em;
				font-size: 0.8em;
				color: rgb(var(--gray));
				opacity: 0.85;
			}
			.card.featured {
				flex-direction: row;
				align-items: center;
				gap: 1.4em;
				grid-column: span 2;
				border-color: rgba(175, 255, 255, 28%);
			}
			.card.featured .thumb {
				flex: none;
				width: 160px;
			}
			.card.featured .thumb :global(img) {
				width: 100%;
				height: auto;
				border-radius: 10px;
			}
			/* GitHub 动态 */
			.github {
				margin-top: 1.2em;
				padding: 1.4em 1.6em 1.2em;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
			}
			.gh-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.8em;
				padding-bottom: 0.9em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.gh-login {
				font-size: 1.1em;
				color: var(--glow);
			}
			.gh-stats {
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			.gh-link {
				margin-left: auto;
				font-size: 0.82em;
				text-decoration: none;
				color: var(--accent);
			}
			.gh-link:hover {
				color: var(--glow);
			}
			.repos {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.repos li + li {
				border-top: 1px dashed rgb(var(--gray-light));
			}
			.repos a {
				display: block;
				padding: 0.85em 0;
				text-decoration: none;
				color: inherit;
			}
			.repos a:hover .repo-name {
				color: var(--glow);
			}
			.repo-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.7em;
			}
			.repo-name {
				font-size: 0.92em;
				color: rgb(var(--black));
				transition: color 0.15s ease;
				word-break: break-all;
			}
			.lang {
				padding: 0.05em 0.5em;
				border-radius: 999px;
				font-size: 0.7em;
				color: var(--accent);
				background: rgba(175, 255, 255, 10%);
				border: 1px solid rgba(175, 255, 255, 22%);
			}
			.when {
				margin-left: auto;
				font-size: 0.74em;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.repo-desc {
				display: block;
				margin-top: 0.35em;
				font-size: 0.84em;
				line-height: 1.8;
				color: rgb(var(--gray));
			}
			.gh-note {
				margin: 0.9em 0 0;
				padding-top: 0.9em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.card.featured {
					flex-direction: column;
					grid-column: span 1;
					align-items: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>水水</h1>
				<p class="aka">淼渺_Water2H2O · 一只狐狸（？）</p>

				<p class="bio">
					在香港读计算机的苦逼大学生。啥都喜欢弄一点 —— 写故事、画 OC、给它们做曲子，
					顺便运营一个音游企划。养 OC 是为了开心。
				</p>
				<p class="langs">
					会说 <b>普通话</b>、<b>English</b>，还有 <b>Python</b>、<b>Java</b>、<b>C</b>、<b>C++</b>……
				</p>
				<p class="note">
					留学生 + 音乐企划运营的双重 buff，常年低精力；漏回消息和评论真的抱歉，不是不尊重。
					想睡的时候我会自称「囦囦」（yuán）—— 总之，想睡，别叫我。
				</p>

				<ul class="platforms">
					<li><a href={QQ_GROUP_URL} target="_blank" rel="noreferrer">QQ 群 {QQ_GROUP}</a></li>
					<li><a href={BILIBILI_URL} target="_blank" rel="noreferrer">B 站</a></li>
					<li><a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a></li>
					<li><a href={`mailto:${EMAIL}`}>邮箱</a></li>
					<li><span class="plain">小红书</span></li>
					<li><span class="plain">X</span></li>
				</ul>
			</section>

			<h2 class="section-title">这座塔里有什么</h2>
			<div class="cards">
				<a class="card featured" href="/worldview/">
					<div class="thumb">
						<Image src={logo} alt={PROJECT_TITLE} width={320} />
					</div>
					<div>
						<span class="badge">原创世界观企划</span>
						<h2>{PROJECT_TITLE}</h2>
						<p>
							{PROJECT_SUBTITLE} —— 设定、种族、角色、故事、画作与音乐。
							灾变之后的世界里，一个水精灵在废弃水塔中熬着她的药剂。
						</p>
						<p class="stats">
							{characters.length} 位角色 · {stories.length} 话正文 · 画作与曲目若干
						</p>
					</div>
				</a>

				<a class="card" href="/project/">
					<span class="badge">企划</span>
					<h2>参与的项目</h2>
					<p>音游《Blophy 方菱律动》，群创世界观「伊甸园」，还有一批画完的 OC 立绘。</p>
					<p class="stats">{eden.length + 2} 个企划</p>
				</a>

				<a class="card" href="/blog/">
					<span class="badge">记录</span>
					<h2>随笔</h2>
					<p>制作花絮、灵感笔记，以及这个站自己的一些记录。</p>
					<p class="stats">{posts.length} 篇</p>
				</a>

				<a class="card" href="/about/">
					<span class="badge">关于</span>
					<h2>关于</h2>
					<p>关于我、联系方式，以及作品的使用与授权说明。</p>
					<p class="stats">{BILIBILI_NAME} · {GITHUB_NAME}</p>
				</a>
			</div>
			<h2 class="section-title">最近在写什么</h2>
			<div class="github">
				<div class="gh-head">
					<span class="gh-login">{github.user.login}</span>
					<span class="gh-stats">
						{github.user.publicRepos} 个公开仓库 · 关注者 {github.user.followers} · {sinceYear} 年注册
					</span>
					<a class="gh-link" href={github.user.url} target="_blank" rel="noreferrer">去 GitHub →</a>
				</div>
				<ul class="repos">
					{repos.map((repo) => (
						<li>
							<a href={repo.url} target="_blank" rel="noreferrer">
								<span class="repo-head">
									<span class="repo-name">{repo.name}</span>
									{repo.language && <span class="lang">{repo.language}</span>}
									<span class="when">{ago(repo.pushedAt)}</span>
								</span>
								{repo.description && <span class="repo-desc">{repo.description}</span>}
							</a>
						</li>
					))}
				</ul>
				<p class="gh-note">
					这个站本身也在上面。绿格子最近才开始长 —— 见谅（
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
