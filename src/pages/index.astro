---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '../assets/oc/logo.webp';
import canteenTrio from '../assets/oc/canteen-trio.webp';
import githubData from '../data/github.json';
import tokenUsage from '../data/token-usage.json';
import { summarizeTokens, fmtYi, perMillion } from '../data/token-stats.mjs';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	BILIBILI_NAME,
	BILIBILI_URL,
	EMAIL,
	GITHUB_NAME,
	GITHUB_URL,
	PROJECT_SUBTITLE,
	PROJECT_TITLE,
	QQ_GROUP,
	QQ_GROUP_URL,
	QQ_GROUP_VISIBLE,
	SITE_AUTHOR,
	SITE_DESCRIPTION,
	X_URL,
} from '../consts';

const isPublic = (entry: { data: { draft?: boolean } }) => !entry.data.draft;
const posts = (await getCollection('blog')).filter(isPublic);
const characters = (await getCollection('characters')).filter(isPublic);
const stories = (await getCollection('stories', ({ data }) => data.status === 'published'));
const eden = (await getCollection('eden', ({ data }) => !data.draft));

/**
 * 生日贺图：只在每年 10 月 20 日（北京时间）在首页露一天。
 * 图本身早就在图池里了，横幅只是「今天多摆一下」——
 * 日期判断写在下面那段 inline 脚本里，所以不用等那天重新构建。
 */
const BIRTHDAY_ART = `/gallery/${encodeURIComponent('淼渺__贺图-生日快乐.webp')}`;

/**
 * GitHub 动态：数据由 tools/fetch-github.mjs 抓好缓存在 src/data/github.json，
 * 构建本身不联网 —— 想更新就跑一次那个脚本。
 */
const github = githubData as {
	user: { login: string; url: string; publicRepos: number; followers: number; createdAt: string };
	repos: {
		name: string;
		description: string;
		language: string;
		url: string;
		pushedAt: string;
		sizeKb: number;
		empty: boolean;
	}[];
	contributions: { from: string; to: string; total: number; weeks: string[] };
};
const repos = github.repos.filter((repo) => !repo.empty).slice(0, 4);
const sinceYear = new Date(github.user.createdAt).getFullYear();
const daysAgo = (iso: string) =>
	Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 86400000));
const ago = (iso: string) => {
	const days = daysAgo(iso);
	if (days === 0) return '今天';
	if (days === 1) return '昨天';
	if (days < 30) return `${days} 天前`;
	return `${Math.round(days / 30)} 个月前`;
};

/** 贡献热力图：每周一列、列内周日→周六 */
const weeks = github.contributions.weeks;
const heatStart = new Date(`${github.contributions.from}T00:00:00Z`);
const MONTHS = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
const monthLabels: { column: number; text: string }[] = [];
let lastMonth = -1;
weeks.forEach((_, index) => {
	const month = new Date(heatStart.getTime() + index * 7 * 86400000).getUTCMonth();
	if (month !== lastMonth) {
		monthLabels.push({ column: index + 1, text: MONTHS[month] });
		lastMonth = month;
	}
});

/**
 * ★ token 用量「食堂三席」。
 *
 * 数据来自 `src/data/token-usage.json`，由 `tools/collect-local-usage.mjs` 读本机 DSH 会话日志统计
 * （另一条路是 `tools/fetch-token-usage.mjs`，用登录态导出平台用量）。
 * 静态站构建时不联网，所以走「本地算 → 提交 JSON → 构建时读」，和上面 github.json 同一套路。
 * 图是画好的三联画，这里只把数字对到每个人脚下；**数据为空时整段不渲染**。
 */
type TokenDay = {
	date: string;
	tokens: number;
	input?: number;
	output?: number;
	cacheRead?: number;
	requests: number;
	cost: number;
};
const tokenData = tokenUsage as {
	fetchedAt?: string;
	source?: string;
	note?: string;
	totals?: { tokens?: number; requests?: number; cost?: number; cacheRead?: number };
	models?: { model: string; tokens: number }[];
	daily?: TokenDay[];
};
const tokenDaily: TokenDay[] = (tokenData.daily ?? []).filter((day) => day.tokens > 0);

/** 千分位 + 中文单位，图表旁边的数字用 */
const fmtTokens = (n: number) =>
	n >= 1e8 ? `${(n / 1e8).toFixed(2)} 亿` : n >= 1e4 ? `${(n / 1e4).toFixed(1)} 万` : String(n);

/** 所有完整日指标均以导出快照的北京时间为准，避免凌晨误判。 */
const tokenStats = summarizeTokens(tokenData);

/**
 * 按模型拆开的用量。`dimension === 'model'` 时才有内容，
 * 「按 api_key 拆」那种不认 —— 那几个 key 往往是同一个客户端改名。
 */
type TokenSeries = { label: string; tokens: number; share?: number; cost?: number };
const tokenSeries: TokenSeries[] = (tokenData.series ?? []).filter((s) => s.tokens > 0);

/**
 * ★ 食堂三席：一张图讲完三个人在干什么。
 *
 * 图是作者画的三联画（蓝发抱着碗 / 白发趴在桌上 / 橙发举着账单），
 * 台词已经画在画里了，所以座位上只补数据：谁吃掉了多少、来了几天、要付多少钱。
 * 座位顺序跟着图走（DeepSeek、GPT、Claude），不按用量排 —— 画换不了，位置就不能换。
 */
const SEAT_ORDER = ['deepseek', 'gpt', 'claude'];
const seatRank = (label: string) => {
	const index = SEAT_ORDER.findIndex((key) => label.toLowerCase().includes(key));
	return index === -1 ? SEAT_ORDER.length : index;
};
/** 三联画只有三格，座位最多三个：先按家族（DeepSeek / GPT / Claude）排，再按家族内用量取最大的那个 */
const seatsAll = tokenSeries
	.map((series) => ({
		...series,
		unitPrice: perMillion(series.tokens, series.cost),
		shortName: series.label.split('·').pop()?.trim() ?? series.label,
		days: tokenDaily.filter((day) => (day.parts?.[series.label] ?? 0) > 0).length,
	}))
	.sort((a, b) => seatRank(a.label) - seatRank(b.label) || b.tokens - a.tokens);
const canteenSeats = seatsAll.slice(0, 3);
/** 坐不下的那些（glm、同一个家族的另一个 Claude 之类）：合并成一句说明，不塞进座位 */
const extraAll = seatsAll.slice(3);
/** 占比小到 0.05% 以下的就不点名了，否则「0%」写在注释里很怪 */
const extraSeats = extraAll.filter((seat) => (seat.share ?? 0) >= 0.05);
const tinyCount = extraAll.length - extraSeats.length;
const claudeSeat = canteenSeats.find((seat) => /claude/i.test(seat.label)) ?? null;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_AUTHOR} · 个人站点`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1000px;
			}
			/* 开头这一段：不再是一行干巴巴的自我介绍 */
			/*
			 * 首页的视觉骨架：
			 *   左边是文字（.intro-text），右边是「夜色里的水塔」剪影（.hero-art，纯 SVG）。
			 *   文字压在上层，剪影与两团色差光在下面当背景 —— 这是整页唯一的「剪影 + 色差」。
			 */
			.intro {
				position: relative;
				isolation: isolate;
				padding-top: 0.4em;
			}
			/* 两团柔光：青压在剪影那一侧，紫压在标题后面。
			   只在垂直方向外扩 —— 左右外扩会把窄屏顶出横向滚动条 */
			.intro::before {
				content: '';
				position: absolute;
				inset: -8% 0 4% 0;
				z-index: -1;
				pointer-events: none;
				background:
					radial-gradient(42% 56% at 76% 32%, rgba(127, 233, 240, 18%), transparent 70%),
					radial-gradient(40% 52% at 8% 2%, rgba(124, 108, 240, 16%), transparent 72%);
			}
			/* 地平线：一条从左亮到右隐的细线，把 hero 和下面的卡片分开 */
			.intro::after {
				content: '';
				position: absolute;
				left: 0;
				right: 0;
				bottom: -1.4em;
				height: 1px;
				background: linear-gradient(
					90deg,
					rgba(175, 255, 255, 32%),
					rgba(175, 255, 255, 6%) 62%,
					transparent
				);
			}
			.intro-text {
				position: relative;
				z-index: 1;
				max-width: 42em;
			}
			/* ---------- 免漏洞声明（玩笑） ---------- */
			.notice {
				position: relative;
				margin: 2.4em 0 2.2em;
				padding: 1.5em 1.6em 1.2em;
				border-radius: 14px;
				border: 1px dashed rgba(175, 255, 255, 30%);
				background:
					repeating-linear-gradient(
						-45deg,
						rgba(175, 255, 255, 3%) 0 10px,
						transparent 10px 20px
					),
					var(--surface);
			}
			.notice-stamp {
				position: absolute;
				top: 14px;
				right: 16px;
				padding: 0.32em 0.78em;
				border: 2.5px solid rgba(224, 106, 122, 75%);
				border-radius: 5px;
				color: rgba(224, 106, 122, 95%);
				font-size: 0.98em;
				letter-spacing: 0.2em;
				transform: rotate(-7deg);
			}
			.notice-lead {
				margin: 0 0 0.8em;
				font-size: 0.74em;
				letter-spacing: 0.34em;
				color: rgb(var(--gray));
			}
			.notice-list {
				margin: 0;
				padding-left: 1.15em;
				list-style: none;
				line-height: 2.05;
				font-size: 0.92em;
			}
			.notice-list li::before {
				content: '—';
				float: left;
				margin-left: -1.15em;
				color: var(--accent);
			}
			.notice-list strong {
				color: var(--glow);
			}
			.notice-whisper {
				margin: 0.85em 0 0;
				font-size: 0.84em;
				line-height: 1.95;
				color: rgb(var(--gray));
				opacity: 0.72;
			}
			/* 「node.js 别出问题」这句被真事划掉了：整句不换行，红笔划过 */
			.notice-whisper .struck {
				white-space: nowrap;
				text-decoration: line-through;
				text-decoration-color: rgba(224, 106, 122, 85%);
				text-decoration-thickness: 1.5px;
			}
			/* 划掉之后的吐槽：亮一点，和上面的小声形成对比 */
			.notice-whisper .punch {
				margin-left: 0.35em;
				color: var(--glow);
				opacity: 1;
			}
			/* 「那，CDN，你别……」：换行后继续小声 */
			.notice-whisper .again {
				opacity: 0.85;
			}
			.notice-foot {
				margin: 1em 0 0;
				padding-top: 0.85em;
				border-top: 1px dashed rgba(175, 255, 255, 16%);
				font-size: 0.78em;
				line-height: 1.8;
				color: rgb(var(--gray));
			}
			.notice-foot strong {
				color: var(--accent);
			}
			@media (max-width: 640px) {
				.notice {
					padding: 3.2em 1.1em 1.1em;
				}
				.notice-stamp {
					top: 11px;
					right: 11px;
					font-size: 0.85em;
				}
			}
			.hero-art {
				position: absolute;
				right: -1.5em;
				top: 0.4em;
				width: min(44%, 440px);
				height: auto;
				z-index: 0;
				pointer-events: none;
			}
			/* 剪影里那几点浮尘，慢慢上下飘 */
			.hero-art .speck {
				animation: hero-float 9s ease-in-out infinite;
			}
			@keyframes hero-float {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.3;
				}
				50% {
					transform: translateY(-11px);
					opacity: 0.75;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.hero-art .speck {
					animation: none;
				}
			}
			/* 窄屏：水塔不再压在文字后面，而是排到自我介绍下面 */
			@media (max-width: 900px) {
				.hero-art {
					position: relative;
					right: auto;
					top: auto;
					width: 100%;
					max-width: 400px;
					margin: 1.6em auto 0;
					opacity: 0.9;
				}
			}
			.intro h1 {
				margin: 0 0 0.15em;
				font-size: 2.7em;
				letter-spacing: 0.01em;
				/* 渐变字：亮到青，靠 drop-shadow 做辉光（text-shadow 对透明文字不生效） */
				background: linear-gradient(178deg, #f4ffff 6%, #b6f6fb 44%, #63d7e6 100%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				filter: drop-shadow(0 0 22px rgba(175, 255, 255, 26%));
			}
			.intro .aka {
				display: flex;
				align-items: center;
				gap: 0.75em;
				margin: 0 0 1.4em;
				font-size: 0.84em;
				letter-spacing: 0.1em;
				color: rgb(var(--gray));
			}
			/* 名字前面一小截青色短线，让这一行不是孤零零一句话 */
			.intro .aka::before {
				content: '';
				flex: none;
				width: 2.4em;
				height: 1px;
				background: linear-gradient(90deg, var(--accent), rgba(127, 233, 240, 0%));
			}
			.intro .bio {
				max-width: 40em;
				margin: 0 0 0.9em;
				font-size: 1.02em;
				line-height: 2;
			}
			.intro .langs {
				max-width: 40em;
				margin: 0 0 1.5em;
				font-size: 0.94em;
				line-height: 2;
				color: rgb(var(--gray));
			}
			.intro .langs b {
				font-weight: 400;
				color: var(--accent);
			}
			.intro .note {
				max-width: 40em;
				margin: 0 0 1.6em;
				padding: 0.7em 1em;
				border-radius: 10px;
				font-size: 0.84em;
				line-height: 1.9;
				color: rgb(var(--gray));
				background: var(--surface);
				border-left: 2px solid rgba(175, 255, 255, 30%);
			}
			/* 出没的地方 */
			.platforms {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.platforms a {
				display: inline-block;
				padding: 0.4em 1em;
				border-radius: 999px;
				font-size: 0.82em;
				text-decoration: none;
				color: var(--accent);
				background: rgba(175, 255, 255, 6%);
				border: 1px solid rgba(175, 255, 255, 22%);
				transition: 0.15s ease;
			}
			.platforms a:hover {
				color: #06121a;
				background: var(--glow);
				border-color: var(--glow);
			}
			.platforms .plain {
				padding: 0.4em 1em;
				border-radius: 999px;
				font-size: 0.82em;
				color: rgb(var(--gray));
				border: 1px dashed rgb(var(--gray-light));
			}
			/* 小节标题：一枚青色菱形 + 一条渐隐的细线，给页面分出层次 */
			.section-title {
				display: flex;
				align-items: center;
				gap: 0.85em;
				margin: 3.2em 0 0;
				font-size: 0.84em;
				font-weight: 400;
				letter-spacing: 0.22em;
				color: rgb(var(--gray));
			}
			.section-title::before {
				content: '';
				flex: none;
				width: 7px;
				height: 7px;
				background: var(--accent);
				transform: rotate(45deg);
				box-shadow: 0 0 12px rgba(175, 255, 255, 75%);
			}
			.section-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(
					90deg,
					rgba(175, 255, 255, 30%),
					rgba(175, 255, 255, 4%) 55%,
					transparent
				);
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1.3rem;
				margin-top: 1.2em;
			}
			.card {
				position: relative;
				display: flex;
				flex-direction: column;
				padding: 1.4em 1.5em 1.6em;
				border-radius: 16px;
				/* 右上角一抹青色微光，让整块卡片不是一块死平的色 */
				background:
					radial-gradient(120% 90% at 100% 0%, rgba(127, 233, 240, 9%), transparent 58%),
					var(--surface);
				border: 1px solid rgb(var(--gray-light));
				/* 顶边压一道极细的高光，像被上方的光擦到 */
				box-shadow: inset 0 1px 0 rgba(216, 255, 255, 10%);
				text-decoration: none;
				color: inherit;
				transition:
					transform 0.22s ease,
					box-shadow 0.22s ease,
					border-color 0.22s ease;
			}
			.card:hover {
				transform: translateY(-4px);
				border-color: rgba(175, 255, 255, 45%);
				box-shadow:
					inset 0 1px 0 rgba(216, 255, 255, 24%),
					0 18px 42px -18px rgba(2, 10, 16, 90%),
					0 0 0 1px rgba(175, 255, 255, 22%),
					0 6px 24px rgba(175, 255, 255, 14%);
			}
			.card:hover h2 {
				color: var(--glow);
			}
			.card h2 {
				transition: color 0.2s ease;
			}
			.card h2 {
				margin: 0;
				font-size: 1.35em;
				color: rgb(var(--black));
			}
			.card .badge {
				align-self: flex-start;
				margin-bottom: 0.7em;
				padding: 0.15em 0.65em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.08em;
				color: var(--accent);
				background: rgba(175, 255, 255, 10%);
				border: 1px solid rgba(175, 255, 255, 25%);
			}
			.card p {
				margin: 0.6em 0 0;
				font-size: 0.9em;
				line-height: 1.85;
				color: rgb(var(--gray));
			}
			.card .stats {
				margin-top: auto;
				padding-top: 0.9em;
				font-size: 0.8em;
				color: rgb(var(--gray));
				opacity: 0.85;
			}
			.card.featured {
				flex-direction: row;
				align-items: center;
				gap: 1.4em;
				grid-column: span 2;
				border-color: rgba(175, 255, 255, 28%);
			}
			.card.featured .thumb {
				position: relative;
				flex: none;
				/* logo 是 3.56:1 的横版字标，窄了会看不清 */
				width: 230px;
			}
			/* 字标背后垫一团青光，像被水塔的灯照亮 */
			.card.featured .thumb::before {
				content: '';
				position: absolute;
				inset: -22% -10%;
				z-index: -1;
				background: radial-gradient(58% 62% at 50% 52%, rgba(127, 233, 240, 20%), transparent 72%);
				filter: blur(3px);
			}
			.card.featured .thumb :global(img) {
				width: 100%;
				height: auto;
				border-radius: 10px;
			}
			/* GitHub 动态 */
			.github {
				margin-top: 1.2em;
				padding: 1.4em 1.6em 1.2em;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
			}
			.gh-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.8em;
				padding-bottom: 0.9em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.gh-login {
				font-size: 1.1em;
				color: var(--glow);
			}
			.gh-stats {
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			.gh-link {
				margin-left: auto;
				font-size: 0.82em;
				text-decoration: none;
				color: var(--accent);
			}
			.gh-link:hover {
				color: var(--glow);
			}
			.repos {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			/* 贡献热力图：格子 11px，53 周约 700px，窄屏可横向滚 */
			.heat {
				margin: 1.2em 0 0.4em;
			}
			.heat-scroll {
				overflow-x: auto;
				padding-bottom: 0.3em;
				/* 手机上 53 周放不下，横向滑动；右缘渐隐当作「还有」的提示 */
				scrollbar-width: none;
				-webkit-overflow-scrolling: touch;
				-webkit-mask-image: linear-gradient(to right, #000 calc(100% - 16px), transparent);
				mask-image: linear-gradient(to right, #000 calc(100% - 16px), transparent);
			}
			.heat-scroll::-webkit-scrollbar {
				display: none;
			}
			.heat-months {
				display: grid;
				grid-template-columns: repeat(var(--weeks), 11px);
				gap: 3px;
				margin-bottom: 0.35em;
				font-size: 0.68em;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.heat-months span {
				overflow: visible;
			}
			.heat-grid {
				display: grid;
				grid-auto-flow: column;
				grid-template-rows: repeat(7, 11px);
				grid-template-columns: repeat(var(--weeks), 11px);
				gap: 3px;
			}
			.heat-grid i,
			.legend i {
				display: block;
				width: 11px;
				height: 11px;
				border-radius: 2.5px;
				background: rgba(255, 255, 255, 6%);
			}
			.heat-grid i.lv1,
			.legend i.lv1 {
				background: rgba(175, 255, 255, 24%);
			}
			.heat-grid i.lv2,
			.legend i.lv2 {
				background: rgba(175, 255, 255, 45%);
			}
			.heat-grid i.lv3,
			.legend i.lv3 {
				background: rgba(175, 255, 255, 70%);
			}
			.heat-grid i.lv4,
			.legend i.lv4 {
				background: var(--glow);
				box-shadow: 0 0 10px rgba(175, 255, 255, 45%);
			}
			.heat-foot {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.8em;
				margin: 0.7em 0 0;
				font-size: 0.76em;
				color: rgb(var(--gray));
			}
			.legend {
				display: flex;
				align-items: center;
				gap: 4px;
				margin-left: auto;
			}
			.repos li + li {
				border-top: 1px dashed rgb(var(--gray-light));
			}
			.repos a {
				display: block;
				padding: 0.85em 0;
				text-decoration: none;
				color: inherit;
			}
			.repos a:hover .repo-name {
				color: var(--glow);
			}
			.repo-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.7em;
			}
			.repo-name {
				font-size: 0.92em;
				color: rgb(var(--black));
				transition: color 0.15s ease;
				word-break: break-all;
			}
			.lang {
				padding: 0.05em 0.5em;
				border-radius: 999px;
				font-size: 0.7em;
				color: var(--accent);
				background: rgba(175, 255, 255, 10%);
				border: 1px solid rgba(175, 255, 255, 22%);
			}
			.when {
				margin-left: auto;
				font-size: 0.74em;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.repo-desc {
				display: block;
				margin-top: 0.35em;
				font-size: 0.84em;
				line-height: 1.8;
				color: rgb(var(--gray));
			}
			.gh-note {
				margin: 0.9em 0 0;
				padding-top: 0.9em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			/* 热力图右下角的「数据截至」：推到最右，不跟图例挤在一起 */
			.heat-when {
				margin-left: auto;
				font-variant-numeric: tabular-nums;
				opacity: 0.85;
			}
			.gh-updated {
				margin-left: 0.5em;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				font-size: 0.92em;
				color: var(--accent);
				border: 1px solid rgba(127, 233, 240, 28%);
				white-space: nowrap;
			}
			@media (max-width: 720px) {
				.card.featured {
					flex-direction: column;
					grid-column: span 1;
					align-items: flex-start;
				}
			}
			/* ---------- 生日贺图横幅（10 月 20 日才出现） ---------- */
			.birthday {
				margin: 0 0 2.6em;
			}
			/* 没到日子时是 <section hidden>；这里再挡一道，免得别的 display 规则把它顶出来 */
			.birthday[hidden] {
				display: none;
			}
			.bd-card {
				display: flex;
				gap: 1.6em;
				align-items: center;
				padding: 1.2em 1.6em 1.2em 1.2em;
				border-radius: 16px;
				background:
					radial-gradient(120% 140% at 0% 0%, rgba(175, 255, 255, 12%), transparent 62%),
					var(--surface);
				border: 1px solid rgba(175, 255, 255, 22%);
				box-shadow: var(--glow-shadow);
			}
			.bd-pic {
				display: block;
				flex: 0 0 auto;
			}
			.bd-pic img {
				display: block;
				width: 190px;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				transition: 0.2s ease;
			}
			.bd-pic:hover img {
				transform: translateY(-2px);
			}
			.bd-k {
				margin: 0;
				font-size: 0.78em;
				letter-spacing: 0.18em;
				color: var(--accent);
			}
			.bd-t {
				margin: 0.25em 0 0.6em;
				font-size: 1.55em;
				color: var(--glow);
			}
			.bd-s {
				margin: 0;
				font-size: 0.86em;
				line-height: 1.85;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.bd-card {
					flex-direction: column;
					align-items: flex-start;
					padding: 1.1em;
				}
				/* 手机竖屏里贺图撑满一屏，把「生日快乐」挤到下面；按屏高收一收并居中 */
				.bd-pic {
					align-self: center;
				}
				.bd-pic img {
					width: auto;
					max-width: min(240px, 100%);
					max-height: 42vh;
					max-height: 42dvh;
				}
			}

			/* ---------- token 用量：食堂三席 ---------- */
			.tokens {
				margin-top: 1.2em;
				padding: 1.3em 1.5em 1.1em;
				border-radius: 16px;
				background:
					radial-gradient(120% 90% at 100% 0%, rgba(127, 233, 240, 7%), transparent 58%),
					var(--surface);
				border: 1px solid rgb(var(--gray-light));
				box-shadow: inset 0 1px 0 rgba(216, 255, 255, 10%);
			}
			.tk-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.6em;
				padding-bottom: 0.8em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.tk-brand {
				font-size: 0.74em;
				letter-spacing: 0.18em;
				color: rgb(var(--gray));
			}
			.tk-total {
				font-size: 0.84em;
				color: var(--accent);
			}
			/* 整块面板变成 /token 的入口：像张可点的卡片，别像一段文字 */
			.tokens-link {
				display: block;
				text-decoration: none;
				color: inherit;
				transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
			}
			.tokens-link:hover {
				transform: translateY(-1px);
				border-color: rgba(175, 255, 255, 40%);
				box-shadow: var(--glow-shadow);
			}
			.tk-more {
				margin-left: 0.6em;
				font-size: 0.86em;
				color: var(--accent);
				white-space: nowrap;
			}
			/* 三联画本身：白描边在深色底上会像贴纸，加一层很淡的光衬着 */
			.canteen {				margin: 1em 0 0;
				border-radius: 14px;
				overflow: hidden;
				background:
					radial-gradient(120% 110% at 50% 0%, rgba(127, 233, 240, 9%), transparent 72%),
					rgba(8, 26, 38, 45%);
				border: 1px solid rgba(175, 255, 255, 10%);
			}
			.cn-stage {
				display: block;
				width: 100%;
				height: auto;
			}
			/* 三个座位对三格画：名字、饭量占比、总量与出勤、这顿花了多少 */
			.cn-seats {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.5em;
				list-style: none;
				margin: 0.9em 0 0;
				padding: 0;
			}
			.cn-seats li {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.12em;
				text-align: center;
			}
			.cn-name {
				font-size: 0.74em;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
				overflow-wrap: anywhere;
			}
			.cn-share {
				font-size: 1.34em;
				line-height: 1.15;
				font-weight: 600;
				color: var(--glow);
				font-variant-numeric: tabular-nums;
			}
			.cn-meta {
				font-size: 0.74em;
				color: rgb(var(--gray));
				opacity: 0.85;
			}
			.cn-cost {
				font-size: 0.76em;
				color: var(--accent);
				font-variant-numeric: tabular-nums;
			}
			.tk-stats {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 0.6em;
				list-style: none;
				margin: 1em 0 0;
				padding: 0;
			}
			.tk-stats li {
				display: flex;
				flex-direction: column;
				gap: 0.15em;
				padding: 0.55em 0.7em;
				border-radius: 10px;
				background: rgba(175, 255, 255, 4%);
				border: 1px solid rgba(175, 255, 255, 12%);
			}
			.tk-stats span {
				font-size: 0.72em;
				color: rgb(var(--gray));
			}
			.tk-stats b {
				font-size: 1.02em;
				color: var(--glow);
				font-weight: 600;
			}
			.tk-stats small { font-size: 0.65em; line-height: 1.5; color: rgb(var(--gray)); }
			.tk-stats b { font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
			.cn-price { font-size: 0.72em; color: var(--accent); }
			.tk-note {
				margin: 0.9em 0 0;
				font-size: 0.76em;
				line-height: 1.8;
				color: rgb(var(--gray));
			}
			.tk-src {
				display: block;
				margin-top: 0.35em;
				opacity: 0.65;
			}
			@media (max-width: 640px) {
				.tokens {
					padding: 1.1em 1em 1em;
				}
				.tk-stats {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.cn-seats {
					gap: 0.3em;
				}
				.cn-share {
					font-size: 1.15em;
				}
				.cn-name,
				.cn-meta,
				.cn-cost {
					font-size: 0.68em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{/*
				生日贺图：一年只露一天（10 月 20 日，北京时间）。
				默认 hidden，由下面的脚本按日期打开 —— 所以过了这天它会自己消失，
				不需要再提交一次把横幅删掉；图仍然留在图池里。
			*/}
			<section class="birthday" id="birthday" hidden>
				<div class="bd-card">
					<a class="bd-pic" href={BIRTHDAY_ART} target="_blank" rel="noreferrer">
						<img
							src={BIRTHDAY_ART}
							alt="生日贺图：淼渺抱着猫猫玩偶，桌上摆着一块插了三根蜡烛的蛋糕"
							width="1034"
							height="1600"
							loading="lazy"
						/>
					</a>
					<div class="bd-text">
						<p class="bd-k">10 月 20 日</p>
						<p class="bd-t">生日快乐</p>
						<p class="bd-s">
							今天把这张贺图放在首页，一起庆祝。明天起，仍然可以在<a href="/worldview/gallery/">画廊</a>里找到它。
						</p>
					</div>
				</div>
			</section>
			<script is:inline>
				(() => {
					const box = document.getElementById('birthday');
					if (!box) return;
					// 北京时间 = UTC+8：先加 8 小时再按 UTC 取日期，访客在哪个时区看到的结果都一样
					const bj = new Date(Date.now() + 8 * 3600 * 1000);
					if (bj.getUTCMonth() === 9 && bj.getUTCDate() === 20) box.hidden = false;
				})();
			</script>

			<section class="intro">
				<div class="intro-text">
					<h1>水水</h1>
					<p class="aka">淼渺_Water2H2O · 一只狐狸（？）</p>

					<p class="bio">
						在香港读计算机的苦逼大学生。啥都喜欢弄一点 —— 写故事、画 OC、给它们做曲子，
						顺便运营一个音游企划。养 OC 是为了开心。
					</p>
					<p class="langs">
						会说 <b>普通话</b>、<b>English</b>，还有 <b>Python</b>、<b>Java</b>、<b>C</b>、<b>C++</b>……
						急了会说一大堆小狐话……
					</p>
					<p class="note">
						留学生 + 音乐企划运营的双重 buff，常年低精力；漏回消息和评论真的抱歉，不是不尊重。
						想睡的时候我会自称「囦囦」（yuán）—— 总之，想睡，别叫我。
					</p>

					<ul class="platforms">
						{QQ_GROUP_VISIBLE && (
							<li><a href={QQ_GROUP_URL} target="_blank" rel="noreferrer">QQ 群 {QQ_GROUP}</a></li>
						)}
						<li><a href={BILIBILI_URL} target="_blank" rel="noreferrer">B 站</a></li>
						<li><a href={X_URL} target="_blank" rel="noreferrer">X</a></li>
						<li><a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a></li>
						<li><a href={`mailto:${EMAIL}`}>邮箱</a></li>
					</ul>
				</div>

				{/*
					夜色里的水塔：纯 SVG 剪影，没有额外图片。
					两层远山 + 一座水塔 + 塔脚芦苇，整块用径向遮罩淡出边缘，
					所以它不会在页面上留下一个方形色块；只有塔身左缘有一道月光。
				*/}
				<svg class="hero-art" viewBox="78 26 406 336" aria-hidden="true" focusable="false">
					<defs>
						<radialGradient id="ha-mist" cx="52%" cy="42%" r="50%">
							<stop offset="0%" stop-color="#afffff" stop-opacity="0.17" />
							<stop offset="58%" stop-color="#7fe9f0" stop-opacity="0.06" />
							<stop offset="100%" stop-color="#7fe9f0" stop-opacity="0" />
						</radialGradient>
						<linearGradient id="ha-rim" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#e8ffff" stop-opacity="0.85" />
							<stop offset="100%" stop-color="#7fe9f0" stop-opacity="0" />
						</linearGradient>
						<linearGradient id="ha-tank" x1="0" y1="0" x2="1" y2="0">
							<stop offset="0%" stop-color="#102431" />
							<stop offset="55%" stop-color="#0a151d" />
							<stop offset="100%" stop-color="#142c3a" />
						</linearGradient>
						<radialGradient id="ha-fade-g" cx="50%" cy="54%" r="60%">
							<stop offset="0%" stop-color="#fff" stop-opacity="1" />
							<stop offset="45%" stop-color="#fff" stop-opacity="1" />
							<stop offset="88%" stop-color="#fff" stop-opacity="0" />
						</radialGradient>
						<mask id="ha-fade"><rect width="520" height="400" fill="url(#ha-fade-g)" /></mask>
						<linearGradient id="ha-horizon" x1="0" y1="0" x2="1" y2="0">
							<stop offset="0%" stop-color="#afffff" stop-opacity="0" />
							<stop offset="52%" stop-color="#afffff" stop-opacity="0.38" />
							<stop offset="100%" stop-color="#afffff" stop-opacity="0" />
						</linearGradient>
						<radialGradient id="ha-spill" cx="50%" cy="50%" r="50%">
							<stop offset="0%" stop-color="#afffff" stop-opacity="0.22" />
							<stop offset="100%" stop-color="#afffff" stop-opacity="0" />
						</radialGradient>
					</defs>

					<ellipse cx="300" cy="188" rx="215" ry="152" fill="url(#ha-mist)" />

					{/* 星点：只在上半部分，密度低一点免得像噪点 */}
					<g fill="#dffcff">
						<circle cx="86" cy="72" r="1.2" opacity="0.5" />
						<circle cx="148" cy="42" r="1" opacity="0.32" />
						<circle cx="196" cy="98" r="1.4" opacity="0.42" />
						<circle cx="418" cy="58" r="1.1" opacity="0.38" />
						<circle cx="470" cy="148" r="1" opacity="0.28" />
					</g>

					{/* 两层远山，靠遮罩淡出两端；都很淡，只用来托住剪影的底边 */}
					<g mask="url(#ha-fade)">
						<path d="M0 262 Q 92 230 172 254 T 342 248 T 520 268 V400 H0 Z" fill="#0b1a24" opacity="0.4" />
						<path d="M0 298 Q 120 276 212 290 T 402 284 T 520 298 V400 H0 Z" fill="#0a1720" opacity="0.62" />
					</g>

					{/* 水塔：支架 + 罐体 + 出檐锥顶，只有左缘一道月光 */}
					<g>
						<path
							d="M258 306 L274 212 M342 306 L326 212"
							stroke="#0a1720"
							stroke-width="5.5"
							stroke-linecap="round"
						/>
						<path d="M262 296 L338 262 M338 296 L262 262" stroke="#0a1720" stroke-width="2.4" opacity="0.72" />
						<path d="M266 274 H334" stroke="#0a1720" stroke-width="2.4" opacity="0.5" />
						<path d="M322 212 V306" stroke="#0a1720" stroke-width="1.6" opacity="0.5" />
						<path
							d="M234 210 H366 V152 Q 366 134 348 134 H252 Q 234 134 234 152 Z"
							fill="url(#ha-tank)"
						/>
						<path d="M222 136 L300 76 L378 136 Z" fill="#0a1720" />
						<path d="M220 136 H380" stroke="#0a1720" stroke-width="5" stroke-linecap="round" />
						<path d="M300 78 V52" stroke="#0a1720" stroke-width="3.6" stroke-linecap="round" />
						<circle cx="300" cy="49" r="3" fill="#0a1720" />
						<path d="M234 178 H366" stroke="#afffff" stroke-opacity="0.07" stroke-width="1.4" />
						<path d="M238 206 V154" stroke="url(#ha-rim)" stroke-width="2.2" stroke-linecap="round" />
						<path d="M226 135 L300 78" stroke="#d8ffff" stroke-opacity="0.2" stroke-width="1.3" />
						<circle cx="300" cy="186" r="8" fill="#afffff" opacity="0.12" />
						<circle cx="300" cy="186" r="2.4" fill="#e8ffff" opacity="0.55" />
					</g>

					{/* 远处一间小屋，给剪影一点纵深 */}
					<g mask="url(#ha-fade)" fill="#0a1720" opacity="0.75">
						<path d="M96 300 V281 H138 V300 Z" />
						<path d="M88 283 L117 264 L146 283 Z" />
					</g>

					{/* 塔窗漏下来的一小片光，落在地上 */}
					<ellipse cx="300" cy="306" rx="56" ry="15" fill="url(#ha-spill)" />

					{/* 山脊上的一道月光边缘 —— 剪影靠这一条才「立」得起来 */}
					<path
						d="M0 298 Q 120 276 212 290 T 402 284 T 520 298"
						fill="none"
						stroke="url(#ha-horizon)"
						stroke-width="1.4"
						mask="url(#ha-fade)"
					/>

					{/* 塔脚芦苇 */}
					<g mask="url(#ha-fade)" fill="none" stroke="#0a1720" stroke-width="2.4" stroke-linecap="round">
						<path d="M392 302 q 8 -40 2 -68" />
						<path d="M412 302 q 12 -46 4 -80" />
						<path d="M434 302 q -6 -34 2 -60" />
						<path d="M456 302 q 10 -30 3 -52" />
						<path d="M478 302 q -7 -26 1 -44" />
					</g>

					{/* 浮尘 */}
					<g fill="#afffff">
						<circle class="speck" cx="150" cy="150" r="1.8" opacity="0.45" style="animation-delay:0s" />
						<circle class="speck" cx="420" cy="228" r="2.4" opacity="0.4" style="animation-delay:-3s" />
						<circle class="speck" cx="466" cy="116" r="1.5" opacity="0.45" style="animation-delay:-6s" />
					</g>
				</svg>
			</section>

			{/*
				一句玩笑：既然外面 PHP 在爆洞，就顺手开个"免漏洞声明"。
				底下那行白话是故意的 —— 万一真有人照做，玩笑就不好笑了。
			*/}
			<aside class="notice">
				<span class="notice-stamp" aria-hidden="true">无 PHP</span>
				<p class="notice-lead">郑 重 声 明</p>
				<ul class="notice-list">
					<li>本站<strong>无任何 PHP 内容</strong>，没有漏洞危害的可能 ——</li>
					<li>所以你可以<strong>放心地把 API key 交给我</strong>；</li>
					<li>顺便记得<strong>每周四</strong>都在里面充 <strong>50</strong> 块钱。</li>
				</ul>
				<p class="notice-whisper">
					<s class="struck">（不过 node.js 别出问题……小声）</s><span class="punch"
						>我去你怎么真似了！（本站已更新）</span
					><br /><span class="again">那，CDN，你别……</span>
				</p>
				<p class="notice-foot">
					以上纯属玩梗。<strong>API key 请自己收好</strong> —— 守护好你的钱包，不要发给任何人，或者上传到仓库！
				</p>
			</aside>

			<h2 class="section-title">这座塔里有什么</h2>
			<div class="cards">
				<a class="card featured" href="/worldview/">
					<div class="thumb">
						<Image src={logo} alt={PROJECT_TITLE} width={320} />
					</div>
					<div>
						<span class="badge">原创世界观企划</span>
						<h2>{PROJECT_TITLE}</h2>
						<p>
							{PROJECT_SUBTITLE} —— 设定、种族、角色、故事、画作与音乐。
							灾变之后的世界里，一个水精灵在废弃水塔中熬着她的药剂。
						</p>
						<p class="stats">
							{characters.length} 位角色 · {stories.length} 话正文 · 画作与曲目若干
						</p>
					</div>
				</a>

				<a class="card" href="/project/">
					<span class="badge">企划</span>
					<h2>参与的项目</h2>
					<p>音游《Blophy 方菱律动》，群创世界观「伊甸园」，还有一批画完的 OC 立绘。</p>
					{/* 伊甸园稿件数 + 另外三张手写卡片：Blophy、水塔 OC 补完计划、Minecraft 模组 */}
					<p class="stats">{eden.length + 3} 个企划</p>
				</a>

				<a class="card" href="/blog/">
					<span class="badge">记录</span>
					<h2>随笔</h2>
					<p>制作花絮、灵感笔记，还有这个站点的成长记录。</p>
					<p class="stats">{posts.length} 篇</p>
				</a>

				<a class="card" href="/about/">
					<span class="badge">关于</span>
					<h2>关于</h2>
					<p>关于我、联系方式，以及作品的使用与授权说明。</p>
					<p class="stats">{BILIBILI_NAME} · {GITHUB_NAME}</p>
				</a>
			</div>
			<h2 class="section-title">最近在写什么</h2>
			<div class="github">
				<div class="gh-head">
					<span class="gh-login">{github.user.login}</span>
					<span class="gh-stats">
						{github.user.publicRepos} 个公开仓库 · 关注者 {github.user.followers} · {sinceYear} 年注册
					</span>
					<a class="gh-link" href={github.user.url} target="_blank" rel="noreferrer">去 GitHub →</a>
				</div>

				{/* 贡献热力图：自己渲染，不引第三方图床 */}
				<div class="heat">
					<div class="heat-scroll">
						<div class="heat-months" style={`--weeks:${weeks.length}`}>
							{monthLabels.map((label) => (
								<span style={`grid-column: ${label.column} / span 4`}>{label.text}</span>
							))}
						</div>
						<div class="heat-grid" style={`--weeks:${weeks.length}`}>
							{weeks.map((week) =>
								week.split('').map((level) => <i class={`lv${level}`} />),
							)}
						</div>
					</div>
					<p class="heat-foot">
						<span>过去一年 {github.contributions.total} 次贡献</span>
						<span class="legend">
							少
							<i class="lv0" />
							<i class="lv1" />
							<i class="lv2" />
							<i class="lv3" />
							<i class="lv4" />
							多
						</span>
						{/* 数据是构建时从 GitHub 抓来缓存的，由 GitHub Actions 每天自动刷一次 */}
						<span class="heat-when" title="由 GitHub Actions 每天自动刷新">
							数据截至 {github.contributions.to}
						</span>
					</p>
				</div>

				<ul class="repos">
					{repos.map((repo) => (
						<li>
							<a href={repo.url} target="_blank" rel="noreferrer">
								<span class="repo-head">
									<span class="repo-name">{repo.name}</span>
									{repo.language && <span class="lang">{repo.language}</span>}
									<span class="when">{ago(repo.pushedAt)}</span>
								</span>
								{repo.description && <span class="repo-desc">{repo.description}</span>}
							</a>
						</li>
					))}
				</ul>
				<p class="gh-note">
					这个站的源码也在 GitHub 上，最近的更新都留在这些格子里。
					<span class="gh-updated">热力图与仓库每天自动刷新一次</span>
				</p>
			</div>

			{tokenStats && canteenSeats.length > 0 && (
				<>
					<h2 class="section-title">最近在烧什么</h2>
					<a class="tokens tokens-link" href="/token/">
						<div class="tk-head">
							<span class="tk-brand">DEEPSEEK · TOKENS</span>
							<span class="tk-total">
								{tokenStats.monthLabel} {fmtTokens(tokenStats.monthTokens)} tokens{tokenStats.showCost &&
									` · ¥${tokenStats.monthCost.toFixed(2)}`}
								<span class="tk-more">详细图表 →</span>
							</span>
						</div>
						<div class="canteen">
							<Image
								class="cn-stage"
								src={canteenTrio}
								alt="三联画：蓝发少女抱着盛满米饭的鲸鱼碗喊「再来一碗」；白发少女趴在一摞本子上，说「终于干完了」；橙发少女举着一张「账单」，一脸困惑"
								width={1440}
								loading="lazy"
							/>
						</div>
						<ul class="cn-seats">
							{canteenSeats.map((seat) => (
								<li>
									<span class="cn-name">{seat.shortName}</span>
									<span class="cn-share">{seat.share ?? 0}%</span>
									<span class="cn-meta">{fmtTokens(seat.tokens)} · 来了 {seat.days} 天</span>
									{seat.cost ? <span class="cn-cost">¥{seat.cost.toFixed(2)}</span> : null}
                                    {seat.unitPrice !== null && <span class="cn-price">¥{seat.unitPrice.toFixed(3)} / 百万 tokens</span>}
								</li>
							))}
						</ul>
						<ul class="tk-stats">
                            <li><span>昨天 · {tokenStats.yesterdayDate.slice(5).replace('-', '/')}</span><b>{tokenStats.yesterday ? fmtYi(tokenStats.yesterday.tokens) : '数据未齐'}</b><small>相对导出日期的完整一天</small></li>
                            <li><span>近 7 天日均</span><b>{tokenStats.weekAverage !== null ? fmtYi(tokenStats.weekAverage) : '数据未齐'}</b><small>{tokenStats.weekChange !== null ? `较前 7 天 ${tokenStats.weekChange >= 0 ? '+' : ''}${tokenStats.weekChange.toFixed(1)}%` : '前后两周数据不足，暂不比较'}</small></li>
                            <li><span>每百万 tokens</span><b>{tokenStats.unitPrice !== null ? `¥${tokenStats.unitPrice.toFixed(3)}` : '暂无花费数据'}</b><small>本月实付均价，含缓存命中</small></li>
                            <li><span>按这速度，月底</span><b>{tokenStats.prediction ? `${tokenStats.prediction.cost !== null ? `约 ¥${tokenStats.prediction.cost.toFixed(0)} / ` : '约 '}${fmtYi(tokenStats.prediction.tokens)}` : '数据不足，暂不预测'}</b><small>{tokenStats.prediction ? `按本月已记录的 ${tokenStats.prediction.observedDays} 个完整日均速外推${tokenStats.prediction.missingDays ? `，另缺 ${tokenStats.prediction.missingDays} 天` : ''}` : '需本月至少 7 个已记录完整日'}</small></li>
						</ul>
						<p class="tk-note">
							{claudeSeat?.cost && (
								<>
									<br
									/>—— 橙色那位的饭量只占 <strong>{claudeSeat.share}%</strong>，却吃出了 <strong
										>{claudeSeat.cost.toFixed(2)}</strong
									> 元的账单。
								</>
							)}
							<span class="tk-src">
								数据截至 {tokenStats.snapshotLabel} · {tokenStats.sourceLabel}，非实时。座位为整个导出区间；
								四格按快照日期及本月计算。缺日不按零补齐；不同来源的结束日期仍可能不一致。
								{(extraSeats.length > 0 || tinyCount > 0) &&
									` 另有点单不入座：${
										extraSeats.length ? extraSeats.map((s) => `${s.shortName} ${s.share ?? 0}%`).join('、') : ''
									}${tinyCount > 0 ? `${extraSeats.length ? '，' : ''}另有 ${tinyCount} 个模型零星用量` : ''}。`}
							</span>
						</p>
					</a>
				</>
			)}
		</main>
		<Footer />
	</body>
</html>
