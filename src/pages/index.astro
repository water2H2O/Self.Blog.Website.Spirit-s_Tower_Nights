---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '../assets/oc/logo.webp';
import githubData from '../data/github.json';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	BILIBILI_NAME,
	BILIBILI_URL,
	EMAIL,
	GITHUB_NAME,
	GITHUB_URL,
	PROJECT_SUBTITLE,
	PROJECT_TITLE,
	QQ_GROUP,
	QQ_GROUP_URL,
	SITE_AUTHOR,
	SITE_DESCRIPTION,
	X_URL,
} from '../consts';

const isPublic = (entry: { data: { draft?: boolean } }) => !entry.data.draft;
const posts = (await getCollection('blog')).filter(isPublic);
const characters = (await getCollection('characters')).filter(isPublic);
const stories = (await getCollection('stories', ({ data }) => data.status === 'published'));
const eden = (await getCollection('eden', ({ data }) => !data.draft));

/**
 * 生日贺图：只在每年 10 月 20 日（北京时间）在首页露一天。
 * 图本身早就在图池里了，横幅只是「今天多摆一下」——
 * 日期判断写在下面那段 inline 脚本里，所以不用等那天重新构建。
 */
const BIRTHDAY_ART = `/gallery/${encodeURIComponent('淼渺__贺图-生日快乐.webp')}`;

/**
 * GitHub 动态：数据由 tools/fetch-github.mjs 抓好缓存在 src/data/github.json，
 * 构建本身不联网 —— 想更新就跑一次那个脚本。
 */
const github = githubData as {
	user: { login: string; url: string; publicRepos: number; followers: number; createdAt: string };
	repos: {
		name: string;
		description: string;
		language: string;
		url: string;
		pushedAt: string;
		sizeKb: number;
		empty: boolean;
	}[];
	contributions: { from: string; to: string; total: number; weeks: string[] };
};
const repos = github.repos.filter((repo) => !repo.empty).slice(0, 4);
const sinceYear = new Date(github.user.createdAt).getFullYear();
const daysAgo = (iso: string) =>
	Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 86400000));
const ago = (iso: string) => {
	const days = daysAgo(iso);
	if (days === 0) return '今天';
	if (days === 1) return '昨天';
	if (days < 30) return `${days} 天前`;
	return `${Math.round(days / 30)} 个月前`;
};

/** 贡献热力图：每周一列、列内周日→周六 */
const weeks = github.contributions.weeks;
const heatStart = new Date(`${github.contributions.from}T00:00:00Z`);
const MONTHS = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
const monthLabels: { column: number; text: string }[] = [];
let lastMonth = -1;
weeks.forEach((_, index) => {
	const month = new Date(heatStart.getTime() + index * 7 * 86400000).getUTCMonth();
	if (month !== lastMonth) {
		monthLabels.push({ column: index + 1, text: MONTHS[month] });
		lastMonth = month;
	}
});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_AUTHOR} · 个人站点`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1000px;
			}
			/* 开头这一段：不再是一行干巴巴的自我介绍 */
			/*
			 * 首页的视觉骨架：
			 *   左边是文字（.intro-text），右边是「夜色里的水塔」剪影（.hero-art，纯 SVG）。
			 *   文字压在上层，剪影与两团色差光在下面当背景 —— 这是整页唯一的「剪影 + 色差」。
			 */
			.intro {
				position: relative;
				isolation: isolate;
				padding-top: 0.4em;
			}
			/* 两团柔光：青压在剪影那一侧，紫压在标题后面。
			   只在垂直方向外扩 —— 左右外扩会把窄屏顶出横向滚动条 */
			.intro::before {
				content: '';
				position: absolute;
				inset: -8% 0 4% 0;
				z-index: -1;
				pointer-events: none;
				background:
					radial-gradient(42% 56% at 76% 32%, rgba(127, 233, 240, 18%), transparent 70%),
					radial-gradient(40% 52% at 8% 2%, rgba(124, 108, 240, 16%), transparent 72%);
			}
			/* 地平线：一条从左亮到右隐的细线，把 hero 和下面的卡片分开 */
			.intro::after {
				content: '';
				position: absolute;
				left: 0;
				right: 0;
				bottom: -1.4em;
				height: 1px;
				background: linear-gradient(
					90deg,
					rgba(175, 255, 255, 32%),
					rgba(175, 255, 255, 6%) 62%,
					transparent
				);
			}
			.intro-text {
				position: relative;
				z-index: 1;
				max-width: 42em;
			}
			.hero-art {
				position: absolute;
				right: -1.5em;
				top: 0.4em;
				width: min(44%, 440px);
				height: auto;
				z-index: 0;
				pointer-events: none;
			}
			/* 剪影里那几点浮尘，慢慢上下飘 */
			.hero-art .speck {
				animation: hero-float 9s ease-in-out infinite;
			}
			@keyframes hero-float {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.3;
				}
				50% {
					transform: translateY(-11px);
					opacity: 0.75;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.hero-art .speck {
					animation: none;
				}
			}
			/* 窄屏：水塔不再压在文字后面，而是排到自我介绍下面 */
			@media (max-width: 900px) {
				.hero-art {
					position: relative;
					right: auto;
					top: auto;
					width: 100%;
					max-width: 400px;
					margin: 1.6em auto 0;
					opacity: 0.9;
				}
			}
			.intro h1 {
				margin: 0 0 0.15em;
				font-size: 2.7em;
				letter-spacing: 0.01em;
				/* 渐变字：亮到青，靠 drop-shadow 做辉光（text-shadow 对透明文字不生效） */
				background: linear-gradient(178deg, #f4ffff 6%, #b6f6fb 44%, #63d7e6 100%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				filter: drop-shadow(0 0 22px rgba(175, 255, 255, 26%));
			}
			.intro .aka {
				display: flex;
				align-items: center;
				gap: 0.75em;
				margin: 0 0 1.4em;
				font-size: 0.84em;
				letter-spacing: 0.1em;
				color: rgb(var(--gray));
			}
			/* 名字前面一小截青色短线，让这一行不是孤零零一句话 */
			.intro .aka::before {
				content: '';
				flex: none;
				width: 2.4em;
				height: 1px;
				background: linear-gradient(90deg, var(--accent), rgba(127, 233, 240, 0%));
			}
			.intro .bio {
				max-width: 40em;
				margin: 0 0 0.9em;
				font-size: 1.02em;
				line-height: 2;
			}
			.intro .langs {
				max-width: 40em;
				margin: 0 0 1.5em;
				font-size: 0.94em;
				line-height: 2;
				color: rgb(var(--gray));
			}
			.intro .langs b {
				font-weight: 400;
				color: var(--accent);
			}
			.intro .note {
				max-width: 40em;
				margin: 0 0 1.6em;
				padding: 0.7em 1em;
				border-radius: 10px;
				font-size: 0.84em;
				line-height: 1.9;
				color: rgb(var(--gray));
				background: var(--surface);
				border-left: 2px solid rgba(175, 255, 255, 30%);
			}
			/* 出没的地方 */
			.platforms {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.platforms a {
				display: inline-block;
				padding: 0.4em 1em;
				border-radius: 999px;
				font-size: 0.82em;
				text-decoration: none;
				color: var(--accent);
				background: rgba(175, 255, 255, 6%);
				border: 1px solid rgba(175, 255, 255, 22%);
				transition: 0.15s ease;
			}
			.platforms a:hover {
				color: #06121a;
				background: var(--glow);
				border-color: var(--glow);
			}
			.platforms .plain {
				padding: 0.4em 1em;
				border-radius: 999px;
				font-size: 0.82em;
				color: rgb(var(--gray));
				border: 1px dashed rgb(var(--gray-light));
			}
			/* 小节标题：一枚青色菱形 + 一条渐隐的细线，给页面分出层次 */
			.section-title {
				display: flex;
				align-items: center;
				gap: 0.85em;
				margin: 3.2em 0 0;
				font-size: 0.84em;
				font-weight: 400;
				letter-spacing: 0.22em;
				color: rgb(var(--gray));
			}
			.section-title::before {
				content: '';
				flex: none;
				width: 7px;
				height: 7px;
				background: var(--accent);
				transform: rotate(45deg);
				box-shadow: 0 0 12px rgba(175, 255, 255, 75%);
			}
			.section-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(
					90deg,
					rgba(175, 255, 255, 30%),
					rgba(175, 255, 255, 4%) 55%,
					transparent
				);
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1.3rem;
				margin-top: 1.2em;
			}
			.card {
				position: relative;
				display: flex;
				flex-direction: column;
				padding: 1.4em 1.5em 1.6em;
				border-radius: 16px;
				/* 右上角一抹青色微光，让整块卡片不是一块死平的色 */
				background:
					radial-gradient(120% 90% at 100% 0%, rgba(127, 233, 240, 9%), transparent 58%),
					var(--surface);
				border: 1px solid rgb(var(--gray-light));
				/* 顶边压一道极细的高光，像被上方的光擦到 */
				box-shadow: inset 0 1px 0 rgba(216, 255, 255, 10%);
				text-decoration: none;
				color: inherit;
				transition:
					transform 0.22s ease,
					box-shadow 0.22s ease,
					border-color 0.22s ease;
			}
			.card:hover {
				transform: translateY(-4px);
				border-color: rgba(175, 255, 255, 45%);
				box-shadow:
					inset 0 1px 0 rgba(216, 255, 255, 24%),
					0 18px 42px -18px rgba(2, 10, 16, 90%),
					0 0 0 1px rgba(175, 255, 255, 22%),
					0 6px 24px rgba(175, 255, 255, 14%);
			}
			.card:hover h2 {
				color: var(--glow);
			}
			.card h2 {
				transition: color 0.2s ease;
			}
			.card h2 {
				margin: 0;
				font-size: 1.35em;
				color: rgb(var(--black));
			}
			.card .badge {
				align-self: flex-start;
				margin-bottom: 0.7em;
				padding: 0.15em 0.65em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.08em;
				color: var(--accent);
				background: rgba(175, 255, 255, 10%);
				border: 1px solid rgba(175, 255, 255, 25%);
			}
			.card p {
				margin: 0.6em 0 0;
				font-size: 0.9em;
				line-height: 1.85;
				color: rgb(var(--gray));
			}
			.card .stats {
				margin-top: auto;
				padding-top: 0.9em;
				font-size: 0.8em;
				color: rgb(var(--gray));
				opacity: 0.85;
			}
			.card.featured {
				flex-direction: row;
				align-items: center;
				gap: 1.4em;
				grid-column: span 2;
				border-color: rgba(175, 255, 255, 28%);
			}
			.card.featured .thumb {
				position: relative;
				flex: none;
				/* logo 是 3.56:1 的横版字标，窄了会看不清 */
				width: 230px;
			}
			/* 字标背后垫一团青光，像被水塔的灯照亮 */
			.card.featured .thumb::before {
				content: '';
				position: absolute;
				inset: -22% -10%;
				z-index: -1;
				background: radial-gradient(58% 62% at 50% 52%, rgba(127, 233, 240, 20%), transparent 72%);
				filter: blur(3px);
			}
			.card.featured .thumb :global(img) {
				width: 100%;
				height: auto;
				border-radius: 10px;
			}
			/* GitHub 动态 */
			.github {
				margin-top: 1.2em;
				padding: 1.4em 1.6em 1.2em;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
			}
			.gh-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.8em;
				padding-bottom: 0.9em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.gh-login {
				font-size: 1.1em;
				color: var(--glow);
			}
			.gh-stats {
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			.gh-link {
				margin-left: auto;
				font-size: 0.82em;
				text-decoration: none;
				color: var(--accent);
			}
			.gh-link:hover {
				color: var(--glow);
			}
			.repos {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			/* 贡献热力图：格子 11px，53 周约 700px，窄屏可横向滚 */
			.heat {
				margin: 1.2em 0 0.4em;
			}
			.heat-scroll {
				overflow-x: auto;
				padding-bottom: 0.3em;
			}
			.heat-months {
				display: grid;
				grid-template-columns: repeat(var(--weeks), 11px);
				gap: 3px;
				margin-bottom: 0.35em;
				font-size: 0.68em;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.heat-months span {
				overflow: visible;
			}
			.heat-grid {
				display: grid;
				grid-auto-flow: column;
				grid-template-rows: repeat(7, 11px);
				grid-template-columns: repeat(var(--weeks), 11px);
				gap: 3px;
			}
			.heat-grid i,
			.legend i {
				display: block;
				width: 11px;
				height: 11px;
				border-radius: 2.5px;
				background: rgba(255, 255, 255, 6%);
			}
			.heat-grid i.lv1,
			.legend i.lv1 {
				background: rgba(175, 255, 255, 24%);
			}
			.heat-grid i.lv2,
			.legend i.lv2 {
				background: rgba(175, 255, 255, 45%);
			}
			.heat-grid i.lv3,
			.legend i.lv3 {
				background: rgba(175, 255, 255, 70%);
			}
			.heat-grid i.lv4,
			.legend i.lv4 {
				background: var(--glow);
				box-shadow: 0 0 10px rgba(175, 255, 255, 45%);
			}
			.heat-foot {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.8em;
				margin: 0.7em 0 0;
				font-size: 0.76em;
				color: rgb(var(--gray));
			}
			.legend {
				display: flex;
				align-items: center;
				gap: 4px;
				margin-left: auto;
			}
			.repos li + li {
				border-top: 1px dashed rgb(var(--gray-light));
			}
			.repos a {
				display: block;
				padding: 0.85em 0;
				text-decoration: none;
				color: inherit;
			}
			.repos a:hover .repo-name {
				color: var(--glow);
			}
			.repo-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.7em;
			}
			.repo-name {
				font-size: 0.92em;
				color: rgb(var(--black));
				transition: color 0.15s ease;
				word-break: break-all;
			}
			.lang {
				padding: 0.05em 0.5em;
				border-radius: 999px;
				font-size: 0.7em;
				color: var(--accent);
				background: rgba(175, 255, 255, 10%);
				border: 1px solid rgba(175, 255, 255, 22%);
			}
			.when {
				margin-left: auto;
				font-size: 0.74em;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.repo-desc {
				display: block;
				margin-top: 0.35em;
				font-size: 0.84em;
				line-height: 1.8;
				color: rgb(var(--gray));
			}
			.gh-note {
				margin: 0.9em 0 0;
				padding-top: 0.9em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			/* 热力图右下角的「数据截至」：推到最右，不跟图例挤在一起 */
			.heat-when {
				margin-left: auto;
				font-variant-numeric: tabular-nums;
				opacity: 0.85;
			}
			.gh-updated {
				margin-left: 0.5em;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				font-size: 0.92em;
				color: var(--accent);
				border: 1px solid rgba(127, 233, 240, 28%);
				white-space: nowrap;
			}
			@media (max-width: 720px) {
				.card.featured {
					flex-direction: column;
					grid-column: span 1;
					align-items: flex-start;
				}
			}
			/* ---------- 生日贺图横幅（10 月 20 日才出现） ---------- */
			.birthday {
				margin: 0 0 2.6em;
			}
			/* 没到日子时是 <section hidden>；这里再挡一道，免得别的 display 规则把它顶出来 */
			.birthday[hidden] {
				display: none;
			}
			.bd-card {
				display: flex;
				gap: 1.6em;
				align-items: center;
				padding: 1.2em 1.6em 1.2em 1.2em;
				border-radius: 16px;
				background:
					radial-gradient(120% 140% at 0% 0%, rgba(175, 255, 255, 12%), transparent 62%),
					var(--surface);
				border: 1px solid rgba(175, 255, 255, 22%);
				box-shadow: var(--glow-shadow);
			}
			.bd-pic {
				display: block;
				flex: 0 0 auto;
			}
			.bd-pic img {
				display: block;
				width: 190px;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				transition: 0.2s ease;
			}
			.bd-pic:hover img {
				transform: translateY(-2px);
			}
			.bd-k {
				margin: 0;
				font-size: 0.78em;
				letter-spacing: 0.18em;
				color: var(--accent);
			}
			.bd-t {
				margin: 0.25em 0 0.6em;
				font-size: 1.55em;
				color: var(--glow);
			}
			.bd-s {
				margin: 0;
				font-size: 0.86em;
				line-height: 1.85;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.bd-card {
					flex-direction: column;
					align-items: flex-start;
					padding: 1.1em;
				}
				.bd-pic img {
					width: 100%;
					max-width: 240px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{/*
				生日贺图：一年只露一天（10 月 20 日，北京时间）。
				默认 hidden，由下面的脚本按日期打开 —— 所以过了这天它会自己消失，
				不需要再提交一次把横幅删掉；图仍然留在图池里。
			*/}
			<section class="birthday" id="birthday" hidden>
				<div class="bd-card">
					<a class="bd-pic" href={BIRTHDAY_ART} target="_blank" rel="noreferrer">
						<img
							src={BIRTHDAY_ART}
							alt="生日贺图：淼渺抱着猫猫玩偶，桌上摆着一块插了三根蜡烛的蛋糕"
							width="1034"
							height="1600"
							loading="lazy"
						/>
					</a>
					<div class="bd-text">
						<p class="bd-k">10 月 20 日</p>
						<p class="bd-t">生日快乐</p>
						<p class="bd-s">
							这张贺图只在今天摆在这儿，明天它就回<a href="/worldview/gallery/">画廊</a>里当普通的一张。
						</p>
					</div>
				</div>
			</section>
			<script is:inline>
				(() => {
					const box = document.getElementById('birthday');
					if (!box) return;
					// 北京时间 = UTC+8：先加 8 小时再按 UTC 取日期，访客在哪个时区看到的结果都一样
					const bj = new Date(Date.now() + 8 * 3600 * 1000);
					if (bj.getUTCMonth() === 9 && bj.getUTCDate() === 20) box.hidden = false;
				})();
			</script>

			<section class="intro">
