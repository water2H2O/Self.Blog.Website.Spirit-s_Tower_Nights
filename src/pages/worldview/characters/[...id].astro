---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, getEntry, render } from 'astro:content';
import gallery from '../../../data/gallery-meta.json';
import GalleryWall from '../../../components/GalleryWall.astro';
import CrossLinkBox from '../../../components/CrossLinkBox.astro';
import DetailPage from '../../../layouts/DetailPage.astro';
import { publishedEpisodes } from '../../../lib/stories';

export async function getStaticPaths() {
	const characters = await getCollection('characters', ({ data }) => !data.draft);
	return characters.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
	name,
	race,
	ownership,
	owner,
	ownerUrl,
	aliases,
	title,
	summary,
	pronouns,
	height,
	age,
	themeColor,
	portrait,
	tags,
	relations,
	lore,
	canon,
	spoiler,
} = entry.data;

const raceEntry = race ? await getEntry(race) : undefined;

const meta: { label: string; value: string }[] = [];
if (raceEntry) meta.push({ label: '种族', value: raceEntry.data.name });
if (ownership === '联动') {
	meta.push({ label: '归属', value: '联动设定' });
	meta.push({ label: '设主', value: owner || '待补', href: ownerUrl });
}
if (title) meta.push({ label: '称号', value: title });
if (pronouns) meta.push({ label: '性别表现', value: pronouns });
if (height) meta.push({ label: '身高', value: height });
if (age) meta.push({ label: '年龄', value: age });
if (aliases.length > 0) meta.push({ label: '别名 / 自称', value: aliases.join(' / ') });

/** 关联设定 */
const relatedLore = (await Promise.all(lore.map((ref) => getEntry(ref)))).filter(
	(item): item is NonNullable<typeof item> => Boolean(item),
);

/** 出场故事 */
const episodes = (await publishedEpisodes()).filter((episode) =>
	episode.data.characters.some((ref) => ref.id === entry.id),
);

/**
 * 画作：从画廊图池里按角色取（标注见 src/data/gallery-meta.json）。
 * 和画廊同一套展示模式；表情包这类也一起铺，角色页讲究的是「这个人的东西都在这儿」。
 *
 * 例外：鼠标指针（kind === '指针'）不进画作墙 —— 它是可下载的数字资源，
 * 单独放在上面的「数字资源」框里，见 entry.data.resources。
 */
const POOL = path.join(process.cwd(), 'public', 'gallery');
const galleryMeta =
	(gallery as {
		items?: Record<
			string,
			{ character?: string; kind?: string; title?: string; ownership?: string; owner?: string; w?: number; h?: number }
		>;
	}).items ?? {};
const myName = entry.data.name;
const myItems = fs.existsSync(POOL)
	? fs
			.readdirSync(POOL)
			.filter((file) => /\.webp$/i.test(file))
			.sort()
			.map((file) => ({ file, ...(galleryMeta[file] ?? {}) }))
			/**
			 * 一张图可能画着好几个人（淼渺×飒岚、淼渺×白茶…），
			 * 所以先看 `characters` 数组里有没有我；没有这个字段才退回旧的单值匹配。
			 * 宽松匹配保留：条目里的名字可能比图池里的更长（例如「莉莉安娜·萨拉姆博」）。
			 */
			.filter((item) => {
				const list: string[] = Array.isArray(item.characters) ? item.characters : [];
				const hit = (name: string) =>
					name !== '' && (name === myName || name.includes(myName) || myName.includes(name));
				if (list.length > 0) {
					const two = item as { characters?: string[] };
					return (two.characters ?? []).some(hit);
				}
				return hit(item.character ?? '');
			})
	: [];

/**
 * 指针类素材。
 * 预览只挑真正的指针图：同分类里还混着「如何调整鼠标指针大小」教程图
 * 和「指针展示图」拼图，它们拿来当缩略图会显得莫名其妙。
 */
const cursorItems = myItems.filter(
	(item) => item.kind === '指针' && !/如何调整|展示图/.test(item.file),
);

const artworks = myItems
	.filter((item) => item.kind !== '指针')
	.map((item) => ({
		url: `/gallery/${encodeURIComponent(item.file)}`,
		ar: item.w && item.h ? Number((item.w / item.h).toFixed(3)) : 1,
		ownership: item.ownership ?? '其他',
		owner: item.owner ?? '',
		kind: item.kind ?? '其他',
		character: item.character ?? '',
		title: item.title ?? '',
		always: item.always === true,
	}));

/** 可下载的数字资源（指针包之类），显示在画作之上 */
const resources = entry.data.resources ?? [];

/** 人际关系 */
const relationList: { name: string; note: string; id?: string; color: string }[] = [];if (relations.length > 0) {
	const resolved = await Promise.all(relations.map((relation) => getEntry(relation.to)));
	resolved.forEach((target, index) => {
		if (!target) return;
		relationList.push({
			id: target.id,
			name: target.data.name,
			note: relations[index]!.note,
			color: target.data.themeColor,
		});
	});
}
---

<DetailPage
	title={name}
	subtitle={raceEntry ? raceEntry.data.name : undefined}
	summary={summary}
	themeColor={themeColor}
	cover={portrait}
	sheet={entry.data.sheet}
	tags={tags}
	meta={meta}
	canon={canon}
	spoiler={spoiler}
	license={ownership === '原创' ? 'cc-by' : 'reserved'}
	licenseNote={ownership === '原创'
		? undefined
		: `本页角色「${name}」版权归设主${owner ? ` ${owner}` : ''}所有，本站只是收录。`}
	backHref="/worldview/characters/"
	backLabel="角色"
>
	<Content />

	{/* 跨企划指路：同一角色在别的企划里也有档案时（例如蔚蓝） */}
	<CrossLinkBox links={entry.data.crossLinks ?? []} heading="在其他企划中认识这个角色" />

	{
		relationList.length > 0 && (
			<div class="relations">
				<h2>人际关系</h2>
				<ul>
					{relationList.map((relation) => (
						<li style={`--rel-color:${relation.color}`}>
							<span class="who">
								{relation.id ? <a href={`/worldview/characters/${relation.id}/`}>{relation.name}</a> : relation.name}
							</span>
							<span class="note">{relation.note}</span>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		(artworks.length > 0 || episodes.length > 0 || relatedLore.length > 0 || resources.length > 0) && (
			<div class="related">
				{resources.length > 0 && (
					<div class="res-block">
						<h2>数字资源</h2>
						<div class="res-list">
							{resources.map((res) => (
								<a class="res-card" href={encodeURI(res.href)} download>
									{res.preview && (
										<span class="res-thumb">
											<img src={res.preview} alt="" loading="lazy" decoding="async" />
										</span>
									)}
									<span class="res-body">
										<span class="res-label">
											{res.label}
											<span class="res-dl" aria-hidden="true">
												↓
											</span>
										</span>
										{res.note && <span class="res-note">{res.note}</span>}
										<span class="res-meta">
											{res.size && `${res.size} · `}点击下载
										</span>
									</span>
								</a>
							))}
						</div>
						{cursorItems.length > 0 && (
							<>
								<div class="res-preview">
									{cursorItems.slice(0, 9).map((item) => (
										<img src={`/gallery/${encodeURIComponent(item.file)}`} alt="" loading="lazy" decoding="async" />
									))}
									{cursorItems.length > 9 && <span class="res-more">等 {cursorItems.length} 个</span>}
								</div>
								<p class="hint">
									这里展示了部分指针。下载压缩包后，还可以查看每个指针的动图预览。
								</p>
							</>
						)}
					</div>
				)}
				{artworks.length > 0 && (
					<>
						<h2>画作（{artworks.length}）</h2>
						<p class="hint">点开看大图。表情包与周边素材也一并放在这里。</p>
						<GalleryWall items={artworks} minHeight={260} layout="even" />
					</>
				)}
				{episodes.length > 0 && (
					<>
						<h2>出场故事（{episodes.length}）</h2>
						<ul>
							{episodes.map((episode) => (
								<li>
									<a href={`/worldview/stories/${episode.id}/`}>
										{episode.data.code} {episode.data.title}
									</a>
								</li>
							))}
						</ul>
					</>
				)}
				{relatedLore.length > 0 && (
					<>
						<h2>关联设定</h2>
						<ul>
							{relatedLore.map((item) => (
								<li>
									<a href={`/worldview/lore/${item.id}/`}>{item.data.title}</a>
								</li>
							))}
						</ul>
					</>
				)}
			</div>
		)
	}
</DetailPage>

<style>
	.relations {
		margin: 3em 0 0;
		padding-top: 1.5em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.relations h2 {
		margin: 0 0 0.9em;
		font-size: 1.05em;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
	}
	.relations ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.relations li {
		display: grid;
		grid-template-columns: 10em 1fr;
		gap: 0.4em 1.2em;
		padding: 0.7em 0;
		border-bottom: 1px dashed rgb(var(--gray-light));
		font-size: 0.9em;
	}
	.relations li:last-child {
		border-bottom: none;
	}
	.relations .who a {
		color: var(--rel-color);
		text-decoration: none;
	}
	.relations .who a:hover {
		color: var(--glow);
	}
	.relations .note {
		color: rgb(var(--gray));
		font-size: 0.95em;
		line-height: 1.7;
	}
	.related .kind {
		margin-left: 0.5em;
		font-size: 0.8em;
		opacity: 0.65;
	}
	.related .hint {
		margin: 0.4em 0 0;
		font-size: 0.82em;
		line-height: 1.7;
		color: rgb(var(--gray));
	}

	/* 数字资源：可下载的指针包之类，排在画作之上 */
	.res-block {
		margin-bottom: 2.4em;
	}
	.res-list {
		display: grid;
		/*
		 * 卡片宽度贴着内容走。
		 * 之前上限放到 480px，而内容（92 缩略图 + 文字）只占 ~420px，
		 * 于是内容偏在框的左侧、右边空一大片，看起来像「没落在框里」。
		 * 收到 420px 之后，圆角框正好包住缩略图与文字，左右留白也对称。
		 */
		grid-template-columns: repeat(auto-fill, minmax(320px, 420px));
		gap: 1em;
		margin-top: 0.8em;
	}
	.res-card {
		display: grid;
		grid-template-columns: 92px minmax(0, 1fr);
		align-items: center;
		gap: 1em;
		/*
		 * 左右两侧给足内缩：这个框是个圆角胶囊，内容只内缩 1.1em 时会紧贴左内缘，
		 * 看上去像压在弧线上。加到 1.9em，缩略图与文字就完整落在圆角以内了。
		 * 上下保持 0.9em —— 框高由内容决定，不需要额外留白。
		 */
		padding: 0.9em 1.9em;
		border-radius: 14px;
		text-decoration: none;
		color: inherit;
		background: linear-gradient(135deg, rgba(175, 255, 255, 10%), rgba(175, 255, 255, 3%));
		border: 1px solid rgba(175, 255, 255, 26%);
		transition: 0.18s ease;
	}
	.res-card:hover {
		border-color: rgba(175, 255, 255, 55%);
		box-shadow: var(--glow-shadow);
		transform: translateY(-2px);
	}
	/* 缩略图固定占第一列，图片本身撑满这一格 */
	.res-card .res-thumb {
		display: block;
		width: 92px;
		height: 92px;
		border-radius: 8px;
		overflow: hidden;
		background: rgba(6, 20, 28, 40%);
	}
	.res-card :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}
	.res-body {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		min-width: 0;
	}
	.res-label {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 1.02em;
		font-weight: 700;
		color: var(--glow);
	}
	.res-dl {
		font-size: 0.9em;
		opacity: 0.8;
	}
	.res-note {
		font-size: 0.84em;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
	}
	.res-meta {
		font-size: 0.78em;
		letter-spacing: 0.04em;
		color: var(--accent);
	}
	/* 指针样式预览：只在资源框里露几个，不混进画作墙 */
	.res-preview {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6em;
		margin-top: 1em;
	}
	.res-preview :global(img) {
		width: 54px;
		height: 54px;
		object-fit: contain;
		border-radius: 10px;
		background: rgba(6, 20, 28, 45%);
		border: 1px solid rgb(var(--gray-light));
	}
	.res-more {
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		.relations li {
			grid-template-columns: 1fr;
		}
		.res-list {
			grid-template-columns: 1fr;
		}
		.res-card :global(img) {
			width: 74px;
			height: 74px;
		}
	}
</style>
