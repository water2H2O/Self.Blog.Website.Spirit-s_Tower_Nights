---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import CharacterCard from '../../../components/CharacterCard.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';

const characters = (await getCollection('characters', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name, 'zh-Hans-CN'),
);
const races = (await getCollection('races', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);

/**
 * 按种族分组 —— 呼应用户“先定种族”的创作流程。
 * 同源的种族并到一行显示：天翼种由风元素精灵演化而来，所以两支合成
 * 「元素精灵 / 天翼种」一组。
 */
const COMBOS: { ids: string[]; label: string }[] = [
	{ ids: ['elemental-spirit', 'winged'], label: '元素精灵 / 天翼种' },
];

const raceById = new Map(races.map((race) => [race.id, race]));
const used = new Set<string>();
const groups: {
	label: string;
	links: { href: string; text: string }[];
	epithets: string[];
	color: string;
	members: typeof characters;
}[] = [];

// 先放合并组
for (const combo of COMBOS) {
	const present = combo.ids.filter((id) => raceById.has(id));
	if (present.length === 0) continue;
	const members = characters.filter((character) => present.includes(character.data.race?.id ?? ''));
	if (members.length === 0) continue;
	for (const id of present) used.add(id);
	groups.push({
		label: combo.label,
		links: present.map((id) => ({ href: `/worldview/races/${id}/`, text: raceById.get(id)!.data.name })),
		epithets: present.map((id) => raceById.get(id)!.data.epithet ?? '').filter(Boolean),
		color: raceById.get(present[0])!.data.themeColor,
		members,
	});
}

// 再放单独的种族
for (const race of races) {
	if (used.has(race.id)) continue;
	const members = characters.filter((character) => character.data.race?.id === race.id);
	if (members.length === 0) continue;
	groups.push({
		label: race.data.name,
		links: [{ href: `/worldview/races/${race.id}/`, text: race.data.name }],
		epithets: race.data.epithet ? [race.data.epithet] : [],
		color: race.data.themeColor,
		members,
	});
}

const known = new Set(groups.flatMap((group) => group.members.map((m) => m.id)));
const ungrouped = characters.filter((character) => !known.has(character.id));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="角色"
			description="水塔夜谈的角色档案：按种族分组，含立绘、称号、性格与关联设定。"
		/>
		<style>
			main {
				width: 1060px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			section {
				margin-top: 2.8em;
			}
			.race-head {
				display: flex;
				align-items: baseline;
				gap: 0.8em;
				flex-wrap: wrap;
				padding-bottom: 0.5em;
				margin-bottom: 1.4em;
				border-bottom: 2px solid color-mix(in srgb, var(--race-color) 40%, transparent);
			}
			.race-head h2 {
				margin: 0;
				font-size: 1.5em;
			}
			.race-head a {
				text-decoration: none;
				color: var(--race-color);
			}
			.race-head a:hover {
				color: var(--glow);
			}
			/* 同源种族合并显示时的分隔符 */
			.race-head .sep {
				color: rgb(var(--gray));
				font-weight: 400;
			}
			.race-head .epithet {
				font-size: 0.78em;
				letter-spacing: 0.06em;
				color: rgb(var(--gray));
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 1.5rem;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>角色</h1>
			<p class="lead">
				{characters.length} 位角色，按种族分组。点开任意一位，可以看到 TA 的设定、出处、画作与出场故事。
			</p>

			{
				groups.map((group) => (
					<section style={`--race-color:${group.color}`}>
						<div class="race-head">
							<h2>
								{group.links.map((link, index) => (
									<>
										{index > 0 && <span class="sep"> / </span>}
										<a href={link.href}>{link.text}</a>
									</>
								))}
							</h2>
							{group.epithets.length > 0 && (
								<span class="epithet">{group.epithets.map((e) => `[${e}]`).join(' ')}</span>
							)}
						</div>
						<div class="grid">
							{group.members.map((character) => (
								<CharacterCard entry={character} />
							))}
						</div>
					</section>
				))
			}

			{
				ungrouped.length > 0 && (
					<section>
						<div class="race-head">
							<h2>种族未定</h2>
						</div>
						<div class="grid">
							{ungrouped.map((character) => (
								<CharacterCard entry={character} />
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
