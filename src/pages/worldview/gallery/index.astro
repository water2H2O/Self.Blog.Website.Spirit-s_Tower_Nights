---
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import GalleryWall from '../../../components/GalleryWall.astro';
import Header from '../../../components/Header.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../../../consts';
import meta from '../../../data/gallery-meta.json';

/** 每次访问从图池里抽多少张 */
const SAMPLE_SIZE = 60;
/** 不参与照片墙的分类（鼠标指针套装等周边素材，留在图池但不铺墙） */
const EXCLUDED_KINDS = ['指针'];

const POOL = path.join(process.cwd(), 'public', 'gallery');
const stored = (meta as { items?: Record<string, Record<string, unknown>> }).items ?? {};

const items = fs
	.readdirSync(POOL)
	.filter((file) => /\.webp$/i.test(file))
	.sort()
	.map((file) => {
		const info = stored[file] ?? {};
		const w = Number(info.w) || 0;
		const h = Number(info.h) || 0;
		return {
			url: `/gallery/${encodeURIComponent(file)}`,
			ar: w > 0 && h > 0 ? Number((w / h).toFixed(3)) : 1,
			ownership: String(info.ownership ?? '其他'),
			owner: String(info.owner ?? ''),
			kind: String(info.kind ?? '其他'),
			character: String(info.character ?? ''),
			title: String(info.title ?? ''),
		};
	})
	.filter((item) => !EXCLUDED_KINDS.includes(item.kind));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="画廊"
			description={`${SITE_TITLE} 的图池：原创设定、联动设定、企划与插画。`}
		/>
		<style>
			main {
				width: min(1280px, 94vw);
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.88em;
			}
			.notice {
				margin: 1em 0 0;
				padding: 0.85em 1.05em;
				border-radius: 12px;
				font-size: 0.8em;
				line-height: 1.8;
				color: #ffd68a;
				background: rgba(255, 200, 90, 8%);
				border: 1px solid rgba(255, 200, 90, 28%);
			}
			.notice strong {
				color: #ffe6ad;
			}
			.notice a {
				color: #ffe6ad;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>画廊</h1>
			<p class="lead">
				图池共 {items.length} 张，每次打开随机抽 {SAMPLE_SIZE} 张铺成照片墙 —— 大小、横竖、顺序都随机，刷新即换。
			</p>
			<p class="lead">（鼠标指针套装等周边素材不参与铺墙，只留在图池里。）</p>
			<p class="notice">
				<strong>图片不适用 CC BY 4.0。</strong>
				原创设定版权归我（{SITE_AUTHOR}）所有；<strong>联动设定版权归各设主所有</strong>
				（已在图上标出）；企划是「水塔 OC 补完计划」的成品；委托插画版权归原画师。<a
					href="/license/">详见授权说明</a
				>。
			</p>

			<GalleryWall items={items} sampleSize={SAMPLE_SIZE} showFilters kindSizing minHeight={420} />
		</main>
		<Footer />
	</body>
</html>
