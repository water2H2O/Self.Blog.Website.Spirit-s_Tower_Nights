---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import LoreCard from '../../../components/LoreCard.astro';
import { FACTION_CATEGORY, LORE_CATEGORIES } from '../../../lib/lore';

const lore = await getCollection('lore', ({ data }) => !data.draft);

const groups = LORE_CATEGORIES.map((category) => ({
	category,
	items: lore
		.filter((entry) => entry.data.category === category)
		.sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN')),
})).filter((group) => group.items.length > 0);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="世界观"
			description="Spirit's Tower Nights 的设定集：种族、体系、势力、组织与历史。"
		/>
		<style>
			main {
				width: 1000px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			section {
				margin-top: 0;
			}
			section h2 {
				font-size: 1.15em;
				margin: 0 0 1em;
				padding-left: 0.6em;
				border-left: 4px solid var(--accent);
			}
			/* 「势力」这一类另有子页，标题右边挂个入口 */
			section h2 .more {
				margin-left: 0.5em;
				font-size: 0.72em;
				font-weight: 400;
				letter-spacing: 0.04em;
				text-decoration: none;
				color: var(--accent);
				white-space: nowrap;
			}
			section h2 .more:hover {
				color: var(--glow);
			}
			/*
			 * 类目块并排排布。
			 *
			 * 13 条设定分在 7 个类目里，其中 4 个只有 1 条 —— 每个类目独占一行时，
			 * 会出现「一行只有一个格子、右边全空」的情况。
			 *
			 * 这里用 CSS 多列而不是 grid：grid 里同一行的块会被最高的那个撑高，
			 * 短块下面照样留空；多列由浏览器按内容高度均衡分栏，空隙最少。
			 */
			.groups {
				column-width: 292px;
				column-gap: 2.8em;
				margin-top: 3em;
			}
			.groups section {
				/* 一个类目不要被拆到两栏去 */
				break-inside: avoid;
				margin-bottom: 2.8em;
			}
			/* 类目内部竖排 */
			.grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.35rem;
			}
			.empty {
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.groups {
					column-width: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>世界观</h1>
			<p class="lead">
				{lore.length} 条设定。按类别分组；每条设定都可以关联角色，角色页也会反向指回来。
			</p>
			<div class="groups">
				{
					groups.length > 0 ? (
						groups.map((group) => (
							<section id={group.category === FACTION_CATEGORY ? 'lore-faction' : undefined}>
								<h2>
									{group.category}（{group.items.length}）
									{group.category === FACTION_CATEGORY && (
										<a class="more" href="/worldview/lore/factions/">
											单独一页 →
										</a>
									)}
								</h2>
								<div class="grid">
									{group.items.map((entry) => (
										<LoreCard entry={entry} />
									))}
								</div>
							</section>
						))
					) : (
						<p class="empty">
							还没有设定条目。在 <code>src/content/lore/</code> 下新建一个 markdown 文件即可。
						</p>
					)
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
