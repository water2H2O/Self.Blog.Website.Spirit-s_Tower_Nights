---
import { getCollection } from 'astro:content';
import BaseHead from '../../../../components/BaseHead.astro';
import Footer from '../../../../components/Footer.astro';
import Header from '../../../../components/Header.astro';
import LoreCard from '../../../../components/LoreCard.astro';
import { FACTION_CATEGORY } from '../../../../lib/lore';

/**
 * 设定 › 势力：把 category 为「势力」的条目单独摊一页。
 *
 * 势力这一支后面会越写越多（国家、组织、城邦、势力范围…），
 * 混在设定索引的七栏里会不好找，所以给它一个自己的页面，
 * 侧栏里也单独展开成一小组。
 */

const items = (await getCollection('lore', ({ data }) => !data.draft && data.category === FACTION_CATEGORY)).sort(
	(a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`势力 · 世界观`}
			description={`Spirit's Tower Nights 的势力条目：国家、组织、城邦与势力范围 —— 共 ${items.length} 条。`}
		/>
		<style>
			main {
				width: 1000px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
				line-height: 1.9;
			}
			.lead a {
				color: var(--accent);
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(292px, 1fr));
				gap: 1.35rem;
				margin-top: 2.4em;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>势力</h1>
			<p class="lead">
				{items.length} 条。国家、组织、城邦与势力范围都归在这里 —— 与设定索引里的「{FACTION_CATEGORY}」是同一批条目，
				建成一页是为了这一支以后能一直往下写。完整类目见<a href="/worldview/lore/">设定</a>。
			</p>
			<div class="grid">
				{
					items.length > 0 ? (
						items.map((entry) => <LoreCard entry={entry} />)
					) : (
						<p class="empty">
							还没有势力条目。在 <code>src/content/lore/</code> 下新建一个 markdown 文件、写
							<code>category: {FACTION_CATEGORY}</code> 即可。
						</p>
					)
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
