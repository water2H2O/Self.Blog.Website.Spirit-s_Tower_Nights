---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_AUTHOR } from '../../../consts';

const tracks = (await getCollection('music', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.number - b.data.number,
);
const characters = await getCollection('characters');
const characterName = new Map(characters.map((c) => [c.id, c.data.name]));

const totalDuration = tracks.reduce((sum, track) => {
	const [m, s] = (track.data.duration ?? '0:0').split(':').map(Number);
	return sum + m * 60 + (s || 0);
}, 0);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="音乐"
			description="水塔夜谈原创音乐企划：与不同曲师合作的曲目、曲绘与创作笔记。"
		/>
		<style>
			main {
				width: 900px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.notice {
				margin: 1.5em 0 0;
				padding: 0.9em 1.1em;
				border-radius: 12px;
				font-size: 0.84em;
				line-height: 1.8;
				color: #ffd68a;
				background: rgba(255, 200, 90, 8%);
				border: 1px solid rgba(255, 200, 90, 28%);
			}
			.notice strong {
				color: #ffe6ad;
			}
			.notice a {
				color: #ffe6ad;
			}
			.track {
				display: grid;
				grid-template-columns: 240px 1fr;
				gap: 1.5em;
				margin-top: 2.2em;
				padding: 1.3em;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid var(--track-color);
			}
			.cover {
				overflow: hidden;
				border-radius: 10px;
			}
			.cover :global(img) {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 10px;
			}
			.info h2 {
				margin: 0;
				font-size: 1.4em;
			}
			.no {
				font-size: 0.75em;
				letter-spacing: 0.14em;
				color: var(--track-color);
			}
			.artist {
				margin: 0.3em 0 0;
				font-size: 0.88em;
				color: rgb(var(--gray));
			}
			.artist b {
				color: var(--glow);
				font-weight: 400;
			}
			audio {
				width: 100%;
				margin-top: 0.9em;
				filter: invert(92%) hue-rotate(160deg);
			}
			.tags {
				margin-top: 0.7em;
				font-size: 0.78em;
				color: rgb(var(--gray));
			}
			.links {
				margin: 0.7em 0 0;
				font-size: 0.85em;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em 1.2em;
			}
			.note {
				margin: 0.7em 0 0;
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.track {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>音乐</h1>
			<p class="lead">
				这是一个 OC 世界观音乐企划：{tracks.length} 首曲子，每一首都与不同的曲师合作，并配有专属曲绘。
				总时长约 {Math.floor(totalDuration / 60)} 分钟。
			</p>

			<p class="notice">
				<strong>版权提示：本站音乐不适用 CC BY 4.0。</strong>
				全部曲目均为与曲师合作的委托 / 共创作品，版权由各曲师与企划共同所有。
				如需转载、商用、二创或用于视频配乐，请先<a href="/license/">阅读授权说明</a>并联系我（{SITE_AUTHOR}）。
			</p>

			{
				tracks.map((track) => (
					<article class="track" style={`--track-color:${track.data.themeColor}`}>
						{track.data.cover && (
							<div class="cover">
								<Image src={track.data.cover} alt={track.data.title} width={480} />
							</div>
						)}
						<div class="info">
							<span class="no">
								#{String(track.data.number).padStart(2, '0')}
								{track.data.duration && ` · ${track.data.duration}`}
							</span>
							<h2>{track.data.title}</h2>
							<p class="artist">
								曲师 <b>{track.data.artist}</b>
								{track.data.characters.length > 0 &&
									` ／ 关联角色 ${track.data.characters
										.map((ref) => characterName.get(ref.id) ?? ref.id)
										.join('、')}`}
							</p>
							{track.data.audio ? (
								<audio controls preload="none">
									<source src={track.data.audio} type="audio/mpeg" />
									{track.data.audioAlt && (
										<source src={track.data.audioAlt} type={track.data.audioAltType ?? 'audio/ogg'} />
									)}
									你的浏览器不支持音频播放。
								</audio>
							) : (
								<p class="note">音频制作中。</p>
							)}
							{track.data.tags.length > 0 && <p class="tags">{track.data.tags.join(' · ')}</p>}
							{track.data.pvUrl && (
								<p class="links">
									<a href={track.data.pvUrl} target="_blank" rel="noreferrer">
										观看 PV →
									</a>
								</p>
							)}
							{track.data.note && <p class="note">{track.data.note}</p>}
						</div>
					</article>
				))
			}
		</main>
		<Footer />
	</body>
</html>
