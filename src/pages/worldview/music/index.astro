---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';

const tracks = (await getCollection('music', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.number - b.data.number,
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="回响之殿"
			description="水塔夜谈音乐企划：与不同曲师合作的曲目与曲绘。"
		/>
		<style>
			main {
				width: 880px;
			}
			.tracks {
				list-style: none;
				margin: 1.5em 0 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.1em;
			}
			.track {
				display: grid;
				grid-template-columns: 320px 1fr;
				gap: 1.4em;
				padding: 1em;
				border-radius: 14px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				transition: 0.2s ease;
			}
			.track:hover {
				border-color: rgba(175, 255, 255, 38%);
				box-shadow: var(--glow-shadow);
			}
			/* 曲绘预览：撑满整行高度（详情页另有全图展示） */
			.cover {
				position: relative;
				display: block;
				border-radius: 10px;
				overflow: hidden;
				align-self: stretch;
				min-height: 176px;
			}
			.cover :global(img) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 10px;
			}
			.cover::after {
				content: '▶';
				position: absolute;
				inset: 0;
				display: grid;
				place-items: center;
				font-size: 1.6em;
				color: var(--glow);
				background: rgba(6, 14, 22, 55%);
				opacity: 0;
				transition: 0.2s ease;
			}
			.cover:hover::after {
				opacity: 1;
			}
			.info {
				min-width: 0;
			}
			.no {
				font-size: 0.78em;
				letter-spacing: 0.12em;
				color: rgb(var(--gray));
			}
			.info h2 {
				margin: 0.15em 0 0.3em;
				font-size: 1.35em;
				line-height: 1.3;
			}
			.info h2 a {
				text-decoration: none;
				color: rgb(var(--black));
			}
			.info h2 a:hover {
				color: var(--glow);
			}
			.artist {
				margin: 0 0 0.7em;
				font-size: 0.86em;
				color: rgb(var(--gray));
			}
			.artist a {
				color: var(--accent);
				text-decoration: none;
			}
			.artist a:hover {
				color: var(--glow);
			}
			audio {
				width: 100%;
				height: 34px;
				filter: invert(92%) hue-rotate(160deg);
			}
			@media (max-width: 640px) {
				.track {
					grid-template-columns: 210px 1fr;
					gap: 1em;
				}
				.cover {
					min-height: 130px;
				}
				.info h2 {
					font-size: 1.15em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>回响之殿</h1>
			<ul class="tracks">
				{
					tracks.map((track) => (
						<li class="track">
							<a class="cover" href={`/worldview/music/${track.id}/`} aria-label={track.data.title}>
								{track.data.cover ? (
									<Image src={track.data.cover} alt={track.data.title} width={320} />
								) : (
									<span />
								)}
							</a>
							<div class="info">
								<span class="no">
									#{String(track.data.number).padStart(2, '0')}
									{track.data.duration && ` · ${track.data.duration}`}
								</span>
								<h2>
									<a href={`/worldview/music/${track.id}/`}>{track.data.title}</a>
								</h2>
								<p class="artist">
									曲师{' '}
									{track.data.artistUrl ? (
										<a href={track.data.artistUrl} target="_blank" rel="noreferrer">
											{track.data.artist}
										</a>
									) : (
										track.data.artist
									)}
								</p>
								{track.data.audio && (
									<audio controls preload="none">
										<source src={track.data.audio} type="audio/mpeg" />
										{track.data.audioAlt && (
											<source src={track.data.audioAlt} type={track.data.audioAltType ?? 'audio/ogg'} />
										)}
										你的浏览器不支持音频播放。
									</audio>
								)}
							</div>
						</li>
					))
				}
			</ul>

			<p class="license-note">
				<strong>本站音乐不适用 CC BY 4.0</strong>
				—— 全部曲目为与曲师合作的委托 / 共创作品，版权由各曲师与企划共同所有。
				如需使用请先<a href="/license/">阅读授权说明</a>。
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.license-note {
		margin-top: 2.5em;
		padding: 0.9em 1.1em;
		border-radius: 12px;
		font-size: 0.82em;
		line-height: 1.8;
		color: #ffd68a;
		background: rgba(255, 200, 90, 8%);
		border: 1px solid rgba(255, 200, 90, 28%);
	}
	.license-note strong {
		color: #ffe6ad;
	}
	.license-note a {
		color: #ffe6ad;
	}
</style>
