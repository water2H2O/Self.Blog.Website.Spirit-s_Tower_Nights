---
import { render } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import SpoilerNote from '../../../components/SpoilerNote.astro';
import { publishedEpisodes } from '../../../lib/stories';

export async function getStaticPaths() {
	const episodes = await publishedEpisodes();
	return episodes.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const episodes = await publishedEpisodes();
const position = episodes.findIndex((item) => item.id === entry.id);
const prev = position > 0 ? episodes[position - 1] : null;
const next = position < episodes.length - 1 ? episodes[position + 1] : null;

const { title, act, arc, code, author, summary, spoiler, updatedDate, pubDate } = entry.data;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${code} ${title} · ${arc}`} description={summary ?? `${arc} ${code}`} />
		<style>
			main {
				width: 720px;
			}
			.crumb {
				display: inline-block;
				margin-bottom: 1.6em;
				font-size: 0.78em;
				color: rgb(var(--gray));
				text-decoration: none;
				letter-spacing: 0.04em;
			}
			.crumb:hover {
				color: var(--glow);
			}
			/* 标题区：居中、软化，读长篇时不必一上来就撞到一条硬线 */
			.title {
				margin: 0 0 0.6em;
				text-align: center;
				line-height: 1.35;
			}
			.title .code {
				display: block;
				margin-bottom: 0.5em;
				font-size: 0.42em;
				letter-spacing: 0.3em;
				text-indent: 0.3em;
				color: var(--glow);
				opacity: 0.7;
			}
			.meta {
				margin: 0 0 2.8em;
				text-align: center;
				font-size: 0.78em;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
			}
			.meta .by {
				color: var(--accent);
			}
			.meta .sep {
				margin: 0 0.5em;
				opacity: 0.5;
			}

			/* 正文：按中文长文的读法来 —— 首行缩进、行距放宽、行长收窄 */
			.prose {
				color: rgb(var(--gray-dark));
				font-size: 1.03em;
				line-height: 2;
			}
			.prose :global(p) {
				margin: 0 0 0.9em;
				text-indent: 2em;
				text-align: justify;
				text-justify: inter-ideograph;
			}
			/* 篇内分幕这类小标题：居中，两侧加装饰线 */
			.prose :global(h2),
			.prose :global(h3) {
				margin: 2.6em 0 1.4em;
				font-size: 1.05em;
				font-weight: 400;
				letter-spacing: 0.18em;
				text-align: center;
				color: var(--accent);
			}
			.prose :global(h2)::before,
			.prose :global(h2)::after {
				content: '';
				display: inline-block;
				width: 2.2em;
				height: 1px;
				margin: 0 0.8em;
				vertical-align: 0.35em;
				background: currentColor;
				opacity: 0.35;
			}
			/* 场景分隔：中间一颗小点，比一条横线轻 */
			.prose :global(hr) {
				width: auto;
				margin: 2.6em auto;
				border: none;
				text-align: center;
				overflow: visible;
			}
			.prose :global(hr)::after {
				content: '· · ·';
				letter-spacing: 0.6em;
				text-indent: 0.6em;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.prose :global(blockquote) {
				margin: 1.6em 0;
				padding: 0.2em 0 0.2em 1.2em;
				border-left: 2px solid rgba(175, 255, 255, 30%);
				color: rgb(var(--gray));
			}
			.prose :global(blockquote p) {
				text-indent: 0;
			}

			.pager {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				margin-top: 4em;
				padding-top: 1.6em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.pager a {
				flex: 1 1 0;
				padding: 0.9em 1.1em;
				border-radius: 12px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				text-decoration: none;
				color: rgb(var(--gray-dark));
				font-size: 0.86em;
				transition: 0.2s ease;
			}
			.pager a:hover {
				border-color: rgba(175, 255, 255, 45%);
				box-shadow: var(--glow-shadow);
			}
			.pager a.next {
				text-align: right;
			}
			.pager .dir {
				display: block;
				font-size: 0.8em;
				letter-spacing: 0.1em;
				color: rgb(var(--gray));
			}
			.pager .name {
				color: var(--glow);
			}
			@media (max-width: 720px) {
				.prose {
					font-size: 1em;
					line-height: 1.9;
				}
				.pager {
					flex-direction: column;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="crumb" href="/worldview/stories/">← 故事目录 ／ {act} ／ {arc}</a>
			<h1 class="title">
				<span class="code">{code}</span>
				{title}
			</h1>
			<p class="meta">
				<span class="by">作者 {author}</span>
				<span class="sep">·</span>
				<span>第 {position + 1} / {episodes.length} 话</span>
				{updatedDate && <span class="sep">·</span>}
				{updatedDate && <span>修订于 {updatedDate.toLocaleDateString('zh-CN')}</span>}
				{pubDate && <span class="sep">·</span>}
				{pubDate && <span>{pubDate.toLocaleDateString('zh-CN')}</span>}
			</p>
			<SpoilerNote level={spoiler} />
			<div class="prose">
				<Content />
			</div>

			<nav class="pager">
				{
					prev ? (
						<a href={`/worldview/stories/${prev.id}/`}>
							<span class="dir">← 上一篇</span>
							<span class="name">{prev.data.code} {prev.data.title}</span>
						</a>
					) : (
						<span></span>
					)
				}
				{
					next ? (
						<a class="next" href={`/worldview/stories/${next.id}/`}>
							<span class="dir">下一篇 →</span>
							<span class="name">{next.data.code} {next.data.title}</span>
						</a>
					) : (
						<span></span>
					)
				}
			</nav>
		</main>
		<Footer />
	</body>
</html>
