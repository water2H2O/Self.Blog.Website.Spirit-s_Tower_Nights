---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { groupByArc, publishedEpisodes } from '../../../lib/stories';

const episodes = await publishedEpisodes();
const acts = groupByArc(episodes);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="故事"
			description="水塔夜谈主线正文，按“幕 → 篇 → 话”组织。"
		/>
		<style>
			main {
				width: 900px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.92em;
			}
			.act {
				margin-top: 3em;
			}
			.act > h2 {
				margin: 0 0 0.2em;
				font-size: 1.7em;
				color: var(--glow);
			}
			.act > .act-meta {
				margin: 0 0 1.5em;
				font-size: 0.8em;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.arc {
				margin: 0 0 1.8em;
				padding-left: 1em;
				border-left: 2px solid rgba(175, 255, 255, 18%);
			}
			.arc h3 {
				margin: 0 0 0.6em;
				font-size: 1.05em;
				letter-spacing: 0.04em;
				color: var(--accent);
			}
			.arc ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.arc li {
				display: flex;
				align-items: baseline;
				gap: 0.9em;
				padding: 0.55em 0;
				border-bottom: 1px dashed rgb(var(--gray-light));
			}
			.arc li:last-child {
				border-bottom: none;
			}
			.code {
				flex: none;
				width: 4.2em;
				font-size: 0.78em;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
			}
			.arc a {
				text-decoration: none;
				color: rgb(var(--black));
			}
			.arc a:hover {
				color: var(--glow);
			}
			/* 非本人执笔的话，在标题后面标出作者 */
			.author {
				margin-left: 0.6em;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.04em;
				color: #ffd68a;
				background: rgba(255, 200, 90, 12%);
				border: 1px solid rgba(255, 200, 90, 28%);
				white-space: nowrap;
			}
			.summary {
				display: block;
				margin-top: 0.15em;
				font-size: 0.82em;
				line-height: 1.6;
				color: rgb(var(--gray));
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>故事</h1>
			<p class="lead">
				共 {episodes.length} 话。按“幕 → 篇 → 话”组织；点开任意一话即为正文，页底可以翻到上一篇 / 下一篇。
			</p>
			{
				acts.length > 0 ? (
					acts.map((act) => (
						<section class="act">
							<h2>{act.act}</h2>
							<p class="act-meta">
								{act.arcs.length} 篇 ·{' '}
								{act.arcs.reduce((sum, arc) => sum + arc.episodes.length, 0)} 话
							</p>
							{act.arcs.map((arc) => (
								<div class="arc">
									<h3>{arc.arc}</h3>
									<ul>
										{arc.episodes.map((episode) => (
											<li>
												<span class="code">{episode.data.code}</span>
												<span class="entry">
													<a href={`/worldview/stories/${episode.id}/`}>{episode.data.title}</a>
													{episode.data.author !== '水水' && (
														<span class="author">{episode.data.author}</span>
													)}
													{episode.data.summary && <span class="summary">{episode.data.summary}</span>}
												</span>
											</li>
										))}
									</ul>
								</div>
							))}
						</section>
					))
				) : (
					<p class="empty">还没有正文。把文稿放进 src/content/stories/ 即可。</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
