---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import StoriesTabs from '../../../components/StoriesTabs.astro';
import StoryToc from '../../../components/StoryToc.astro';
import { groupByArc, publishedEpisodes } from '../../../lib/stories';

const episodes = await publishedEpisodes();
const acts = groupByArc(episodes);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="故事"
			description="水塔夜谈的主线故事。按幕、篇、话排列，从目录选择一话开始阅读。"
		/>
		<style>
			main {
				width: 900px;
			}
			.lead {
				color: rgb(var(--gray));
				font-size: 0.92em;
			}
			.act {
				margin-top: 3em;
			}
			.act > h2 {
				margin: 0 0 0.2em;
				font-size: 1.7em;
				color: var(--glow);
			}
			.act > .act-meta {
				margin: 0 0 1.5em;
				font-size: 0.8em;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.arc {
				margin: 0 0 1.8em;
				padding-left: 1em;
				border-left: 2px solid rgba(175, 255, 255, 18%);
			}
			.arc h3 {
				margin: 0 0 0.6em;
				font-size: 1.05em;
				letter-spacing: 0.04em;
				color: var(--accent);
			}
			.arc ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.arc li {
				display: flex;
				align-items: baseline;
				gap: 0.9em;
				padding: 0.55em 0;
				border-bottom: 1px dashed rgb(var(--gray-light));
			}
			.arc li:last-child {
				border-bottom: none;
			}
			.code {
				flex: none;
				width: 4.2em;
				font-size: 0.78em;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
			}
			.arc a {
				text-decoration: none;
				color: rgb(var(--black));
			}
			.arc a:hover {
				color: var(--glow);
			}
			/* 非本人执笔的话，在标题后面标出作者 */
			.author {
				margin-left: 0.6em;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				font-size: 0.72em;
				letter-spacing: 0.04em;
				color: #ffd68a;
				background: rgba(255, 200, 90, 12%);
				border: 1px solid rgba(255, 200, 90, 28%);
				white-space: nowrap;
			}
			.summary {
				display: block;
				margin-top: 0.15em;
				font-size: 0.82em;
				line-height: 1.6;
				color: rgb(var(--gray));
			}
			.empty {
				color: rgb(var(--gray));
			}
			/*
			 * 手机上话数很多，标题本身只有一行 24px 高，手指很难点准。
			 * 把「话」的链接撑成整行可点，行高过 44px。
			 */
			@media (max-width: 720px) {
				.arc {
					padding-left: 0.8em;
				}
				.arc li {
					gap: 0.7em;
					padding: 0;
				}
				.arc li .entry {
					flex: 1;
					min-width: 0;
				}
				.arc a {
					display: block;
					padding: 0.65em 0 0.15em;
				}
				.code {
					padding-top: 0.8em;
				}
				.summary {
					margin-top: 0;
					padding-bottom: 0.65em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<StoriesTabs current="stories" />
			<h1>故事</h1>
			<p class="lead">
				共 {episodes.length} 话，按幕、篇、话排列。选一话开始读，读完可以在页底继续翻到下一话。
			</p>

			{/* 窄屏才出现的折叠目录：58 话在手机上滚起来太长 */}
			<StoryToc />
			{
				acts.length > 0 ? (
					acts.map((act) => (
						<section class="act">
							<h2>{act.act}</h2>
							<p class="act-meta">
								{act.arcs.length} 篇 ·{' '}
								{act.arcs.reduce((sum, arc) => sum + arc.episodes.length, 0)} 话
							</p>
							{act.arcs.map((arc) => (
								<div class="arc" id={arc.id}>
									<h3>{arc.arc}</h3>
									<ul>
										{arc.episodes.map((episode) => (
											<li>
												<span class="code">{episode.data.code}</span>
												<span class="entry">
													<a href={`/worldview/stories/${episode.id}/`}>{episode.data.title}</a>
													{episode.data.author !== '水水' && (
														<span class="author">{episode.data.author}</span>
													)}
													{episode.data.summary && <span class="summary">{episode.data.summary}</span>}
												</span>
											</li>
										))}
									</ul>
								</div>
							))}
						</section>
					))
				) : (
					<p class="empty">暂时还没有公开的故事正文。</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
