---
interface Props {
	level?: 'none' | 'mild' | 'heavy';
}

const { level = 'none' } = Astro.props;

const text =
	level === 'heavy'
		? '这里会提到重要剧情，建议读完相关故事后再看。'
		: level === 'mild'
			? '这里会提到少量剧情，请留意剧透。'
			: '';
---

{
	level !== 'none' && (
		<aside class:list={['spoiler', level]}>
			<span class="dot" aria-hidden="true" />
			{text}
		</aside>
	)
}

<style>
	.spoiler {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin: 0.8em 0;
		padding: 0.5em 0.9em;
		border-radius: 8px;
		font-size: 0.8em;
		line-height: 1.4;
	}
	.spoiler.mild {
		color: #ffd68a;
		background: rgba(255, 200, 90, 10%);
		border: 1px solid rgba(255, 200, 90, 30%);
	}
	.spoiler.heavy {
		color: #ff9d9d;
		background: rgba(255, 100, 100, 10%);
		border: 1px solid rgba(255, 100, 100, 32%);
	}
	.dot {
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background: currentColor;
		flex: none;
	}
</style>
