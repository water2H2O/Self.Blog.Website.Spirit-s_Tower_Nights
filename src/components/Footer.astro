---
import { GITHUB_URL, SITE_AUTHOR } from '../consts';

const today = new Date();
const CC_URL = 'https://creativecommons.org/licenses/by/4.0/deed.zh';
---

<footer>
	<p class="copy">
		&copy; {today.getFullYear()} {SITE_AUTHOR}。保留所有权利。<br />
		由我原创并有权授权、且明确标注为 <a href={CC_URL} target="_blank" rel="noreferrer">CC BY 4.0</a
		> 的内容，按 CC BY 4.0 授权。<br />
		<strong>音乐作品、委托作品与第三方素材不适用。</strong><br />
		详见 <a href="/license/">授权说明</a>。
	</p>
	<div class="social-links">
		<a href={GITHUB_URL} target="_blank" rel="noreferrer">
			<span class="sr-only">GitHub</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
				<path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path>
			</svg>
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.8em;
	}
	footer .copy {
		margin: 0;
		line-height: 1.9;
	}
	footer .copy strong {
		color: rgb(var(--gray-dark));
	}
	footer a {
		color: var(--accent);
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1.2em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
		display: flex;
	}
	.social-links a:hover {
		color: var(--glow);
	}
</style>
