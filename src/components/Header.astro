---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '../assets/oc/logo.webp';
import { GITHUB_URL, SITE_TITLE, WORLDVIEW_BASE } from '../consts';
import {
	LORE_CATEGORIES,
	LORE_CATEGORY_NOTES,
	type LoreCategory,
	loreCategoryHref,
} from '../lib/lore';
import { HANDBOOK_BASE, HANDBOOK_VOLUMES } from '../lib/handbook';

/**
 * 顶层导航：个人内容在根目录，世界观企划整体收在 /worldview/ 下。
 *
 * 结尾一律带 `/` —— 站上的页面都是「目录 + index.html」，
 * 少一个斜杠就会先吃一次 307 跳转（`/worldview` → `/worldview/`），
 * 每次点导航都多一个来回。`isActive` 会把斜杠去掉再比，所以照样能高亮。
 */
const mainLinks = [
	{ href: '/', label: '首页' },
	{ href: `${WORLDVIEW_BASE}/`, label: '世界观' },
	{ href: '/draw/', label: '抽签' },
	{ href: '/project/', label: '企划' },
	{ href: '/blog/', label: '随笔' },
	{ href: '/about/', label: '关于' },
];

/**
 * 世界观企划内部的二级导航，只在 /worldview/ 下显示。
 * 侧栏会展开当前所在那一栏的条目（见下面的 subItems）。同样带尾斜杠。
 */
const worldviewLinks = [
	{ href: `${WORLDVIEW_BASE}/`, label: '总览' },
	{ href: `${WORLDVIEW_BASE}/races/`, label: '种族' },
	{ href: `${WORLDVIEW_BASE}/characters/`, label: '角色' },
	{ href: `${WORLDVIEW_BASE}/lore/`, label: '设定' },
	{ href: `${WORLDVIEW_BASE}/stories/`, label: '故事' },
	{ href: `${WORLDVIEW_BASE}/gallery/`, label: '画廊' },
	{ href: `${WORLDVIEW_BASE}/music/`, label: '回响之殿' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const inWorldview = path === WORLDVIEW_BASE || path.startsWith(`${WORLDVIEW_BASE}/`);
const isActive = (href: string) => {
	const target = href.replace(/\/+$/, '') || '/';
	if (target === WORLDVIEW_BASE) return path === WORLDVIEW_BASE;
	return path === target || path.startsWith(`${target}/`);
};

/** 当前所在栏目，窄屏那个目录按钮上显示 */
const activeLabel = worldviewLinks.find((link) => isActive(link.href))?.label ?? '';

/**
 * 侧栏的二级目录。
 *
 * 学 wiki 的做法：**只展开当前所在的那一栏**，列出这一栏的条目。
 * 六栏全展开会有上百条（59 话、13 个种族、15 条设定…），侧栏会变成一堵墙。
 *
 * 「设定」那一栏再分一层：先按类目分组，组内才是条目 ——
 * 条目多了以后平铺着找不动，而类目名本身就是最好的目录。
 *
 * 「故事」特殊一些：只列当前这一篇里的话（篇号从 id 前缀取，例如
 * act1-birdcage-2-1 → act1-birdcage-2），这样在追一篇时能直接跳上下话。
 */
interface SubItem {
	href: string;
	label: string;
	active: boolean;
	/** 只当分组标签用（教材的卷标题），不做成链接 */
	heading?: boolean;
}

/** 设定目录里的一个类目组 */
interface SubGroup {
	label: string;
	href: string;
	active: boolean;
	note: string;
	items: SubItem[];
}

let subItems: SubItem[] = [];
/** 设定那一条专用的分组目录：一个类目一组，见上面的注释 */
let loreGroups: SubGroup[] = [];

if (inWorldview) {
	const section = path === WORLDVIEW_BASE ? '' : path.slice(WORLDVIEW_BASE.length + 1).split('/')[0];

	if (section === 'races') {
		const all = (await getCollection('races', ({ data }) => !data.draft)).sort(
			(a, b) => a.data.order - b.data.order,
		);
		subItems = all.map((entry) => ({
			href: `${WORLDVIEW_BASE}/races/${entry.id}/`,
			label: entry.data.name,
			active: path === `${WORLDVIEW_BASE}/races/${entry.id}`,
		}));
	} else if (section === 'characters') {
		const all = (await getCollection('characters', ({ data }) => !data.draft)).sort(
			(a, b) => a.data.order - b.data.order,
		);
		subItems = all.map((entry) => ({
			href: `${WORLDVIEW_BASE}/characters/${entry.id}/`,
			label: entry.data.name,
			active: path === `${WORLDVIEW_BASE}/characters/${entry.id}`,
		}));
	} else if (section === 'lore') {
		const all = (await getCollection('lore', ({ data }) => !data.draft)).sort(
			(a, b) => a.data.order - b.data.order,
		);
		// 设定按类目分组展开：组头是类目（指向索引页里那一段），组内是条目
		const byCategory = (category: LoreCategory) =>
			all
				.filter((entry) => entry.data.category === category)
				.map((entry) => ({
					href: `${WORLDVIEW_BASE}/lore/${entry.id}/`,
					label: entry.data.title,
					active: path === `${WORLDVIEW_BASE}/lore/${entry.id}`,
				}));
		loreGroups = LORE_CATEGORIES.map((category) => ({
			label: category,
			href: loreCategoryHref(category),
			active: false,
			note: LORE_CATEGORY_NOTES[category],
			items: byCategory(category),
		})).filter((group) => group.items.length > 0);
	} else if (section === 'music') {
		const all = (await getCollection('music', ({ data }) => !data.draft)).sort(
			(a, b) => a.data.order - b.data.order,
		);
		subItems = all.map((entry) => ({
			href: `${WORLDVIEW_BASE}/music/${entry.id}/`,
			label: entry.data.title,
			active: path === `${WORLDVIEW_BASE}/music/${entry.id}`,
		}));
	} else if (section === 'stories') {
		// 只有具体到某一话时才展开，索引页不列（一列就是 56 条）
		const currentId = path.slice(`${WORLDVIEW_BASE}/stories/`.length).replace(/\/+$/, '');
		// 「故事」下有两个入口：正文与教材。在读书时，侧栏列出本书的卷/章
		if (currentId === 'textbook' || currentId.startsWith('textbook/')) {
			const currentSlug = currentId.replace(/^textbook\/?/, '');
			const written = new Set(
				(await getCollection('textbook', ({ data }) => !data.draft)).map((entry) => entry.id),
			);
			subItems = HANDBOOK_VOLUMES.flatMap((volume) => [
				{
					href: `${HANDBOOK_BASE}/`,
					label: volume.no > 0 && volume.no <= 5
						? `第${'一二三四五'[volume.no - 1]}卷　${volume.title}`
						: volume.title,
					active: false,
					heading: true,
				},
				...volume.pieces
					.filter((piece) => written.has(piece.slug))
					.map((piece) => ({
						href: `${HANDBOOK_BASE}/${piece.slug}/`,
						label: piece.title.replace('　', ' '),
						active: piece.slug === currentSlug,
					})),
			]);
		} else {
			const arc = currentId.replace(/-(?:\d+|ep)$/, '');
			if (arc && arc !== currentId) {
				const siblings = (await getCollection('stories', ({ data }) => !data.draft))
					.filter((entry) => entry.id.startsWith(`${arc}-`))
					.sort((a, b) => a.data.code.localeCompare(b.data.code, 'en', { numeric: true }));
				subItems = siblings.map((entry) => ({
					href: `${WORLDVIEW_BASE}/stories/${entry.id}/`,
					label: `${entry.data.code} ${entry.data.title}`,
					active: entry.id === currentId,
				}));
			}
		}
	}
}
---

<header>
	<nav class="main">
		<a class="brand" href="/">
			{/* 首屏内容，别 lazyload，否则进页面会闪一下。logo 是 3.56:1 的横版字标 */}
			<Image src={logo} alt={SITE_TITLE} width={128} loading="eager" />
		</a>
		<div class="internal-links">
			{
				mainLinks.map((link) => (
					<a
						href={link.href}
						class:list={[{ active: isActive(link.href) }]}
						aria-current={isActive(link.href) ? 'page' : null}
					>
						{link.label}
					</a>
				))
			}
		</div>
		<div class="social-links">
			<a href={GITHUB_URL} target="_blank" rel="noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

{
	/*
	 * 世界观栏目导航：桌面是左侧固定侧栏（wiki 那种），窄屏收成一个可展开的目录。
	 * 必须放在 <header> 外面 —— 页头有 backdrop-filter，会给 fixed 定位另建包含块，
	 * 放在里面侧栏就贴不到视口左边了。
	 * 纯 CSS 实现（checkbox 展开），不依赖 JS。
	 */
	inWorldview && (
		<>
			<input type="checkbox" id="wv-nav-toggle" class="wv-nav-toggle" />
			<label for="wv-nav-toggle" class="wv-nav-btn">
				<span class="wv-nav-btn-ico" aria-hidden="true">
					☰
				</span>
				<span>世界观目录{activeLabel && ` · ${activeLabel}`}</span>
			</label>
			<nav class="wv-toc" id="wv-toc" aria-label="世界观栏目">
				<p class="wv-toc-title">世界观</p>
				<ul>
					{worldviewLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class:list={[{ active: isActive(link.href) }]}
								aria-current={isActive(link.href) ? 'true' : null}
							>
								{link.label}
							</a>
							{/* 二级目录：只在当前这一栏下展开 */}
							{(subItems.length > 0 || loreGroups.length > 0) && isActive(link.href) && (
								<ul class="sub-list">
									{/* 设定：一个类目一组 —— 组头指向索引页里那一段，组内是条目 */}
									{loreGroups.map((group) => (
										<>
											<li class="group">
												<a href={group.href} title={group.note}>
													{group.label}
													<span class="count">{group.items.length}</span>
												</a>
											</li>
											{group.items.map((item) => (
												<li class="nested">
													<a href={item.href} class:list={[{ active: item.active }]}>
														{item.label}
													</a>
												</li>
											))}
										</>
									))}
									{subItems.map((item) =>
										// 教材目录里的卷标题：不是链接，只当分组标签用
										item.heading ? (
											<li class="group">
												<span class="group-label">{item.label}</span>
											</li>
										) : (
											<li>
												<a href={item.href} class:list={[{ active: item.active }]}>
													{item.label}
												</a>
											</li>
										),
									)}
								</ul>
							)}
						</li>
					))}
				</ul>
			</nav>
		</>
	)
}
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgba(18, 34, 46, 88%);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgb(var(--gray-light));
		position: sticky;
		top: 0;
		z-index: 20;
	}
	/* 左上角换成企划 logo（方形、带透明），alt 保留站名 */
	.brand {
		display: flex;
		align-items: center;
		flex: none;
		text-decoration: none;
		transition: filter 0.2s ease;
	}
	.brand:hover {
		filter: drop-shadow(0 0 8px rgba(175, 255, 255, 55%));
	}
	.brand :global(img) {
		display: block;
		width: 128px;
		height: auto;
	}
	nav.main {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8em;
		flex-wrap: wrap;
	}
	nav.main a {
		padding: 0.95em 0.5em;
		font-size: 0.98em;
		color: rgb(var(--black));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	/* logo 那条链接不要吃导航项的 padding，否则页头会被撑高 */
	nav.main a.brand {
		padding: 0.4em 0.5em 0.4em 0;
		border-bottom: none;
	}
	nav.main a:hover {
		color: var(--glow);
	}
	nav.main a.active {
		text-decoration: none;
		border-bottom-color: var(--glow);
		color: var(--glow);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	.social-links,
	.social-links a {
		display: flex;
	}

	/* ---------- 世界观侧栏（桌面）/ 目录（窄屏） ---------- */
	.wv-nav-toggle {
		display: none;
	}
	.wv-nav-btn {
		display: none;
	}
	.wv-toc {
		position: fixed;
		top: 0;
		left: 0;
		bottom: 0;
		z-index: 4; /* 低于页头，页头压在它上面 */
		width: 224px;
		/* 顶部留出页头的高度（页头会换行，留宽裕些） */
		padding: 7.5em 1em 2em 1.3em;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		border-right: 1px solid rgb(var(--gray-light));
		background: rgba(20, 37, 50, 62%);
		backdrop-filter: blur(10px);
	}
	.wv-toc-title {
		margin: 0 0 1em 0.8em;
		font-size: 0.72em;
		letter-spacing: 0.3em;
		color: rgb(var(--gray));
	}
	.wv-toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15em;
	}
	.wv-toc :global(a) {
		display: block;
		padding: 0.5em 0.8em;
		border-radius: 9px;
		border-left: 2px solid transparent;
		font-size: 0.92em;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		transition: 0.15s ease;
	}
	.wv-toc :global(a:hover) {
		color: var(--glow);
		background: rgba(175, 255, 255, 8%);
	}
	.wv-toc :global(a.active) {
		color: var(--glow);
		background: rgba(175, 255, 255, 12%);
		border-left-color: var(--glow);
	}
	/* 二级目录：往里缩一级，用一条细线连回栏目 */
	.wv-toc .sub-list {
		margin: 0.2em 0 0.5em 0.85em;
		padding-left: 0.65em;
		gap: 0;
		border-left: 1px solid rgba(175, 255, 255, 16%);
	}
	.wv-toc .sub-list :global(a) {
		padding: 0.32em 0.6em;
		font-size: 0.84em;
		color: rgb(var(--gray));
	}
	.wv-toc .sub-list :global(a:hover) {
		color: var(--glow);
		background: rgba(175, 255, 255, 7%);
	}
	.wv-toc .sub-list :global(a.active) {
		color: var(--glow);
		background: rgba(175, 255, 255, 10%);
		border-left-color: transparent;
		font-weight: 700;
	}
	/* 分组目录：「设定」那一栏里一个类目一组 —— 组头一行，条目缩在下面 */
	.wv-toc .sub-list .group {
		margin: 0.5em 0 0.15em;
	}
	.wv-toc .sub-list .group :global(a) {
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--accent);
	}
	.wv-toc .sub-list .group :global(a:hover) {
		color: var(--glow);
	}
	.wv-toc .sub-list .group .count {
		margin-left: 0.5em;
		font-size: 0.82em;
		font-weight: 400;
		color: rgb(var(--gray));
	}
	/* 卷标题这种纯标签：颜色同组头，但没有链接的下划线 */
	.wv-toc .sub-list .group .group-label {
		display: block;
		padding: 0.32em 0.6em;
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--accent);
	}
	.wv-toc .sub-list .nested :global(a) {
		padding-left: 1.1em;
		font-size: 0.8em;
	}
	/* 每一组之间来一条细线，六组条目才分得开 —— 组头本身当分隔线用 */
	.wv-toc .sub-list .group {
		border-top: 1px solid rgba(175, 255, 255, 8%);
	}
	.wv-toc .sub-list .nested + li:not(.nested) {
		margin-top: 0.4em;
		border-top: 1px solid rgba(175, 255, 255, 8%);
	}
	@media (max-width: 900px) {
		.brand :global(img) {
			width: 104px;
		}
		nav.main a {
			padding: 0.7em 0.45em;
			font-size: 0.88em;
		}
		nav.main {
			justify-content: flex-start;
		}
		.social-links {
			display: none;
		}
	}

	/**
	 * 窄屏（1100px 以下）：侧栏收成一个「世界观目录」按钮，
	 * 点开才展开栏目列表 —— 不再有两条横栏叠在顶上。
	 */
	@media (max-width: 1099px) {
		.wv-nav-btn {
			display: flex;
			align-items: center;
			gap: 0.5em;
			padding: 0.7em 1em;
			font-size: 0.86em;
			color: rgb(var(--gray-dark));
			cursor: pointer;
			border-bottom: 1px solid rgb(var(--gray-light));
			background: rgba(20, 37, 50, 55%);
			user-select: none;
		}
		.wv-nav-btn-ico {
			color: var(--accent);
		}
		.wv-nav-toggle:checked ~ .wv-nav-btn {
			color: var(--glow);
		}
		.wv-toc {
			position: static;
			width: auto;
			z-index: auto;
			display: none;
			padding: 0.5em 1em 0.9em;
			border-right: none;
			border-bottom: 1px solid rgb(var(--gray-light));
			background: rgba(20, 37, 50, 45%);
			backdrop-filter: none;
		}
		.wv-nav-toggle:checked ~ .wv-toc {
			display: flex;
		}
		.wv-toc-title {
			display: none;
		}
		.wv-toc ul {
			flex-direction: column;
			gap: 0.1em;
		}
		.wv-toc :global(a) {
			padding: 0.6em 0.8em;
			font-size: 0.9em;
		}
	}
</style>
