---
import { GITHUB_URL, SITE_TITLE, WORLDVIEW_BASE } from '../consts';

/** 顶层导航：个人内容在根目录，世界观企划整体收在 /worldview/ 下 */
const mainLinks = [
	{ href: '/', label: '首页' },
	{ href: WORLDVIEW_BASE, label: '世界观' },
	{ href: '/blog', label: '随笔' },
	{ href: '/about', label: '关于' },
];

/** 世界观企划内部的二级导航，只在 /worldview/ 下显示 */
const worldviewLinks = [
	{ href: `${WORLDVIEW_BASE}`, label: '总览' },
	{ href: `${WORLDVIEW_BASE}/lore`, label: '设定' },
	{ href: `${WORLDVIEW_BASE}/races`, label: '种族' },
	{ href: `${WORLDVIEW_BASE}/characters`, label: '角色' },
	{ href: `${WORLDVIEW_BASE}/stories`, label: '故事' },
	{ href: `${WORLDVIEW_BASE}/gallery`, label: '画廊' },
	{ href: `${WORLDVIEW_BASE}/music`, label: '音乐' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const inWorldview = path === WORLDVIEW_BASE || path.startsWith(`${WORLDVIEW_BASE}/`);
const isActive = (href: string) => {
	const target = href.replace(/\/+$/, '') || '/';
	if (target === WORLDVIEW_BASE) return path === WORLDVIEW_BASE;
	return path === target || path.startsWith(`${target}/`);
};
---

<header>
	<nav class="main">
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			{
				mainLinks.map((link) => (
					<a href={link.href} class:list={[{ active: isActive(link.href) }]}>
						{link.label}
					</a>
				))
			}
		</div>
		<div class="social-links">
			<a href={GITHUB_URL} target="_blank" rel="noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
	{
		inWorldview && (
			<nav class="sub">
				<span class="tag">世界观</span>
				{
					worldviewLinks.map((link) => (
						<a href={link.href} class:list={[{ active: isActive(link.href) }]}>
							{link.label}
						</a>
					))
				}
			</nav>
		)
	}
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgba(16, 31, 46, 88%);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgb(var(--gray-light));
		position: sticky;
		top: 0;
		z-index: 20;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		white-space: nowrap;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--glow);
	}
	nav.main {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8em;
		flex-wrap: wrap;
	}
	nav.main a {
		padding: 0.95em 0.5em;
		font-size: 0.98em;
		color: rgb(var(--black));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav.main a:hover {
		color: var(--glow);
	}
	nav.main a.active {
		text-decoration: none;
		border-bottom-color: var(--glow);
		color: var(--glow);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	/* 二级导航：企划内部栏目 */
	nav.sub {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.2em 0.4em;
		padding: 0.35em 0 0.55em;
		border-top: 1px solid rgba(175, 255, 255, 10%);
	}
	nav.sub .tag {
		font-size: 0.72em;
		letter-spacing: 0.16em;
		color: var(--glow);
		opacity: 0.7;
		margin-right: 0.6em;
	}
	nav.sub :global(a) {
		padding: 0.3em 0.7em;
		font-size: 0.86em;
		border-radius: 999px;
		border-bottom: none;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	nav.sub :global(a:hover) {
		color: var(--glow);
		background: rgba(175, 255, 255, 8%);
	}
	nav.sub :global(a.active) {
		color: #08131d;
		background: var(--glow);
		font-weight: 700;
		text-decoration: none;
	}
	@media (max-width: 900px) {
		h2 {
			font-size: 0.9em;
		}
		nav.main a {
			padding: 0.6em 0.45em;
			font-size: 0.88em;
		}
		nav.main {
			justify-content: flex-start;
		}
		.social-links {
			display: none;
		}
		nav.sub {
			overflow-x: auto;
			flex-wrap: nowrap;
		}
	}
</style>
