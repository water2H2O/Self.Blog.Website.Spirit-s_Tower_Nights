---
/**
 * 入场协议：第一次进站要选一次。
 *
 * 「同意」是唯一的出口 —— 「拒绝」按钮会缩小、瞬移、和同意交换位置，
 * 想尽办法不让你点到它。
 *
 * 记录存在 sessionStorage（会话级，不是永久 cookie）：
 *   · 站内点来点去、普通 F5 刷新 —— 不再打扰
 *   · 关掉标签页重新打开 —— 会再问一次
 *   · Ctrl+F5 强制刷新 —— 也会再问一次
 *     原理：硬刷新会绕过 HTTP 缓存，于是 /agree-probe.txt 会被真正重新下载
 *     （resource timing 里 transferSize 与 decodedBodySize 都大于 0）。
 *     普通刷新只是 304 复用，decodedBodySize 为 0，不会误判。
 *
 * 页脚还有一条「水水使用协议」，随时可以点开重看。
 */
const STORAGE_KEY = 'shuita-entry-agreement-v2';
const PROBE = '/agree-probe.txt';

const ARTICLES = [
	'淼渺是水水的自设。本人理解的自设是超——大杯的 OC，所以也会用 OC 称呼淼渺。除了淼渺、飒岚，还有某个白头发的屑魔女，也是水水的主要 OC。',
	'水水不能喝。',
	'淼渺是水精灵，但因为一段特殊经历，有了狐狸耳朵和尾巴。现在是魔法学徒！有一顶超——级大的魔法帽。',
	'水水不是饮料，不能喝。',
	'淼淼、渺渺都是淼渺的称呼。因为上传表情包时的一个失误，后面就一直这么叫了。',
	'水水真的不能喝。',
	'水水交友没啥雷点，但双向尊重是必须坚持的原则。请尊重水水、淼渺和她的伙伴们，也尊重水水的日常习惯、爱好、学业和工作。',
	'水水不好喝，请不要喝水水。',
	'水水低精力时会用「囦囦」（读 yuán，1 元钱的元）称呼自己，表达自己真的很想睡觉……总之，想睡，别叫我。',
	'啊啊啊不要追着水水啃啦！！！',
	'水水非常乐意交流，但留学生 + 音乐企划运营的双重 buff 导致常年低精力。漏回消息和评论真的抱歉，不是不尊重。',
	'水水是真的会被喝完的，你们不要再喝啦！',
	'最后，养 OC 是为了开心，也希望大家天天开心！哪怕生活暂时充满阴霾，我们也一起加油吧~',
	'那几个拿瓶子的，你们要干……不能喝啊啊啊',
];
---

<div class="gate" id="entry-gate" hidden>
	<div class="gate-box" role="dialog" aria-modal="true" aria-labelledby="gate-title">
		<p class="kicker">进塔之前</p>
		<h2 id="gate-title">水水使用协议</h2>
		<p class="lead">
			欢迎来水塔。先认识一下水水，看完点<strong>同意</strong>就可以进来啦。至于旁边那个按钮……你可以试试。
		</p>
		{/* tabindex 让键盘用户能聚焦到条款区，用 PageDown / 方向键翻看 */}
		<ol class="articles" tabindex="0" aria-label="协议条款">
			{ARTICLES.map((text) => <li>{text}</li>)}
		</ol>
		<div class="actions">
			<button type="button" class="yes" id="gate-yes">同意</button>
			<button type="button" class="no" id="gate-no">拒绝，喝一口！</button>
		</div>
		<p class="hint" id="gate-hint"></p>
		<p class="again">
			以后想再看，可以从页脚打开「水水使用协议」。
		</p>
	</div>
</div>

<style>
	.gate {
		position: fixed;
		inset: 0;
		z-index: 90;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4vh 4vw;
		background: rgba(3, 8, 14, 88%);
		backdrop-filter: blur(6px);
	}
	.gate[hidden] {
		display: none;
	}
	/*
	 * 面板是「固定头 + 可滚动条款 + 固定按钮」的竖向 flex。
	 *
	 * 之前整个面板一起滚，按钮跟着十四条条款沉到底部：桌面窗口矮一点、
	 * 或者手机上，都得先滑到最后才点得到「同意」。现在只有 .articles 滚，
	 * 按钮区永在可视范围内 —— 不依赖 position: sticky 在滚动容器里的表现。
	 */
	.gate-box {
		box-sizing: border-box;
		width: min(680px, 100%);
		max-height: 92vh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		padding: 1.8em 2em 2em;
		border-radius: 18px;
		background: var(--surface);
		border: 1px solid rgba(175, 255, 255, 28%);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 55%);
	}
	.kicker {
		margin: 0;
		font-size: 0.72em;
		letter-spacing: 0.3em;
		color: rgb(var(--gray));
	}
	.gate-box h2 {
		margin: 0.3em 0 0.7em;
		font-size: 1.5em;
		color: var(--glow);
	}
	.gate-box .lead {
		margin: 0 0 1.2em;
		font-size: 0.86em;
		line-height: 1.9;
		color: rgb(var(--gray));
	}
	.gate-box .lead strong {
		color: var(--accent);
	}
	.articles {
		/* 只有这一段滚动；min-height:0 是 flex 子项能收缩的前提 */
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
		margin: 0 0 1.2em;
		padding: 0 0.35em 0 1.4em;
		font-size: 0.86em;
		line-height: 1.95;
		color: rgb(var(--gray-dark));
	}
	.articles:focus-visible {
		outline: 1px solid var(--accent);
		outline-offset: 3px;
		border-radius: 8px;
	}
	.articles li {
		margin-bottom: 0.5em;
	}
	/* 每隔一条重复的「不能喝」，看着就没那么板正 */
	.articles li:nth-child(2n) {
		color: rgb(var(--gray));
	}
	.actions {
		/* 固定区：不参与压缩，永远排在滚动条款的下方 */
		flex: none;
		display: flex;
		/* 窄屏放不下时让整颗按钮换行 —— 别把按钮里的字挤成两行 */
		flex-wrap: wrap;
		align-items: center;
		gap: 1em;
		/* 高度留够：「同意」会被放大，别顶到上面的条款 */
		min-height: 4.6em;
		margin-top: 0.2em;
		padding: 0.9em 0 0.2em;
		border-top: 1px solid rgb(var(--gray-light));
		background: var(--surface);
	}
	.actions button {
		flex: 0 0 auto;
		padding: 0.7em 2.2em;
		border-radius: 999px;
		font-size: 0.95em;
		/* 药丸按钮里的文字一律不折行（「拒绝，喝一口！」在窄屏上会断成两行） */
		white-space: nowrap;
		cursor: pointer;
		transition:
			transform 0.25s ease,
			left 0.25s ease,
			top 0.25s ease,
			opacity 0.3s ease,
			background 0.15s ease;
	}
	.actions .yes {
		color: #06121a;
		background: var(--glow);
		border: 1px solid var(--glow);
	}
	.actions .yes:hover {
		box-shadow: var(--glow-shadow);
	}
	.actions .no {
		color: rgb(var(--gray-dark));
		background: transparent;
		border: 1px solid rgb(var(--gray-light));
	}
	/* 被追着跑的时候会变成定位元素 */
	.actions .no.fleeing {
		position: fixed;
		z-index: 95;
	}
	/*
	 * 窄屏：手机上一行放不下两颗药丸，内边距又大，字就被挤成两行了。
	 * 这里同时收小外框与按钮的内边距 —— 收到之后仍然放不下才会换行（.actions 已允许 wrap）。
	 */
	@media (max-width: 560px) {
		.gate {
			padding: 3vh 4vw;
		}
		.gate-box {
			/* border-box 下 max-height 已含 padding；外层 gate 上下各留 3vh，
			   手机地址栏伸缩时用 dvh 跟住可视高度 */
			max-height: 92vh;
			max-height: 92dvh;
			padding: 1.4em 1.3em 1.6em;
		}
		.actions {
			gap: 0.7em;
			min-height: 4em;
			padding: 0.85em 0 0.15em;
		}
		.actions button {
			padding: 0.72em 1.5em;
			font-size: 0.9em;
		}
	}

	.hint {
		margin: 0.9em 0 0;
		min-height: 1.6em;
		font-size: 0.82em;
		color: var(--accent);
	}
	.again {
		margin: 0.4em 0 0;
		font-size: 0.74em;
		color: rgb(var(--gray));
	}

	/*
	 * 横屏手机 / 矮窗口：把标题以外的说明收掉，否则固定区会把条款滚动区挤没。
	 * 按钮区仍然保留，只是更紧凑。放在最后，确保覆盖上面的基础间距。
	 */
	@media (max-height: 620px) {
		.gate {
			padding: 2vh 4vw;
		}
		.gate-box {
			max-height: 94vh;
			max-height: 94dvh;
			padding: 1em 1.1em 1.1em;
		}
		.kicker,
		.gate-box .lead,
		.again {
			display: none;
		}
		.gate-box h2 {
			margin: 0 0 0.5em;
			font-size: 1.25em;
		}
		.articles {
			margin-bottom: 0.6em;
		}
		.actions {
			min-height: 0;
			margin-top: 0;
			padding-top: 0.6em;
		}
		.hint {
			min-height: 0;
			margin-top: 0.4em;
		}
	}
</style>

<script>
	const KEY = 'shuita-entry-agreement-v2';
	const PROBE = '/agree-probe.txt';

	const gate = document.getElementById('entry-gate');
	const yes = document.getElementById('gate-yes');
	const no = document.getElementById('gate-no');
	const hint = document.getElementById('gate-hint');

	const readFlag = () => {
		try {
			return sessionStorage.getItem(KEY) === 'ok';
		} catch {
			return false;
		}
	};
	const writeFlag = (value: boolean) => {
		try {
			if (value) sessionStorage.setItem(KEY, 'ok');
			else sessionStorage.removeItem(KEY);
		} catch {
			/* 存不了就每次都问 */
		}
	};

	if (gate && yes && no && hint) {
		/** 打开协议面板 */
		const open = () => {
			gate.hidden = false;
			document.body.style.overflow = 'hidden';
		};
		const close = () => {
			gate.hidden = true;
			document.body.style.overflow = '';
		};

		/** 拒绝按钮的花样：不把「拒绝」缩小到看不清，
		 *  而是让「同意」一步步变大 —— 视觉上自然就把对方比下去了 */
		const HINTS = [
			'诶，「同意」好像变大了？',
			'别急，它还会更大。',
			'看，两个按钮换位置了。',
			'……你怎么还在点。',
			'「同意」都长这么大了，真的不点吗？',
			'好吧，看来只剩一个选择了。',
		];

		let stage = 0;

		const flee = () => {
			stage += 1;
			hint.textContent = HINTS[Math.min(stage - 1, HINTS.length - 1)] ?? '';

			// 同意按钮逐级变大，最多到 1.6 倍
			const grow = Math.min(1.6, 1 + stage * 0.12);
			yes.style.transform = `scale(${grow.toFixed(2)})`;

			// 第 2 次起：拒绝按钮脱离文档流，随机瞬移（大小基本不变）
			if (stage >= 2) {
				no.classList.add('fleeing');
			}

			// 第 3 次：和「同意」交换位置
			if (stage === 3) {
				const actions = no.parentElement;
				if (actions) {
					actions.style.flexDirection = 'row-reverse';
					actions.style.justifyContent = 'flex-end';
				}
				return;
			}

			// 瞬移：满屏乱跑，但不再越缩越小
			if (stage >= 2) {
				const pad = 60;
				const maxX = Math.max(pad, window.innerWidth - no.offsetWidth - pad);
				const maxY = Math.max(pad, window.innerHeight - no.offsetHeight - pad);
				no.style.position = 'fixed';
				no.style.left = `${pad + Math.random() * (maxX - pad)}px`;
				no.style.top = `${pad + Math.random() * (maxY - pad)}px`;
			}

			// 追到第 8 次就让它淡出
			if (stage >= 8) {
				no.style.opacity = '0';
				no.style.pointerEvents = 'none';
				hint.textContent = '它走了。就剩同意了。';
			}
		};

		// 悬停就躲；触屏没有 hover，点下去也只会触发躲，不会真的拒绝
		no.addEventListener('mouseenter', flee);
		no.addEventListener('click', (event) => {
			event.preventDefault();
			flee();
		});

		yes.addEventListener('click', () => {
			writeFlag(true);
			close();
		});

		// 页脚那条「水水使用协议」：随时点开重看
		for (const link of document.querySelectorAll('[data-open-agreement]')) {
			link.addEventListener('click', (event) => {
				event.preventDefault();
				open();
			});
		}

		/**
		 * 判断这次是不是硬刷新（Ctrl+F5）。
		 * 硬刷新会绕过 HTTP 缓存，探针文件被真正重新下载：
		 *   transferSize > 0（走了网络）且 decodedBodySize > 0（拿到了响应体）
		 * 普通刷新多半是 304 复用，decodedBodySize 为 0，不会误判。
		 */
		const isHardReload = async () => {
			try {
				// 注意：这里**不能**加时间戳之类的防缓存参数，
				// 否则每次都是新 URL、必然走网络，就永远判成硬刷新了。
				await fetch(PROBE, { cache: 'default' });
			} catch {
				return false;
			}
			const entries = performance.getEntriesByType('resource');
			const probe = entries.filter((entry) => entry.name.includes('agree-probe.txt')).pop();
			if (!probe) return false;
			return probe.transferSize > 0 && probe.decodedBodySize > 0;
		};

		(async () => {
			const hard = await isHardReload();
			if (hard) writeFlag(false); // 硬刷新：重新确认一次
			if (!readFlag()) open();
		})();
	}
</script>
