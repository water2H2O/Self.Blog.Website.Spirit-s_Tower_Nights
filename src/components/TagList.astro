---
interface Props {
	tags?: string[];
	/** 传入主题色可以让标签跟着角色/条目变色 */
	color?: string;
}

const { tags = [], color } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags" style={color ? `--tag-color:${color}` : undefined}>
			{tags.map((tag) => (
				<li>{tag}</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		list-style: none;
		margin: 0.5em 0 0;
		padding: 0;
	}
	.tags li {
		font-size: 0.72em;
		line-height: 1;
		padding: 0.4em 0.7em;
		border-radius: 999px;
		color: var(--tag-color, var(--accent));
		background: color-mix(in srgb, var(--tag-color, var(--accent)) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--tag-color, var(--accent)) 30%, transparent);
	}
</style>
