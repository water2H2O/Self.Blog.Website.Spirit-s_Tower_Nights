# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# 本地开发密钥（聊天后端用；.dev.vars.example 是模板，可以进仓库）
.dev.vars

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# 图片压缩暂存区（作者重新命名分组前的中间产物，不入库）
assets-staging/

# Python 字节码缓存（tools/extract-docx.py 等会生成）
__pycache__/
*.pyc

# 子任务/工具留下的临时备份目录
.dsh-old/
.dsh-*/

# DeepSeek usage token (local credential, never commit)
tools/.deepseek-user-token

# 本地同步快照（模拟 R2，仅开发用）
.dev-sync.json
